; Per-developer PlatformIO overrides.
;
; This file (platformio_local.ini.example) is committed to the repo as a
; documented template. To use it, copy to platformio_local.ini and edit.
; platformio_local.ini is GITIGNORED — your tweaks never leak upstream.
;
; This file stays at the REPO ROOT even though the tracked config lives in
; platformio/platformio.ini — extra_configs resolves against the project directory.
; PlatformIO merges it into platformio/platformio.ini at config-read time. Values
; here override the same keys in platformio/platformio.ini. Add ONLY the keys you
; want to override; everything else inherits from the tracked base.
;
; Common things to override:
;   - upload_speed (slow down for sketchy USB cables / CH340 chips)
;   - upload_port  (pin to a specific /dev/cu.* device)
;   - monitor_speed (rare; usually keep matching the firmware)
;   - extra build_flags (debug defines, feature toggles)
;
; Examples below — UNCOMMENT and edit. All commented-out.

; ----------------------------------------------------------------------
; Example: slow down the upload_speed on the Olimex POE-ISO board
; (CH340 USB-serial chip sometimes drops bytes at 921600).
; ----------------------------------------------------------------------
; [env:esp32-poe-iso]
; upload_speed = 115200

; ----------------------------------------------------------------------
; Example: pin a specific serial port (skip pio's auto-detection).
; ----------------------------------------------------------------------
; [env:esp32-poe-iso]
; upload_port  = /dev/cu.usbserial-XXXX
; monitor_port = /dev/cu.usbserial-XXXX

; ----------------------------------------------------------------------
; Example: add a debug build flag without modifying the shared base.
; Note: build_flags here REPLACES the env's whole list. ${common.build_flags}
; supplies only the shared part, so repeat the env's own flags from
; platformio/platformio.ini as well. ${env:esp32-poe-iso.build_flags} cannot
; be used here: PlatformIO rejects the self-reference as infinite recursion.
; ([env] sets no build_flags, so ${env.build_flags} is empty.)
; ----------------------------------------------------------------------
; [env:esp32-poe-iso]
; build_flags = ${common.build_flags}
;     -DUSE_SOFTWARE_SERIAL
;     -DESP32_POE_ISO
;     -DCONFIG_BT_NIMBLE_ROLE_PERIPHERAL_DISABLED
;     -DCONFIG_BT_NIMBLE_ROLE_BROADCASTER_DISABLED
;     -DCONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
;     -DCONFIG_BT_NIMBLE_MAX_BONDS=1
;     -DCONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=4
;     -DCONFIG_BT_NIMBLE_WHITELIST_SIZE=1
;     -DMY_DEBUG_THING=1

; ----------------------------------------------------------------------
; Example: change the default_envs for `pio run` (no -e flag needed).
; ----------------------------------------------------------------------
; [platformio]
; default_envs = esp32-poe-iso
