// VSCode tasks for helpers that are awkward to type.
//
// The device.yml -> firmware workflow (generate/build/run/push/monitor) lives in the
// `./ebus-esp32` CLI; run it from the integrated terminal. See
// doc/GettingStartedVSCode.md.
//
// Trigger via Cmd-Shift-P → "Tasks: Run Task" (or Ctrl-Shift-P on Win/Linux).
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LSP: Regenerate compile_commands.json (ebus-esp32 compiledb)",
            "detail": "Run after a fresh clone, after lib_deps changes, or when IntelliSense / clangd gets confused. Produces a per-machine compilation database (gitignored).",
            "type": "shell",
            "command": "./ebus-esp32 compiledb",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
