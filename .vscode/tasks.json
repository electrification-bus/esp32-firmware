// VSCode tasks for helpers that the PlatformIO IDE extension's "Project Tasks"
// sidebar doesn't already expose.
//
// PIO IDE already gives you Build / Upload / Build Filesystem Image /
// Upload Filesystem Image / Monitor / Clean — don't duplicate those here.
//
// The device.yml → firmware workflow (generate/build/run/push) lives in the
// `./ebus-esp32` CLI; run it from the integrated terminal. The per-developer
// config overlay (~/.config/eBus/config.yml) is bootstrapped once by copying
// data/config.yml.example — see doc/GettingStarted_CLI.md — and merged into
// data/config.yml automatically by `./ebus-esp32 generate`.
//
// Trigger via Cmd-Shift-P → "Tasks: Run Task" (or Ctrl-Shift-P on Win/Linux).
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LSP: Regenerate compile_commands.json (pio run -t compiledb)",
            "detail": "Run after a fresh clone, after lib_deps changes, or when IntelliSense / clangd gets confused. Produces a per-machine compilation database (gitignored).",
            "type": "shell",
            "command": "./bin/pio run -t compiledb",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
