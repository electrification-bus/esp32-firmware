# Example device configuration for the eBus ESP32 SDK firmware.
#
# DO NOT edit this file with real credentials and commit it. The "live"
# config file (data/config.yml) is gitignored and is regenerated at build time
# from device.yml, then merged with your personal overlay at
# ~/.config/eBus/config.yml.
#
# To bootstrap a personal overlay from this example (once):
#   mkdir -p ~/.config/eBus
#   cp data/config.yml.example ~/.config/eBus/config.yml
#   edit ~/.config/eBus/config.yml          # set your broker, credentials, etc.
#
# Its non-empty fields are then merged into data/config.yml on every
# `./ebus-esp32 generate` (and thus every build). `./ebus-esp32 push --fs-only`
# uploads just the regenerated filesystem image to the device.
#
# Defaults below point at the public Shiftr.io test broker — safe for first-
# boot smoke testing only. Replace mqtt_host / username / password with your
# own broker for real use, and change device_passphrase from "changeme".

config:
  - wifi_ssid:
    wifi_password:
    # mqtt_mode controls how the MQTT broker is resolved:
    #   configured-only         - use only the mqtt_host/port from this config file (default)
    #   discovery-with-fallback - try mDNS discovery first, fall back to config if none found
    #   discovery-only          - use only mDNS discovery, ignore configured mqtt_host/port
    # A discovery mode auto-enables mdns_discovery below (you don't need to set both).
    mqtt_mode: configured-only
    # mDNS gates (both default false), independent (ESP32-6du.6):
    #   mdns_discovery - browse the LAN for the MQTT broker; needed by the discovery
    #                    mqtt_modes above. Crash-safe client side.
    #   mdns_advertise - advertise <device>.local + service records so other hosts can
    #                    find this device (web UI / OTA). Responder path that can crash
    #                    on some LAN packets, so it's opt-in.
    # Legacy: `mdns_enabled: true` sets both at once.
    mdns_discovery: false
    mdns_advertise: false
    mqtt_host: public.cloud.shiftr.io
    mqtt_port: 1883
    mqtt_username: public
    mqtt_password: public
    device_id: Sunkit-001
    device_type: ebus
    firmware_name: ESP32POEISO Firmware
    firmware_version: 1.0.0
    firmware_url: http://example.com/firmware.bin
    # mDNS device info
    manufacturer: NESL
    model: ESP32-POE-ISO
    serial_number:   # leave empty to use device_id
    homie_role: device  # "device" or "controller"
    device_passphrase: changeme  # required for OTA and admin REST endpoints
