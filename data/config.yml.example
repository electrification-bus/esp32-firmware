# Example device configuration for the eBus ESP32 SDK firmware.
#
# DO NOT edit this file with real credentials and commit it. The "live"
# config file (data/config.yml) is gitignored and is staged at build time
# from your personal overlay at ~/.config/eBus/config.yml.
#
# To bootstrap a personal overlay from this example:
#   make config-init   # copies this file to ~/.config/eBus/config.yml
#   $EDITOR ~/.config/eBus/config.yml
#   make config-status # confirm overlay is present
#
# Then `make fs` / `make uploadfs` / `make flash-all` will copy the overlay
# into data/config.yml before invoking PlatformIO's buildfs target.
#
# Defaults below point at the public Shiftr.io test broker — safe for first-
# boot smoke testing only. Replace mqtt_host / username / password with your
# own broker for real use, and change device_passphrase from "changeme".

config:
  - wifi_ssid:
    wifi_password:
    # mqtt_mode controls how the MQTT broker is resolved:
    #   configured-only         - use only the mqtt_host/port from this config file
    #   discovery-with-fallback - try mDNS discovery first, fall back to config if none found
    #   discovery-only          - use only mDNS discovery, ignore configured mqtt_host/port (default)
    mqtt_mode: configured-only
    mqtt_host: public.cloud.shiftr.io
    mqtt_port: 1883
    mqtt_username: public
    mqtt_password: public
    device_id: Sunkit-001
    device_type: ebus
    firmware_name: ESP32POEISO Firmware
    firmware_version: 1.0.0
    firmware_url: http://example.com/firmware.bin
    # mDNS device info
    manufacturer: NESL
    model: ESP32-DEVKITC-1
    serial_number:   # leave empty to use device_id
    homie_role: device  # "device" or "controller"
    device_passphrase: changeme  # required for OTA and admin REST endpoints
