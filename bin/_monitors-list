#!/bin/sh
# Internal helper: print a human-readable summary of live monitor breadcrumbs.
# Called by `./ebus-esp32 monitors`. Stale breadcrumbs (those whose tmux pane no
# longer exists) are removed inline as a side effect.
#
# Usage: _monitors-list

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
RUN_DIR="$REPO_ROOT/.run"

if [ ! -d "$RUN_DIR" ]; then
    echo "no active monitor sessions"
    exit 0
fi

# Build the list of live breadcrumbs first (and clean up stale ones).
# We collect into a temp file so we can both count and iterate.
live_list=$(mktemp -t monitors-list.XXXXXX)
trap 'rm -f "$live_list"' EXIT INT TERM

for f in "$RUN_DIR"/monitor-*.state; do
    [ -f "$f" ] || continue
    pane_id=$(awk -F= '/^TMUX_PANE_ID=/{print $2; exit}' "$f")
    if [ -n "$pane_id" ] && tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane_id"; then
        echo "$f" >> "$live_list"
    else
        rm -f "$f"
    fi
done

count=$(wc -l < "$live_list" | tr -d ' ')

if [ "$count" = 0 ]; then
    echo "no active monitor sessions"
    exit 0
fi

# Print summary block per breadcrumb.
i=0
while IFS= read -r f; do
    i=$((i + 1))
    port=$(awk -F= '/^PORT=/{print $2; exit}' "$f")
    env=$(awk -F= '/^PIO_ENV=/{print $2; exit}' "$f")
    pane=$(awk -F= '/^TMUX_PANE=/{print $2; exit}' "$f")
    pane_id=$(awk -F= '/^TMUX_PANE_ID=/{print $2; exit}' "$f")
    started=$(awk -F= '/^STARTED=/{print $2; exit}' "$f")

    [ "$i" = 1 ] || echo
    printf '%d) %s\n'              "$i" "$port"
    printf '   env:     %s\n'      "$env"
    printf '   pane:    %s [%s]\n' "$pane" "$pane_id"
    printf '   started: %s\n'      "$started"
done < "$live_list"
