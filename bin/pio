#!/bin/sh
# Repo-local wrapper for PlatformIO Core.
#
# Forwards to ~/.platformio/penv/bin/pio (installed by the VSCode PlatformIO
# extension or by `pipx install platformio`). Lets this repo's Makefile and
# CLI workflow stay self-contained — no global $PATH edits required.

set -e

PIO="${HOME}/.platformio/penv/bin/pio"

if [ ! -x "${PIO}" ]; then
    echo "error: PlatformIO Core not found at ${PIO}" >&2
    echo >&2
    echo "Install one of:" >&2
    echo "  - VSCode PlatformIO extension (puts it at the expected location)" >&2
    echo "  - pipx install platformio  (then symlink ~/.local/bin/pio there)" >&2
    echo "  - brew install platformio" >&2
    exit 1
fi

exec "${PIO}" "$@"
