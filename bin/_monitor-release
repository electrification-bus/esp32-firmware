#!/bin/sh
# Internal helper: remove the breadcrumb dropped by _monitor-record. Called
# from the monitor command's EXIT/INT/TERM trap so the breadcrumb
# clears whether monitor exits normally or via Ctrl-C.
#
# Usage: _monitor-release [<PORT>]
#
# With PORT: rm .run/monitor-<basename(PORT)>.state.
# Without PORT (inside tmux): rm any breadcrumb whose TMUX_PANE matches the
# current pane — covers the case where the user re-launches monitor in the
# same pane and the previous breadcrumb is stale.

set -e

PORT="$1"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
RUN_DIR="$REPO_ROOT/.run"

if [ -n "$PORT" ]; then
    rm -f "$RUN_DIR/monitor-$(basename "$PORT").state"
    exit 0
fi

# No explicit PORT: clean breadcrumbs pointing at the current tmux pane.
[ -n "$TMUX" ] || exit 0
pane="$(tmux display-message -p '#S:#W.#P')"
for state in "$RUN_DIR"/monitor-*.state; do
    [ -f "$state" ] || continue
    if grep -q "^TMUX_PANE=$pane$" "$state" 2>/dev/null; then
        rm -f "$state"
    fi
done
