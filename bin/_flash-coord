#!/bin/sh
# Internal helper: coordinate the serial-port handoff between `make monitor`
# (running in a tmux pane) and `make flash` / `uploadfs` / `flash-all`.
#
# Usage: _flash-coord {pause|restart} [<PORT>]
#
#   pause   — find the monitor breadcrumb for PORT (or the unique live one),
#             snapshot it to .run/flash-pending-<port>.state, then send Ctrl-C
#             to the monitor's tmux pane and sleep 0.5s for the port release.
#   restart — read the pending file, send `make monitor ...` keys to the
#             original tmux pane, remove the pending file.
#
# Multi-board behaviour:
#   - With PORT explicit: act on that port's breadcrumb only.
#   - With PORT unset, exactly one live breadcrumb: act on it.
#   - With PORT unset, multiple live breadcrumbs: ERROR — specify PORT=<port>.
#
# Stale breadcrumb handling: any breadcrumb whose tmux session no longer
# exists is rm'd inline so it doesn't keep flagging "multiple monitors".

set -e

ACTION="$1"
PORT="$2"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
RUN_DIR="$REPO_ROOT/.run"

# Don't create .run/ on read-only paths; only mkdir where we actually write.

# Print breadcrumb files corresponding to *live* tmux panes (one per line).
# Stale breadcrumbs are removed as a side effect.
#
# Uses TMUX_PANE_ID (the @N form) for liveness check, since #S:#W.#P names
# can shift when tmux auto-renames windows based on running processes.
gather_live_states() {
    for f in "$RUN_DIR"/monitor-*.state; do
        [ -f "$f" ] || continue
        pane_id=$(awk -F= '/^TMUX_PANE_ID=/{print $2; exit}' "$f")
        if [ -n "$pane_id" ] && tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane_id"; then
            echo "$f"
        else
            rm -f "$f"
        fi
    done
}

case "$ACTION" in
    pause)
        # Locate the breadcrumb to act on.
        if [ -n "$PORT" ]; then
            state="$RUN_DIR/monitor-$(basename "$PORT").state"
            [ -f "$state" ] || exit 0   # no monitor for this port — nothing to do
            # Verify it's still live (by pane id)
            pane_id=$(awk -F= '/^TMUX_PANE_ID=/{print $2; exit}' "$state")
            if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane_id"; then
                rm -f "$state"
                exit 0
            fi
        else
            live=$(gather_live_states)
            count=$(printf '%s\n' "$live" | grep -c . || true)
            if [ "$count" = 0 ]; then
                exit 0   # no monitor running — nothing to do
            fi
            if [ "$count" -gt 1 ]; then
                echo "ERROR: $count monitor sessions are live; specify PORT=<port>" >&2
                printf '%s\n' "$live" >&2
                exit 1
            fi
            state="$live"
        fi

        # Snapshot to a pending file BEFORE killing the monitor — so restart
        # can recover the tmux-pane info even after the monitor's own trap
        # clears the original breadcrumb.
        port_from_state=$(awk -F= '/^PORT=/{print $2; exit}' "$state")
        pending="$RUN_DIR/flash-pending-$(basename "$port_from_state").state"
        mkdir -p "$RUN_DIR"
        cp "$state" "$pending"

        pane_id=$(awk -F= '/^TMUX_PANE_ID=/{print $2; exit}' "$state")
        pane_display=$(awk -F= '/^TMUX_PANE=/{print $2; exit}' "$state")
        echo "(pausing monitor in tmux pane $pane_display [$pane_id])" >&2
        tmux send-keys -t "$pane_id" C-c
        sleep 0.5
        ;;

    restart)
        # Locate the pending file.
        if [ -n "$PORT" ]; then
            pending="$RUN_DIR/flash-pending-$(basename "$PORT").state"
        else
            count=$(ls "$RUN_DIR"/flash-pending-*.state 2>/dev/null | wc -l | tr -d ' ')
            if [ "$count" = 0 ]; then
                exit 0   # nothing was paused — nothing to restart
            fi
            if [ "$count" -gt 1 ]; then
                echo "ERROR: $count pending flashes; specify PORT=<port>" >&2
                exit 1
            fi
            pending=$(ls "$RUN_DIR"/flash-pending-*.state 2>/dev/null | head -1)
        fi

        [ -f "$pending" ] || exit 0

        # Load TMUX_PANE_ID / TMUX_PANE / PORT / PIO_ENV from the pending file.
        TMUX_PANE_ID=""
        TMUX_PANE=""
        PIO_ENV=""
        PORT=""
        . "$pending"
        # $PORT now holds the breadcrumb's PORT (sourced).

        # If the pane is gone (user closed it during the flash), clean up
        # the pending file and don't try to send keys.
        if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$TMUX_PANE_ID"; then
            echo "(monitor pane $TMUX_PANE [$TMUX_PANE_ID] no longer exists; not restarting)" >&2
            rm -f "$pending"
            exit 0
        fi

        echo "(restarting monitor in tmux pane $TMUX_PANE [$TMUX_PANE_ID])" >&2
        cmd="make monitor PIO_ENV=$PIO_ENV"
        if [ -n "$PORT" ]; then
            cmd="$cmd PORT=$PORT"
        fi
        tmux send-keys -t "$TMUX_PANE_ID" "$cmd" Enter
        rm -f "$pending"
        ;;

    *)
        echo "usage: $0 {pause|restart} [<PORT>]" >&2
        exit 2
        ;;
esac
