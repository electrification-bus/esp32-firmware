.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
include/config.h

# LSP / clangd compilation database + index — per-developer, regenerable.
# compile_commands.json: run `make compiledb` to refresh.
# .cache/clangd/: clangd's persistent symbol index.
compile_commands.json
.cache/

# macOS Finder metadata — never track
.DS_Store

# Personal LLM coding-assistant configs. See README "Personal LLM
# Configuration" section. Project-wide LLM context, if any, lives at
# .llm/ (tracked separately and NOT matched by these patterns).
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.codeium/
.windsurf/
.aider*
.continuerules
.beads/

# Per-developer config (staged from ~/.config/eBus/config.yml by `make fs`).
# data/config.yml.example holds the schema + safe defaults.
data/config.yml
data/config.yml~
data/config.yml.bak
secrets.yaml
*.esphome.yaml

# Per-developer PlatformIO overrides (merged in via [platformio] extra_configs).
# platformio_local.ini.example holds a documented template.
platformio_local.ini

# Runtime coordination state for the make monitor / make flash port handoff.
# Breadcrumb files written by bin/_monitor-record and bin/_flash-coord.
.run/
