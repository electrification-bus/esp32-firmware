.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# LSP / clangd compilation database + index — per-developer, regenerable.
# compile_commands.json: run `./ebus-esp32 compiledb` to refresh.
# .cache/clangd/: clangd's persistent symbol index.
compile_commands.json
.cache/

# Python virtual environment for ./ebus-esp32 (see doc/GettingStartedCLI.md)
.venv/

# macOS Finder metadata — never track
.DS_Store

# Personal LLM coding-assistant configs. See the README's "Personal LLM
# configuration" section.
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.codeium/
.windsurf/
.aider*
.continuerules
.beads/

# Generated from device.yml by `./ebus-esp32 generate` (and automatically by the
# pre-build hook on every `pio run`). device.yml + lib/<bus>/*.yml are the tracked
# source of truth; these outputs are regenerated, never committed.
src/homie.cpp
data/homie.yml
build/

# ESP-IDF Component Manager manifest, written by the pioarduino platform's
# component_manager.py on every idf5 build when no manifest exists in the Arduino
# framework dir or here. Default content is just the baseline floor
# (dependencies: {idf: '>=5.1'}) — this project declares no registry components, so
# it carries nothing worth tracking and is recreated identically if deleted. The
# .orig sibling is that script's backup of a manifest it modified.
src/idf_component.yml
src/idf_component.yml.orig

# Generated runtime config — built from device.yml + config-overlay.yml on every
# `./ebus-esp32 generate` (which the pre-build hook runs before every build).
data/config.yml
data/config.yml~
data/config.yml.bak

# Per-developer config overlay. Required before the first generate: it sets
# device.device_passphrase, which generate refuses to leave empty or "changeme". Its
# non-empty fields are merged over the device.yml-derived values, so the passphrase
# and real broker/WiFi credentials stay out of the tracked device.yml. No template.
config-overlay.yml

# The tracked PlatformIO config lives in platformio/platformio.ini, NOT here. A root
# platformio.ini is what makes the VSCode PlatformIO extension adopt this folder as its
# own project; the extension writes a stub one back here on its own within a minute of
# the file going missing, so this entry keeps that stub — and any copy you make for
# IDE-driven builds — out of git. CLI builds are insulated either way: they use
# .pio/cli, not the .pio/build + .pio/libdeps the extension manages.
/platformio.ini

# Per-developer PlatformIO overrides (merged in via [platformio] extra_configs).
# platformio_local.ini.example holds a documented template.
platformio_local.ini

# Runtime coordination state for the tmux serial-port handoff between a monitor
# and a flash. Breadcrumb files written by bin/_monitor-record and bin/_flash-coord.
.run/
