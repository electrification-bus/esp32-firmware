.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
include/config.h

# LSP / clangd compilation database + index — per-developer, regenerable.
# compile_commands.json: run `pio run -t compiledb` to refresh.
# .cache/clangd/: clangd's persistent symbol index.
compile_commands.json
.cache/

# macOS Finder metadata — never track
.DS_Store

# Personal LLM coding-assistant configs. See README "Personal LLM
# Configuration" section. Project-wide LLM context, if any, lives at
# .llm/ (tracked separately and NOT matched by these patterns).
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.codeium/
.windsurf/
.aider*
.continuerules
.beads/

# Generated from device.yml by `./ebus-esp32 generate` (and automatically by the
# pre-build hook on every `pio run`). device.yml + lib/<bus>/*.yml are the tracked
# source of truth; these outputs are regenerated, never committed.
src/homie.cpp
data/homie.yml

# Per-developer config: merged from ~/.config/eBus/config.yml into the generated
# data/config.yml by `./ebus-esp32 generate`. data/config.yml.example holds the
# schema + safe defaults (tracked).
data/config.yml
data/config.yml~
data/config.yml.bak

# Per-developer PlatformIO overrides (merged in via [platformio] extra_configs).
# platformio_local.ini.example holds a documented template.
platformio_local.ini

# Runtime coordination state for the tmux serial-port handoff between a monitor
# and a flash (works via either ./ebus-esp32 or make). Breadcrumb files written
# by bin/_monitor-record and bin/_flash-coord.
.run/
