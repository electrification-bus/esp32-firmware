# ── config overlay ───────────────────────────────────────────────────────────
#
# The project's config-overlay.yml (kept out of version control) is merged into the
# generated .ebus/data/config.yml on every generate — non-empty overlay fields win, everything else keeps its
# device.yml-derived value. There is deliberately NO init step and NO tracked template:
# an overlay is either there and applied, or absent and ignored.
#
# The overlay is written in device.yml's shape: the same device/wifi/mqtt/log/mdns sections
# with the same key names. Only those sections are accepted — nodes: and device.environment decide
# what firmware gets GENERATED and stay device.yml's job alone, so every developer builds the
# same structure and only the connectivity/identity values differ.
#
# Keeping credentials here rather than in device.yml is the whole point — device.yml is
# tracked, this file is not.

OVERLAY_SECTIONS = ("device", "wifi", "mqtt", "log", "mdns")

def _flat_key_hint(key: str) -> str:
    """Rewrite a legacy flat key (wifi_ssid) as its section form (wifi: / ssid:)."""
    for section in ("wifi", "mqtt", "log", "mdns"):
        if key.startswith(section + "_"):
            return f"{section}:\n      {key[len(section) + 1:]}: ..."
    if key == "device_id" or key.startswith("firmware_") or key in (
            "manufacturer", "model", "serial_number", "homie_role",
            "device_name", "device_type", "device_passphrase", "device_id_prefix"):
        leaf = {"device_id": "id", "device_name": "name"}.get(key, key)
        return f"device:\n      {leaf}: ..."
    return ""

def _deep_merge(base: dict, overrides: dict) -> int:
    """Recursively apply overrides onto base. Returns the number of leaf values set.

    Empty-string and null leaves are skipped so a key left blank in the overlay falls back
    to its device.yml-derived value rather than blanking it.
    """
    applied = 0
    for k, v in overrides.items():
        if isinstance(v, dict):
            node = base.get(k)
            if not isinstance(node, dict):
                node = {}
                base[k] = node
            applied += _deep_merge(node, v)
        elif v is not None and v != "":
            base[k] = v
            applied += 1
    return applied

def _configured_passphrase(cfg: dict) -> str:
    """device.device_passphrase as the firmware will see it: config-overlay.yml's value
    when non-empty (as _apply_overlay merges it), else device.yml's, else ""."""
    overlay = {}
    if CONFIG_OVERLAY.exists():
        overlay = load_yaml_file(CONFIG_OVERLAY, require_mapping=False) or {}
    overlay_device = overlay.get("device") if isinstance(overlay, dict) else None
    if not isinstance(overlay_device, dict):
        overlay_device = {}
    device = cfg.get("device") if isinstance(cfg.get("device"), dict) else {}
    value = overlay_device.get("device_passphrase")
    if value is None or value == "":
        value = device.get("device_passphrase")
    return "" if value is None else str(value)

def _require_passphrase(cfg: dict, device_yml: Path) -> None:
    """Refuse to generate firmware whose admin and OTA endpoints would accept an empty
    or placeholder passphrase."""
    passphrase = _configured_passphrase(cfg)
    if passphrase.strip() and passphrase.strip().lower() != "changeme":
        return
    what = "empty" if not passphrase.strip() else f"the placeholder '{passphrase}'"
    print(f"ERROR: device.device_passphrase is {what} (after merging "
          f"{CONFIG_OVERLAY.name} over {device_yml}).\n"
          f"       It is the password for the device's admin and OTA endpoints. Set your own\n"
          f"       in {shown(PROJECT_DIR / 'config-overlay.yml')} (keep it out of version "
          f"control), for example:\n\n"
          f"         device:\n"
          f"           device_passphrase: <a passphrase of your own>\n", file=sys.stderr)
    sys.exit(1)

def _apply_overlay(config_path: Path) -> None:
    """Merge config-overlay.yml sections into the generated config.yml."""
    if not CONFIG_OVERLAY.exists():
        return
    # Sections sit at the top level, same as device.yml and the generated config.yml.
    overrides = load_yaml_file(CONFIG_OVERLAY, require_mapping=False) or {}
    if not overrides:
        return
    # Validate BEFORE merging. An unrecognized key used to be copied in verbatim and then
    # ignored by the firmware, which reads sections — the overlay looked applied (it was in
    # the generated file) but changed nothing. Fail loudly instead.
    problems = []
    for k, v in overrides.items():
        if k not in OVERLAY_SECTIONS:
            hint = _flat_key_hint(k)
            problems.append(f"  {k}: not an overlay section"
                            + (f" — did you mean\n    {hint}" if hint else ""))
        elif not isinstance(v, dict):
            problems.append(f"  {k}: must be a section (a nested block), got {type(v).__name__}")
    if problems:
        print(f"ERROR: {CONFIG_OVERLAY.name} is not valid:", file=sys.stderr)
        for p in problems:
            print(p, file=sys.stderr)
        print(f"\nValid sections: {', '.join(OVERLAY_SECTIONS)} — same shape and key names as "
              f"device.yml.\nnodes: and device.environment are deliberately not overridable.",
              file=sys.stderr)
        sys.exit(1)
    doc = load_yaml_file(config_path, require_mapping=False) or {}
    applied = _deep_merge(doc, overrides)
    with open(config_path, "w", encoding="utf-8") as f:
        yaml.dump(doc, f, allow_unicode=True, sort_keys=False)
    print(f"  overlay:   {shown(CONFIG_OVERLAY)} ({applied} field(s))")
    if CONFIG_OVERLAY == CONFIG_OVERLAY_REPO:
        print(f"  NOTE: the project has no config-overlay.yml, so the one at the repo root is "
              f"used; move it to {shown(PROJECT_DIR / 'config-overlay.yml')}")

def _warn_no_broker(config_path: Path) -> None:
    """configured-only with an empty host leaves the device nothing to connect to."""
    mqtt = (load_yaml_file(config_path) or {}).get("mqtt") or {}
    if mqtt.get("mode") == "configured-only" and not mqtt.get("host"):
        print("  WARNING: mqtt.host is empty and mqtt.mode is configured-only, so the device\n"
              "           has no broker to connect to (unless one is saved from its web portal).\n"
              f"           Set mqtt.host in {CONFIG_OVERLAY.name} (kept out of git) or the device file.")

MDNS_KEYS = ("enabled", "discovery", "advertise")

def env_is_wifi_ap(env_name) -> bool:
    """True when the env's build_flags define CONFIG_WIFI_AP (a WiFi-only board with a
    setup AP); False for Ethernet builds, and for an env not in platformio.ini."""
    if not env_name:
        return False
    cfg = read_pio_config()
    section = f"env:{env_name}"
    if not cfg.has_option(section, "build_flags"):
        return False
    for line in cfg.get(section, "build_flags").splitlines():
        if "-DCONFIG_WIFI_AP" in line.split(";", 1)[0].split():
            return True
    return False

def _check_network_keys(config_path: Path, env_name) -> None:
    """Once config-overlay.yml is merged in: refuse a non-boolean mdns.* or wifi.enabled,
    and say what the device will do when the settings drop the .local hostname, leave
    configured WiFi credentials unused, or contradict each other."""
    doc = load_yaml_file(config_path, require_mapping=False) or {}
    mdns = doc.get("mdns") if isinstance(doc.get("mdns"), dict) else {}
    wifi = doc.get("wifi") if isinstance(doc.get("wifi"), dict) else {}
    mqtt = doc.get("mqtt") if isinstance(doc.get("mqtt"), dict) else {}
    problems = [f"mdns.{k} must be true or false (got {mdns[k]!r})"
                for k in MDNS_KEYS if k in mdns and not isinstance(mdns[k], bool)]
    if "enabled" in wifi and not isinstance(wifi["enabled"], bool):
        problems.append(f"wifi.enabled must be true or false (got {wifi['enabled']!r})")
    if problems:
        print(f"ERROR: in the configuration merged from the device file and "
              f"{CONFIG_OVERLAY.name}:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        sys.exit(1)

    if mdns.get("enabled") is False:
        if mqtt.get("mode") in ("discovery-only", "discovery-with-fallback"):
            print(f"  WARNING: mdns.enabled is false, but mqtt.mode {mqtt['mode']} needs the mDNS "
                  f"querier, which wins: the device starts it and claims <device-id>.local, "
                  f"with no service records.")
        else:
            print("  WARNING: mdns.enabled is false: the device will not claim <device-id>.local; "
                  "`mdns: {advertise: false}` keeps the hostname while dropping the service records.")
        overridden = [k for k in ("discovery", "advertise") if mdns.get(k) is True]
        if overridden:
            print(f"  WARNING: mdns.enabled false overrides "
                  f"{' and '.join('mdns.' + k for k in overridden)} true.")

    wifi_ap = env_is_wifi_ap(env_name)
    enabled = wifi.get("enabled")
    if not wifi_ap and wifi.get("ssid") and enabled is not True:
        print(f"  NOTE: wifi.ssid is set, but {env_name} is an Ethernet build, where WiFi STA "
              f"stays off unless wifi.enabled is true.")
    if wifi_ap and enabled is False:
        print(f"  WARNING: wifi.enabled is false on {env_name}, a WiFi-AP build: the device "
              f"joins no network at boot and waits on its setup AP until one is chosen there.")

def cmd_config_status(args) -> None:
    print(f"overlay path:    {shown(CONFIG_OVERLAY)}")
    if CONFIG_OVERLAY.exists():
        print(f"overlay state:   ACTIVE ({CONFIG_OVERLAY.stat().st_size} bytes) — merged into "
              f"{shown(GEN_DATA_DIR / 'config.yml')} on every build")
        if CONFIG_OVERLAY == CONFIG_OVERLAY_REPO:
            print(f"NOTE: this is the repo-root overlay, used because the project has none; "
                  f"move it to {shown(PROJECT_DIR / 'config-overlay.yml')}")
    else:
        print("overlay state:   none (put device.device_passphrase in one; generate refuses an empty or 'changeme' value)")
        print()
        print("To add one, create config-overlay.yml with only the keys you want to")
        print(f"override, using device.yml's sections ({', '.join(OVERLAY_SECTIONS)}) and")
        print("key names. e.g.:")
        print()
        print("  device:")
        print("    device_passphrase: a-passphrase-of-your-own")
        print("  wifi:")
        print("    ssid: my-network")
        print("    password: hunter2")
        print("  mqtt:")
        print("    host: broker.example.com")
        print()
    if CONFIG_OVERLAY_LEGACY.exists():
        print(f"NOTE: a legacy overlay exists at {CONFIG_OVERLAY_LEGACY}")
        print("      it is NO LONGER READ — move its contents to config-overlay.yml")
    print(f"{shown(GEN_DATA_DIR / 'config.yml')}: generated from device.yml + overlay by the pre-build hook")

# ── main ───────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="ebus-esp32",
        description="eBus ESP32 firmware CLI — generate, build, and deploy firmware from device.yml",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="\n".join([
            # Alphabetical, matching the subcommand list; bare form of each command first,
            # then its flag variants in flag order.
            "examples:",
            "  ebus-esp32 build",
            "  ebus-esp32 clean",
            "  ebus-esp32 devices",
            "  ebus-esp32 envs",
            "  ebus-esp32 generate",
            "  ebus-esp32 monitor                            (network if an address is known, else USB)",
            "  ebus-esp32 monitor --net --host 192.168.1.42",
            "  ebus-esp32 monitor --serial                   (force USB; also learns the device IP)",
            "  ebus-esp32 push",
            "  ebus-esp32 push --fs-only",
            "  ebus-esp32 push --ota --host 192.168.1.42     (flash fw+fs over TCP, no cable)",
            "  ebus-esp32 push --pull --url http://10.0.0.5:8080 --host 192.168.1.42",
            "                                                 (device downloads the images instead)",
            "  ebus-esp32 serve                             (serve the images for a portal-driven pull)",
            "  ebus-esp32 run",
            "  ebus-esp32 run --monitor                      (flash, then watch over the network)",
            "  ebus-esp32 run --ota --monitor                (build, flash over TCP, then watch)",
            "  ebus-esp32 run --port COM3",
            "  ebus-esp32 test                               (host unit tests, no board)",
        ]),
    )

    dev_yml_arg = dict(nargs="?", default=".", metavar="PROJECT",
                       help="the project directory, or its device.yml "
                            "(default: the current directory)")
    port_arg    = dict(default=None, metavar="PORT",
                       help="serial port, e.g. COM3 or /dev/ttyUSB0 (auto-detected if omitted)")
    host_arg    = dict(default=None, metavar="ADDR",
                       help="device IP/hostname, or a Device ID learned from a previous "
                            "serial session (default: the address learned for device.yml)")
    wait_arg    = dict(type=int, default=90, metavar="SECONDS",
                       help="how long to wait for the device's TCP console to answer (default: 90)")
    log_port_arg = dict(type=int, default=None, metavar="PORT",
                        help="the device's TCP console port (default: log.tcp_port from "
                             "device.yml, else 23)")

    def add_image_flags(p):
        """Images built elsewhere, in place of the project's build output."""
        p.add_argument("--firmware", default=None, metavar="FILE",
                       help="firmware image to send instead of the project's build "
                            "(no project needed)")
        p.add_argument("--filesystem", default=None, metavar="FILE",
                       help="LittleFS image to send instead of the project's build "
                            "(no project needed)")

    def add_monitor_flags(p, wait_default: int):
        """--monitor tail shared by build/run/push."""
        p.add_argument("--monitor", action="store_true",
                       help="when finished, attach the network monitor to the device's TCP console")
        p.add_argument("--host", **host_arg)
        p.add_argument("--monitor-wait", **dict(wait_arg, default=wait_default))
        p.add_argument("--log-port", **log_port_arg)

    def add_ota_flags(p):
        """--ota upload transport, shared by run/push."""
        p.add_argument("--ota", action="store_true",
                       help="flash over the network (POST the images to the device's OTA "
                            "endpoints) instead of over USB")
        p.add_argument("--pull", action="store_true",
                       help="flash over the network the other way round: the device "
                            "downloads the images itself from --url")
        p.add_argument("--url", default=None, metavar="BASE",
                       help="with --pull, the base URL the DEVICE fetches firmware.bin "
                            "and littlefs.bin from (e.g. https://releases.example.com/v1.2). "
                            "'ebus-esp32 serve' runs one over this build")
        p.add_argument("--pull-wait", type=int, default=300, metavar="SECONDS",
                       help="with --pull, how long to wait for the device to finish "
                            "(default: 300)")
        p.add_argument("--passphrase", default=None, metavar="PASS",
                       help="device passphrase for the OTA endpoints "
                            "(default: device.device_passphrase from config-overlay.yml, "
                            "then device.yml)")

    # Subcommands are registered in ALPHABETICAL order: argparse lists them in the order
    # they are added, both in the usage line and the help body, so this ordering IS the
    # --help ordering. Keep new commands in place rather than appending, and mirror any
    # addition in the epilog examples above (also alphabetical) and the dispatch below.
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("build", help="Generate, then compile firmware + filesystem image via PlatformIO")
    p.add_argument("device_yml", **dev_yml_arg)
    add_monitor_flags(p, 30)   # no flash, so the device should already be up

    p = sub.add_parser("check", help="Run pio static analysis (cppcheck)")
    p.add_argument("device_yml", **dev_yml_arg)

    p = sub.add_parser("clean", help="Clean PlatformIO build artifacts")
    p.add_argument("device_yml", **dev_yml_arg)

    p = sub.add_parser("compiledb", help="Regenerate compile_commands.json for clangd / LSP")
    p.add_argument("device_yml", **dev_yml_arg)

    p = sub.add_parser("config-status", help="Show whether a config-overlay.yml is active")
    p.add_argument("device_yml", **dev_yml_arg)

    sub.add_parser("devices", help="List attached serial devices")

    p = sub.add_parser("envs", help="List available PlatformIO board environments")
    p.add_argument("device_yml", **dev_yml_arg)

    p = sub.add_parser("generate", help="Generate the project's .ebus/ (device code, config.yml, homie.yml) from device.yml")
    p.add_argument("device_yml", **dev_yml_arg)

    p = sub.add_parser("monitor", help="Open the device monitor (network by default, USB with --serial)")
    p.add_argument("device_yml", **dev_yml_arg)
    p.add_argument("--port", **port_arg)
    p.add_argument("--host", **host_arg)
    p.add_argument("--net", "--network", dest="net", action="store_true",
                   help="force the network monitor (the default when an address is known)")
    p.add_argument("--serial", action="store_true",
                   help="force the USB serial monitor (implied by --port)")
    p.add_argument("--no-learn", action="store_true",
                   help="serial only: do not relay the stream through this CLI to learn the "
                        "device IP — keeps the monitor fully interactive")
    p.add_argument("--monitor-wait", **wait_arg)
    p.add_argument("--log-port", **log_port_arg)

    sub.add_parser("monitors", help="List active serial-monitor sessions (port-sharing breadcrumbs)")

    p = sub.add_parser("push", help="Flash pre-built firmware + filesystem (no generate/build)")
    p.add_argument("device_yml", **dev_yml_arg)
    p.add_argument("--port", **port_arg)
    p.add_argument("--fs-only", action="store_true", help="flash filesystem only (skip firmware)")
    p.add_argument("--erase", action="store_true", help="full chip erase first (recover from a stale-boot OTA slot)")
    add_ota_flags(p)
    add_image_flags(p)
    add_monitor_flags(p, 90)

    p = sub.add_parser("run", help="Generate, build, and flash firmware + filesystem to device")
    p.add_argument("device_yml", **dev_yml_arg)
    p.add_argument("--port", **port_arg)
    p.add_argument("--fs-only", action="store_true", help="flash filesystem only (skip firmware)")
    p.add_argument("--erase", action="store_true", help="full chip erase first (recover from a stale-boot OTA slot)")
    add_ota_flags(p)
    add_monitor_flags(p, 90)   # board reboots and must re-associate with WiFi first

    p = sub.add_parser("serve", help="Serve the built firmware/filesystem images over HTTP(S) "
                                     "for a device-initiated (pull) OTA")
    p.add_argument("device_yml", **dev_yml_arg)
    p.add_argument("--port", type=int, default=8080, metavar="PORT",
                   help="port to listen on (default: 8080)")
    p.add_argument("--bind", default="0.0.0.0", metavar="ADDR",
                   help="address to listen on (default: 0.0.0.0, every interface)")
    p.add_argument("--cert", default=None, metavar="FILE",
                   help="PEM certificate — serve https instead of http. The device needs "
                        "the matching CA at data/certs/<Host>.ca or it cannot verify it")
    p.add_argument("--key", default=None, metavar="FILE",
                   help="private key for --cert (default: the --cert file itself)")
    p.add_argument("--url-host", default=None, metavar="HOST",
                   help="hostname to print in the URLs (default: this machine's address "
                        "on the default route) — use it when the device reaches you by name")
    add_image_flags(p)

    sub.add_parser("test", help="Run the host-side unit tests (Unity, PlatformIO native env)")

    args = parser.parse_args()

    if getattr(args, "device_yml", None):
        project_dir, device_yml = project_paths(args.device_yml)
        use_project(project_dir)
        args.device_yml = str(device_yml)
        # Read by scripts/generate_homie.py when a `pio run` starts without the
        # custom_ebus_device_yml option the generated ini carries.
        os.environ["EBUS_DEVICE_YML"] = str(device_yml.resolve())

    dispatch = {                       # same alphabetical order as the parsers above
        "build":         cmd_build,
        "check":         cmd_check,
        "clean":         cmd_clean,
        "compiledb":     cmd_compiledb,
        "config-status": cmd_config_status,
        "devices":       cmd_devices,
        "envs":          cmd_envs,
        "generate":      cmd_generate,
        "monitor":       cmd_monitor,
        "monitors":      cmd_monitors,
        "push":          cmd_push,
        "run":           cmd_run,
        "serve":         cmd_serve,
        "test":          cmd_test,
    }
    dispatch[args.command](args)

if __name__ == "__main__":
    main()
