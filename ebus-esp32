    return path.parent, path

def shown(path) -> str:
    """A path for messages: relative to the current directory or the repo when under
    one of them, else absolute."""
    path = Path(path).resolve()
    for base in (Path.cwd(), ROOT):
        try:
            return str(path.relative_to(base.resolve()))
        except ValueError:
            pass
    return str(path)

