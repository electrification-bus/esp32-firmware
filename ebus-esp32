_HOMIE_CPP_HEADER = """\
// AUTO-GENERATED by `ebus-esp32 generate` — do not edit manually.
// Regenerate with: ebus-esp32 generate
//
// Static node instances for this Homie device.
// All objects are statically allocated; constructors run before setup().

#include <homie.h>
"""

def find_component_yml(component: str):
    """Resolve a device.yml `component:` string to its lib/<bus>/<name>.yml path, or
    None if it doesn't match anything — callers report this, never raise, so a typo'd
    component in device.yml is a clear ERROR message rather than a Python traceback."""
    parts = component.split("/")
    if len(parts) == 2:
        p = LIB_DIR / parts[0] / f"{parts[1]}.yml"
        return p if p.exists() else None
    for sub in LIB_DIR.iterdir():
        if sub.is_dir():
            candidate = sub / f"{component}.yml"
            if candidate.exists():
                return candidate
    return None

# _cpp_literal()'s named escapes. Any other control character becomes a three-digit octal
# escape, which ends after three digits, so a digit that follows is not swallowed (a hex
# escape \xNN would take every hex digit after it).
_CPP_ESCAPES = {"\\": "\\\\", '"': '\\"', "\n": "\\n", "\r": "\\r", "\t": "\\t"}

def _cpp_literal(v) -> str:
    """Render a YAML config value as a C++ source literal.

    Booleans are the reason this exists: YAML `true` parses to Python True, whose str()
    is "True" — not C++, so it fails the build with "\'True\' was not declared in this
    scope", pointing at a generated file the author never wrote and no line of device.yml.

    None is deliberately NOT special-cased: check_config_keys() already rejects a required
    key that is present with no value, naming both the key and the node. Mapping None to ""
    here would give a bare positional argument (`("id", , 15)`) a second chance to reach
    the compiler if that check ever moved, while silently disagreeing with it meanwhile.
    """
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, str):
        # Strings land inside the template's own quotes ("{config.format}"), so a quote
        # or backslash in the value must not end the C++ literal early, and a control
        # character (a YAML "\n", or a raw newline in a block scalar) must not break the
        # line. Identifiers and numbers spelled as strings pass through unchanged.
        return "".join(_CPP_ESCAPES.get(c) or (f"\\{ord(c):03o}" if ord(c) < 0x20 or c == "\x7f"
                                                else c) for c in v)
    return str(v)

def fmt_ctor(template: str, node_id: str, config: dict, registers: list = None,
             buses: dict = None) -> str:
    result = template.replace("{id}", node_id)
    # {registers} / {registers_count} name the static descriptor table emitted alongside
    # the object, for components whose shape comes from device.yml rather than their yml.
    if registers is not None:
        cvar = "".join(c if (c.isalnum() or c == "_") else "_" for c in str(node_id))
        result = result.replace("{registers}", f"_regs_{cvar}")
        result = result.replace("{registers_count}", str(len(registers)))
    for k, v in (config or {}).items():
        result = result.replace(f"{{config.{k}}}", _cpp_literal(v))
    # {bus.<name>.<key>} comes from device.yml's top-level buses: block — board facts
    # shared by every node on that bus, so they are declared once rather than repeated
    # (and required to agree) in each node's config:.
    for bus_name, bus_cfg in (buses or {}).items():
        for k, v in (bus_cfg or {}).items():
            result = result.replace(f"{{bus.{bus_name}.{k}}}", _cpp_literal(v))
    return result

_CONFIG_KEY_RE = re.compile(r"\{config\.(\w+)\}")
_BUS_KEY_RE    = re.compile(r"\{bus\.(\w+)\.(\w+)\}")

def required_config_keys(ctor_tmpl: str) -> set:
    """Config keys a component's constructor template actually substitutes, e.g.
    '{config.pin}' -> {'pin'}."""
    return set(_CONFIG_KEY_RE.findall(ctor_tmpl))

def required_bus_keys(ctor_tmpl: str) -> set:
    """(bus, key) pairs a constructor template substitutes, e.g. '{bus.i2c.pin_sda}'
    -> {('i2c', 'pin_sda')}."""
    return set(_BUS_KEY_RE.findall(ctor_tmpl))

def check_bus_keys(node_id: str, component: str, comp_path: Path,
                   ctor_tmpl: str, buses: dict) -> None:
    """Every {bus.<name>.<key>} a component needs must be declared under device.yml's
    top-level buses: block, with a value."""
    required = sorted(required_bus_keys(ctor_tmpl))
    if not required:
        return
    if buses is None:
        buses = {}
    if not isinstance(buses, dict):
        print(f"ERROR: device.yml buses: value isn't a mapping (got "
              f"{type(buses).__name__}) — expected e.g.\n"
              f"  buses:\n    i2c: {{ pin_sda: 13, pin_scl: 16 }}", file=sys.stderr)
        sys.exit(1)
    problems = []
    for bus, key in required:
        bus_cfg = buses.get(bus)
        if bus_cfg is None or not isinstance(bus_cfg, dict):
            msg = f"buses.{bus} is not declared" if bus_cfg is None else f"buses.{bus} isn't a mapping"
            if msg not in problems:
                problems.append(msg)
        elif key not in bus_cfg:
            problems.append(f"buses.{bus}.{key} is missing")
        elif bus_cfg[key] is None:
            problems.append(f"buses.{bus}.{key} has no value")
    if problems:
        print(f"ERROR: device.yml node '{node_id}' (component '{component}') needs "
              f"{'; '.join(problems)}. Bus pins are declared ONCE in the top-level buses: "
              f"block (see doc/GPIOPins.md for reference values), not per node — see "
              f"{comp_path}", file=sys.stderr)
        sys.exit(1)

def check_config_keys(node_id: str, component: str, comp_path: Path,
                       ctor_tmpl: str, node_cfg: dict) -> None:
    """Catch a missing or typo'd config: key at generate time instead of letting it
    surface as a raw '{config.foo}' left in the generated C++ (a confusing compile
    error far from the actual mistake in device.yml)."""
    required = required_config_keys(ctor_tmpl)
    node_cfg = node_cfg or {}
    provided = set(node_cfg.keys())
    missing = sorted(required - provided)
    # A key present with no value (`pin:` with nothing after the colon, or explicit
    # `pin: null`) parses as {"pin": None} — present, so it wouldn't show up as
    # "missing" above, but str(None) would land the literal text "None" in the
    # generated C++ constructor call. Treat it as its own case, not silently OK.
    empty = sorted(k for k in required if k in node_cfg and node_cfg[k] is None)
    extra = sorted(provided - required)
    if missing or empty or extra:
        parts = []
        if missing:
            parts.append(f"missing required key(s): {', '.join(missing)}")
        if empty:
            parts.append(f"required key(s) present but with no value: {', '.join(empty)} "
                         f"(check for a trailing ':' with nothing after it)")
        if extra:
            # Reported alongside `missing` so a typo (e.g. 'pinn' instead of 'pin')
            # shows up as BOTH "missing pin" and "unrecognized pinn" in one message —
            # the pairing is what makes it obvious it's a typo, not just an omission.
            parts.append(f"unrecognized key(s): {', '.join(extra)} (check for a typo)")
            if any(k.startswith("pin_") for k in extra):
                parts.append("bus pins (pin_sda/pin_scl, pin_a/pin_b) are declared once in "
                             "the top-level buses: block, not in a node's config:")
        print(f"ERROR: device.yml node '{node_id}' (component '{component}') config: block "
              f"problem — {'; '.join(parts)}. Expected: {', '.join(sorted(required)) or 'none'} "
              f"— see {comp_path}", file=sys.stderr)
        sys.exit(1)

def _is_pin_key(key: str) -> bool:
    return key == "pin" or key.startswith("pin_")

def check_gpio_conflicts(pin_uses: dict) -> None:
    """Fail when one GPIO is claimed twice: by two buses, by a bus and a node, or by
    two nodes (or two pins of one node). pin_uses maps a label such as
    'buses.i2c.pin_sda' or "node 'relay1' config.pin" to its GPIO number. Two nodes on
    one bus share its pins legitimately, so each bus pin appears once however many
    nodes use it. Negative numbers are skipped."""
    by_gpio = {}
    for label, gpio in pin_uses.items():
        if isinstance(gpio, bool) or not isinstance(gpio, int) or gpio < 0:
            continue
        by_gpio.setdefault(gpio, []).append(label)
    clashes = [(g, labels) for g, labels in sorted(by_gpio.items()) if len(labels) > 1]
    if clashes:
        print("ERROR: device.yml assigns the same GPIO more than once:", file=sys.stderr)
        for gpio, labels in clashes:
            print(f"  GPIO {gpio}: {', '.join(labels)}", file=sys.stderr)
        print("Give each a different pin (see doc/GPIOPins.md for the free pins per board).",
              file=sys.stderr)
        sys.exit(1)

# ── lean, per-build platformio.ini ──────────────────────────────────────────────
#
# Every lib/<bus>/<name>.yml component can declare generator.lib_deps: [...] — the
# PlatformIO libraries IT needs. The full catalog of every such string, across every
# component that exists (whether device.yml uses it or not), is the set of libraries
# eligible for pruning from platformio.ini's [common].lib_deps: anything in that
# catalog gets dropped from the copy unless the CURRENT device.yml actually uses a
# component that lists it. This generalizes — a future BME280/ATM90E32 lib_deps entry
# gets the same treatment automatically, no generator changes needed.

def collect_optional_lib_catalog() -> set:
    """Every generator.lib_deps string across all lib/<bus>/<name>.yml files —
    the full set of libraries that are ever conditionally needed, used to decide
    what's safe to prune from [common].lib_deps when not actually in use."""
    catalog = set()
    for comp_yml in LIB_DIR.glob("*/*.yml"):
        comp = load_yaml_file(comp_yml)
        gen = comp.get("generator") or {}
        for dep in gen.get("lib_deps") or []:
            catalog.add(dep)
    return catalog

_INCLUDE_RE = re.compile(r'^\s*#\s*include\s*[<"]([^>"]+)[>"]', re.M)

def component_source_closure(used_components: list) -> list:
    """The lib/<bus>/<name> components whose sources this build compiles: the ones
    device.yml uses, plus any component whose header one of them includes (sht20.h
    includes modbus/register_device.h, so register_device.cpp has to build too).
    Followed transitively through every lib/ header and .cpp reached. Returned as
    sorted 'bus/name' strings for scripts/lib_src_filter.py."""
    seen_files = set()
    pending = []
    for comp in used_components:
        pending += [LIB_DIR / f"{comp}.h", LIB_DIR / f"{comp}.cpp"]
    while pending:
        path = pending.pop()
        if path in seen_files or not path.is_file():
            continue
        seen_files.add(path)
        for inc in _INCLUDE_RE.findall(path.read_text(encoding="utf-8", errors="replace")):
            target = LIB_DIR / inc
            if target.is_file():
                pending += [target, target.with_suffix(".cpp")]
    found = set(used_components)
    for path in seen_files:
        if path.with_suffix(".yml").is_file():
            found.add(f"{path.parent.name}/{path.stem}")
    return sorted(found)

# ── project staging ─────────────────────────────────────────────────────────────
#
# PlatformIO compiles one src_dir and packs one data_dir, so both are assembled under the
# project's .ebus/. src/ links to the firmware's own sources, to the project's src/ (as
# src/project) and holds the generated homie.cpp. data/ is a copy of the repo's data/ with
# the project's data/ over it, plus the generated config.yml and homie.yml.

# Written by the generator, never staged from a data/ directory: an older clone may still
# hold a generated data/config.yml, secrets included.
_GENERATED_DATA = ("config.yml", "homie.yml")
_PROJECT_SRC_LINK = "project"
_SOURCE_SUFFIXES = (".h", ".hpp", ".c", ".cc", ".cpp")

def _link_or_copy(target: Path, link: Path) -> None:
    """Make link a symlink to target, or a copy where symlinks are unavailable (Windows
    without Developer Mode). A link that already points at target is left alone."""
    if link.is_symlink() and Path(os.readlink(link)) == target:
        return
    if link.is_symlink() or link.is_file():
        link.unlink()
    elif link.is_dir():
        shutil.rmtree(link)
    try:
        link.symlink_to(target, target_is_directory=target.is_dir())
    except OSError:
        if target.is_dir():
            shutil.copytree(target, link)
        else:
            shutil.copy2(target, link)

def stage_sources() -> None:
    """Populate GEN_SRC_DIR with links to the firmware sources and the project's src/.
    The pioarduino platform writes its own idf_component.yml there."""
    wanted = {e.name: e for e in sorted(SRC_DIR.iterdir())
              if e.name != "homie.cpp" and (e.is_dir() or e.suffix in _SOURCE_SUFFIXES)}
    project_src = PROJECT_DIR / "src"
    if project_src.is_dir():
        wanted[_PROJECT_SRC_LINK] = project_src
    GEN_SRC_DIR.mkdir(parents=True, exist_ok=True)
    for entry in GEN_SRC_DIR.iterdir():
        if entry.name in wanted or entry.name == "homie.cpp" or entry.name.startswith("idf_component"):
            continue
        if entry.is_dir() and not entry.is_symlink():
            shutil.rmtree(entry)
        else:
            entry.unlink()
    for name, target in wanted.items():
        _link_or_copy(target, GEN_SRC_DIR / name)

def _skip_data(top: Path):
    """copytree ignore function: editor leftovers anywhere, and the generated files at the
    top of the data/ directory being copied."""
    def ignore(directory, names):
        skip = {n for n in names if n.endswith(("~", ".bak")) or n == ".DS_Store"}
        if Path(directory) == top:
            skip |= {n for n in names if n in _GENERATED_DATA}
        return skip
    return ignore

def stage_data() -> None:
    """Rebuild GEN_DATA_DIR from the repo's data/ and the project's data/."""
    if GEN_DATA_DIR.exists():
        shutil.rmtree(GEN_DATA_DIR)
    shutil.copytree(DATA_DIR, GEN_DATA_DIR, ignore=_skip_data(DATA_DIR))
    project_data = PROJECT_DIR / "data"
    if project_data.is_dir():
        for name in _GENERATED_DATA:
            if (project_data / name).exists():
                print(f"  NOTE: {shown(project_data / name)} is not used: {name} is generated "
                      f"from device.yml and config-overlay.yml")
        shutil.copytree(project_data, GEN_DATA_DIR, dirs_exist_ok=True,
                        ignore=_skip_data(project_data))

def project_components() -> list:
    """The lib/<bus>/<name> components the project's own src/ includes, as 'bus/name', so
    their sources and libraries are part of the build."""
    src = PROJECT_DIR / "src"
    if not src.is_dir():
        return []
    found = []
    for path in sorted(src.rglob("*")):
        if not path.is_file() or path.suffix not in _SOURCE_SUFFIXES:
            continue
        for inc in _INCLUDE_RE.findall(path.read_text(encoding="utf-8", errors="replace")):
            target = LIB_DIR / inc
            if target.suffix == ".h" and target.with_suffix(".yml").is_file():
                name = f"{target.parent.name}/{target.stem}"
                if name not in found:
                    found.append(name)
    return found

def write_lean_platformio_ini(env_name: str, used_lib_deps: list,
                              used_components: list, controller: bool = False,
                              device_yml: Path = None) -> None:
    """Write .ebus/platformio.ini: a standalone copy of platformio.ini containing
    only [platformio], [env], [common] (lib_deps pruned+extended), and this one
    environment's [env:<name>] — everything `pio_run()` needs, nothing device.yml's
    components don't actually use. Silently skipped if platformio.ini doesn't
    parse or that env section doesn't exist (e.g. a bad environment: name is
    reported elsewhere, by get_environment()-consuming commands)."""
    if not PLATFORMIO_INI.exists():
        return
    src = configparser.RawConfigParser()
    src.read(PLATFORMIO_INI, encoding="utf-8")
    env_section = f"env:{env_name}"
    if not src.has_section("common") or not src.has_section(env_section):
        return

    optional_catalog = collect_optional_lib_catalog()
    base_deps = [line.strip() for line in src.get("common", "lib_deps").splitlines() if line.strip()]
    kept_deps = [d for d in base_deps if d not in optional_catalog]
    for dep in used_lib_deps:
        if dep not in kept_deps:
            kept_deps.append(dep)

    # If this build's lib_deps set differs from the PREVIOUS .ebus/platformio.ini
    # for this environment, PlatformIO will reassign different short-hash library build
    # subdirectories (lib5d2, lib836, ...) for the same source files. .pio/build/
    # doesn't get pruned when a library drops out, so its stale SCons dependency
    # database (.sconsign.dblite) and orphaned object files can silently persist
    # and get reused — the generated firmware then reflects a PREVIOUS device.yml
    # state despite src/homie.cpp being freshly regenerated. Force a clean env
    # build dir whenever the active lib_deps set actually changes, so this can't
    # happen silently; a same-lib_deps rebuild stays incremental as normal.
    previous_deps = None
    if GENERATED_INI.exists():
        prev = configparser.RawConfigParser()
        prev.read(GENERATED_INI, encoding="utf-8")
        if prev.has_section("common"):
            previous_deps = sorted(l.strip() for l in prev.get("common", "lib_deps").splitlines() if l.strip())
    if previous_deps is not None and previous_deps != sorted(kept_deps):
        env_build_dir = PIO_BUILD_DIR / env_name
        if env_build_dir.exists():
            shutil.rmtree(env_build_dir)
            print(f"  lib_deps changed for env:{env_name} — removed stale {shown(env_build_dir)} "
                  f"to avoid a mismatched incremental build")

    out = configparser.RawConfigParser()
    for section in ("platformio", "env", "common"):
        if src.has_section(section):
            out.add_section(section)
            for key, val in src.items(section):
                out.set(section, key, val)
    # Build into the project's .ebus/ and install libraries into the CLI's own tree (see
    # PIO_LIBDEPS_DIR), compiling the staged sources and packing the staged data/.
    if not out.has_section("platformio"):
        out.add_section("platformio")
    out.set("platformio", "build_dir", str(PIO_BUILD_DIR))
    out.set("platformio", "libdeps_dir", str(PIO_LIBDEPS_DIR))
    out.set("platformio", "src_dir", str(GEN_SRC_DIR))
    out.set("platformio", "data_dir", str(GEN_DATA_DIR))
    out.set("common", "lib_deps", "\n" + "\n".join(kept_deps))
    out.add_section(env_section)
    for key, val in src.items(env_section):
        out.set(env_section, key, val)
    # homie_role: controller selects the controller build. Set here, from device.yml, so
    # the role and the compiled firmware cannot disagree the way a hand-edited flag could.
    if controller:
        flags = out.get(env_section, "build_flags") if out.has_option(env_section, "build_flags") else ""
        if "-DENABLE_CONTROLLER" not in flags:
            out.set(env_section, "build_flags", (flags + "\n" if flags else "") + "-DENABLE_CONTROLLER")
    # Read by scripts/lib_src_filter.py, so a lib/<bus> library compiles only these
    # components' sources: an unused component's #include would otherwise need a
    # library that kept_deps left out.
    out.set(env_section, "custom_ebus_components",
            " ".join(component_source_closure(used_components)))
    # Read by scripts/generate_homie.py, which regenerates from it at the start of every
    # `pio run`, raw ones included.
    if device_yml is not None:
        out.set(env_section, "custom_ebus_device_yml", str(Path(device_yml).resolve()))

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    with open(GENERATED_INI, "w", encoding="utf-8") as f:
        f.write("; AUTO-GENERATED by `ebus-esp32 generate` — do not edit manually.\n")
        f.write(f"; Lean copy of platformio.ini for env:{env_name} — [common].lib_deps pruned to\n")
        f.write("; drop unused optional libraries, extended with what device.yml needs.\n")
        out.write(f)
    print(f"  generated: {shown(GENERATED_INI)}  (env:{env_name}, "
          f"{len(kept_deps)} lib_deps, {len(base_deps) - len([d for d in base_deps if d in kept_deps])} pruned)")

# ── properties synthesized from device.yml ─────────────────────────────────────
#
# Normally a node's Homie properties come from its component yml, which is right when the
# component knows its own shape: a BME280 always has temperature/humidity/pressure. It is
# wrong for a GENERIC component, where the shape is per-instance — one Modbus register map
# is not another. Those components declare
#
#     generator:
#       properties_from: registers
#
# and their device.yml entry carries a `registers:` list, which becomes both the Homie
# properties and a static descriptor table compiled into src/homie.cpp.
#
# Scoped deliberately to Modbus registers for now. The mechanism generalizes — the same
# gap blocks per-rule scheduler properties and per-zone controller properties — but one
# real consumer is enough to prove the shape before committing to it everywhere.

# Homie datatypes a register can reasonably decode to.
_REGISTER_DATATYPES = ("float", "integer", "boolean")

# The firmware's per-node register table is a fixed array of REGDEV_MAX_REGISTERS, and the
# driver ignores entries past it. Read the cap from the header so the two cannot drift.
_REGDEV_HEADER = ROOT / "lib" / "modbus" / "register_device.h"

def _regdev_max_registers():
    m = re.search(r"^#define\s+REGDEV_MAX_REGISTERS\s+(\d+)",
                  _REGDEV_HEADER.read_text(encoding="utf-8"), re.MULTILINE)
    if not m:
        print(f"ERROR: REGDEV_MAX_REGISTERS not found in "
              f"{_REGDEV_HEADER.relative_to(ROOT)}", file=sys.stderr)
        sys.exit(1)
    return int(m.group(1))

def registers_to_properties(regs, node_id, comp_path):
    """device.yml `registers:` -> the same property dicts a component yml would declare.
    Returns the list; exits with a specific message on anything malformed, because a
    register map typo otherwise surfaces as a property that silently never publishes."""
    if not isinstance(regs, list) or not regs:
        print(f"ERROR: node '{node_id}' uses component {comp_path.name}, which requires a "
              f"non-empty 'registers:' list in its device.yml entry", file=sys.stderr)
        sys.exit(1)
    cap = _regdev_max_registers()
    if len(regs) > cap:
        print(f"ERROR: node '{node_id}' lists {len(regs)} registers; the firmware holds at "
              f"most {cap} per node (REGDEV_MAX_REGISTERS in "
              f"{_REGDEV_HEADER.relative_to(ROOT)}). Split the map across two nodes at the "
              f"same address, or raise the cap.", file=sys.stderr)
        sys.exit(1)

    props, seen = [], set()
    for i, r in enumerate(regs):
        where = f"node '{node_id}' registers[{i}]"
        if not isinstance(r, dict):
            print(f"ERROR: {where}: expected a mapping, got {type(r).__name__}", file=sys.stderr)
            sys.exit(1)
        rid = r.get("id")
        if not rid:
            print(f"ERROR: {where}: missing required 'id'", file=sys.stderr)
            sys.exit(1)
        if not isinstance(rid, str):
            print(f"ERROR: {where}: id must be a string, got {rid!r} (quote it in the "
                  f"yml if it looks like a number)", file=sys.stderr)
            sys.exit(1)
        if rid in seen:
            print(f"ERROR: {where}: duplicate register id '{rid}' — ids become property "
                  f"topics and must be unique within the node", file=sys.stderr)
            sys.exit(1)
        seen.add(rid)
        if r.get("reg") is None:
            print(f"ERROR: {where} ('{rid}'): missing required 'reg' (the register "
                  f"address, e.g. 1 or 0x0001)", file=sys.stderr)
            sys.exit(1)
        if isinstance(r["reg"], bool) or not isinstance(r["reg"], int):
            print(f"ERROR: {where} ('{rid}'): reg must be an integer, got {r['reg']!r}. "
                  f"YAML reads 0x0001 as an int but \"0x0001\" as a string.", file=sys.stderr)
            sys.exit(1)
        kind = r.get("type", "input")
        if kind not in ("input", "holding"):
            print(f"ERROR: {where} ('{rid}'): type must be 'input' or 'holding', "
                  f"got {kind!r}", file=sys.stderr)
            sys.exit(1)
        datatype = r.get("datatype", "float")
        if datatype not in _REGISTER_DATATYPES:
            print(f"ERROR: {where} ('{rid}'): datatype must be one of "
                  f"{', '.join(_REGISTER_DATATYPES)}, got {datatype!r}", file=sys.stderr)
            sys.exit(1)

        prop = {"id": rid,
                "name": r.get("name", rid.replace("_", " ").replace("-", " ").title()),
                "datatype": datatype,
                "settable": False,
                "retained": True}
        # Pass `unit` through only when present, so the generator's existing
        # numeric-property-without-a-unit warning still fires on a forgotten one.
        if "unit" in r:
            prop["unit"] = r["unit"]
        if r.get("description"):
            prop["description"] = r["description"]
        props.append(prop)
    return props

# Homie datatype -> the ModbusRegDatatype the driver publishes through. The two must
# agree: the declared datatype goes into $description while this picks the
# set_value_and_publish() overload, and a mismatch means a property whose payload
# contradicts its own declaration ("1.0000" for a boolean).
_REGISTER_DATATYPE_ENUM = {
    "float":   "REGDEV_FLOAT",
    "integer": "REGDEV_INTEGER",
    "boolean": "REGDEV_BOOLEAN",
}

def registers_to_desc_table(regs, node_id):
    """The C++ side: a static ModbusRegisterDesc[] compiled into src/homie.cpp, so the
    register map costs no runtime parsing and no heap."""
    lines = [f"static const ModbusRegisterDesc _regs_{_cvar_global(node_id)}[] = {{"]
    for r in regs:
        holding = "true" if r.get("type", "input") == "holding" else "false"
        signed_ = "true" if r.get("signed", False) else "false"
        scale = float(r.get("scale", 1))
        dt = _REGISTER_DATATYPE_ENUM[r.get("datatype", "float")]
        lines.append(f'    {{ "{r["id"]}", {r["reg"]}, {holding}, {signed_}, {scale!r}f, {dt} }},')
    lines.append("};")
    return lines

def _cvar_global(s):
    return "".join(c if (c.isalnum() or c == "_") else "_" for c in str(s))

# The firmware's settable subscriber table (lib/ebus_core/src/homie/homie_settable.cpp,
# allocated in src/platform/mqtt_client.cpp) holds one entry per distinct /set topic plus
# the device's watch on its own $state and one per remote source of a device-build
# logic/link, which go through the same table. Drivers
# register their /set topics against properties their yml declares settable, so the yml
# count bounds the table; the margin absorbs a driver that registers a /set on a property
# its yml leaves read-only.
_SETTABLE_TABLE_WATCHES = 1   # the root device's $state watch (main.cpp watch_own_state)
_SETTABLE_TABLE_MARGIN  = 4
_SETTABLE_TABLE_FLOOR   = 8

# ── logic/link references ─────────────────────────────────────────────────────

def link_refs(value) -> list:
    """The comma-separated references in a link's source: or target:, stripped."""
    return [r.strip() for r in str(value if value is not None else "").split(",")]

def remote_source_topic_key(ref: str):
    """'<device>/<node>/<property>' as the firmware subscribes it (each part sanitized),
    or None for a local or * reference."""
    parts = ref.split("/")
    if len(parts) != 3 or "*" in ref:
        return None
    return "/".join(sanitize_homie_id(p) for p in parts)

def count_remote_sources(link_entries: list) -> int:
    """Settable-table entries a device build's links register: one per remote source."""
    return sum(1 for _, cfg in link_entries for ref in link_refs(cfg.get("source"))
               if remote_source_topic_key(ref) is not None)

_LINK_MAX_SOURCES = 3            # EbusLink::MAX_SOURCES in <ebus/link/link.h>
_LINK_PATTERN_RE  = re.compile(r"[a-z0-9*-]+")
_LINK_PART_LIMITS = {3: ("HOMIE_DEVICE_ID_MAX", "HOMIE_NODE_ID_MAX", "HOMIE_PROPERTY_ID_MAX"),
                     2: ("HOMIE_NODE_ID_MAX", "HOMIE_PROPERTY_ID_MAX")}

def link_ref_problem(ref: str, controller: bool, limits: dict):
    """Why Link::setup() (ebus_link_parse_ref() in the core) would refuse `ref`,
    or None. Returns (problem, parts), the parts sanitized as the firmware does."""
    raw = ref.split("/")
    if not ref or len(raw) not in (2, 3) or any(not p for p in raw):
        return "must be <node>/<property> or <device-id>/<node>/<property>", None
    if controller and len(raw) != 3:
        return ("must be <device-id>/<node>/<property>: a controller has no nodes of its "
                "own"), None
    if "*" in raw[-1]:
        return "has * in the property, which is never resolved", None
    parts = []
    for p, limit_name in zip(raw, _LINK_PART_LIMITS[len(raw)]):
        if "*" in p:
            if not controller:
                return ("uses *, which only a controller build resolves (homie_role: "
                        "controller)"), None
            part = p.lower()
            if not _LINK_PATTERN_RE.fullmatch(part):
                return f"has a malformed pattern '{p}': only a-z, 0-9, - and *", None
        else:
            part = sanitize_homie_id(p)
            if not part:
                return f"has a part '{p}' with no Homie id characters", None
        if len(part) > limits[limit_name]:
            return (f"has a part '{part}' of {len(part)} chars; the firmware holds at most "
                    f"{limits[limit_name]} ({limit_name} in {_HOMIE_LIMITS_NAME})"), None
        parts.append(part)
    return None, parts

def check_link_refs(link_entries: list, controller: bool, root_id: str, limits: dict) -> None:
    """Refuse the references Link::setup() would refuse at boot, and topics over
    HOMIE_TOPIC_MAX, which it would disable."""
    errors = []
    topic_max = limits["HOMIE_TOPIC_MAX"]
    kind = "controller link" if controller else "link"
    for link_id, cfg in link_entries:
        for key in ("source", "target"):
            refs = link_refs(cfg.get(key))
            if key == "target" and len(refs) != 1:
                errors.append(f"{kind} '{link_id}' target: must be one reference (got "
                              f"{cfg.get(key)!r})")
                continue
            if key == "source" and len(refs) > _LINK_MAX_SOURCES:
                errors.append(f"{kind} '{link_id}' source: at most {_LINK_MAX_SOURCES} "
                              f"references (got {len(refs)})")
                continue
            for ref in refs:
                problem, parts = link_ref_problem(ref, controller, limits)
                if problem:
                    errors.append(f"{kind} '{link_id}' {key}: '{ref}' {problem}")
                    continue
                if any("*" in p for p in parts):
                    continue   # its topic is known only once it binds; the firmware checks it then
                if len(parts) == 3:
                    topic = f"{_TOPIC_PREFIX}/{'/'.join(parts)}"
                elif key == "target":
                    topic = f"{_TOPIC_PREFIX}/{root_id}/{'/'.join(parts)}"
                else:
                    continue   # a local source is read directly, with no topic
                if key == "target":
                    topic += "/set"
                if len(topic) > topic_max:
                    errors.append(f"{kind} '{link_id}' {key}: topic '{topic}' is {len(topic)} "
                                  f"chars; the firmware holds at most {topic_max} "
                                  f"(HOMIE_TOPIC_MAX in {_HOMIE_LIMITS_NAME}; measured with "
                                  f"the longer prefix '{_TOPIC_PREFIX}')")
    for e in errors:
        print(f"ERROR: {e}", file=sys.stderr)
    if errors:
        print("       See doc/Link.md, 'References'.", file=sys.stderr)
        sys.exit(1)

def check_shared_remote_sources(link_entries: list) -> None:
    """A device build's link watches a remote source through the settable table, which
    keeps one handler per topic: a second link source on the same topic would take it
    over and leave the first without values. Link::setup() refuses it at boot; refuse it
    here first."""
    seen = {}
    for link_id, cfg in link_entries:
        for ref in link_refs(cfg.get("source")):
            key = remote_source_topic_key(ref)
            if key is None:
                continue
            if key in seen:
                where = ("twice in its source:" if seen[key] == link_id
                         else f"in links '{seen[key]}' and '{link_id}'")
                print(f"ERROR: remote source '{key}' is used {where}. In a device build a "
                      f"topic can feed only one link source; use it in one link (see "
                      f"doc/Link.md, 'Several links').", file=sys.stderr)
                sys.exit(1)
            seen[key] = link_id

def settable_table_capacity(settable_count: int, link_watches: int = 0) -> int:
    return max(_SETTABLE_TABLE_FLOOR,
               settable_count + link_watches + _SETTABLE_TABLE_WATCHES + _SETTABLE_TABLE_MARGIN)

# ── id and topic lengths ───────────────────────────────────────────────────────
#
# The firmware holds ids and topics in fixed buffers sized from homie_limits.h in the core
# library (lib/ebus_core) and truncates anything longer, which publishes and subscribes on topics that are not the
# property's own. generate computes every id and topic the firmware will build and refuses
# one that does not fit. Not patched by the test sandbox: these read the real sources.
_HOMIE_LIMITS_HEADER = ROOT / "lib" / "ebus_core" / "include" / "homie" / "homie_limits.h"
_HOMIE_LIMITS_NAME   = _HOMIE_LIMITS_HEADER.relative_to(ROOT).as_posix()   # for messages
_CONFIG_H            = ROOT / "include" / "platform" / "config.h"
_CONFIG_CPP          = ROOT / "src" / "platform" / "config.cpp"
_HOMIE_LIMIT_NAMES   = ("HOMIE_DEVICE_ID_MAX", "HOMIE_NODE_ID_MAX", "HOMIE_PROPERTY_ID_MAX",
                        "HOMIE_TOPIC_MAX")
# Topics are measured with the longer of the two prefixes (HOMIE_TOPIC_PREFIX in
# lib/ebus_core/include/homie/homie.h), so a device.yml that passes fits either build.
_TOPIC_PREFIX        = "homie/5"
_TARGET_SUFFIX       = "/$target"    # the longest suffix the firmware appends to a property topic
_CHIP_ID_STANDIN     = "0" * 12      # ${chip_id}: the 6-byte eFuse MAC as 12 hex chars
_CHIP_ID_SHORT_STANDIN = "0" * 6     # ${chip_id_short}: its last 3 bytes
_HOMIE_SEPARATORS    = frozenset("_.- \t\n\v\f\r")

def _read_int(path: Path, pattern: str, what: str) -> int:
    m = re.search(pattern, path.read_text(encoding="utf-8"), re.MULTILINE)
    if not m:
        print(f"ERROR: {what} not found in {path.relative_to(ROOT)}", file=sys.stderr)
        sys.exit(1)
    return int(m.group(1))

def homie_limits() -> dict:
    """The id and topic limits, in characters, read from the firmware's own sources."""
    limits = {name: _read_int(_HOMIE_LIMITS_HEADER, rf"^#define\s+{name}\s+(\d+)\b", name)
              for name in _HOMIE_LIMIT_NAMES}
    limits["HOMIE_PROPERTY_TOPIC_MAX"] = limits["HOMIE_TOPIC_MAX"] - len(_TARGET_SUFFIX)
    # Buffer sizes, NUL included, so one less is the longest value they keep.
    limits["id_prefix"] = _read_int(_CONFIG_H, r"^extern char device_id_prefix\[(\d+)\]",
                                    "device_id_prefix[]") - 1
    limits["id_template"] = _read_int(_CONFIG_CPP, r"^static char device_id_template\[(\d+)\]",
                                      "device_id_template[]") - 1
    limits["device_name"] = _read_int(_CONFIG_H, r"^extern char device_name\[(\d+)\]",
                                      "device_name[]") - 1
    return limits

def sanitize_homie_id(value) -> str:
    """sanitize_homie_id() in lib/ebus_core/src/homie/homie_id.cpp, without its buffer
    limit: lowercase, keep a-z 0-9, turn runs of '_' '.' '-' and whitespace into one '-'
    between kept characters, drop everything else (non-ASCII bytes included)."""
    out, pending = [], False
    for b in str(value).encode("utf-8"):
        c = chr(b).lower() if b < 128 else ""
        if c and (("a" <= c <= "z") or ("0" <= c <= "9")):
            if pending and out:
                out.append("-")
            pending = False
            out.append(c)
        elif c and c in _HOMIE_SEPARATORS:
            pending = True
    return "".join(out)

def _utf8_head(value, n: int) -> str:
    """The first n bytes of value, as strncpy into an n+1-byte buffer keeps them."""
    return str(value).encode("utf-8")[:n].decode("utf-8", errors="ignore")

def runtime_root_id(template, prefix, name, limits) -> str:
    """The root device id generateDeviceID() (src/platform/config.cpp) resolves at boot,
    with stand-ins of the right length for the chip id, which only the device knows."""
    templ = str(template or "") or "${chip_id}"
    name_id = sanitize_homie_id(_utf8_head(name, limits["device_name"]))
    raw, i = [], 0
    while i < len(templ):
        if templ.startswith("${chip_id_short}", i):
            raw.append(_CHIP_ID_SHORT_STANDIN); i += len("${chip_id_short}")
        elif templ.startswith("${chip_id}", i):
            raw.append(_CHIP_ID_STANDIN); i += len("${chip_id}")
        elif templ.startswith("${name}", i):
            raw.append(name_id); i += len("${name}")
        else:
            raw.append(templ[i]); i += 1
    resolved = sanitize_homie_id("".join(raw))
    prefix_id = sanitize_homie_id(str(prefix or ""))
    return f"{prefix_id}-{resolved}" if prefix_id else resolved

def _merged_device_section(cfg: dict) -> dict:
    """device.yml's device: section with config-overlay.yml's merged over it, as
    _apply_overlay() merges them into data/config.yml."""
    device = cfg.get("device") if isinstance(cfg.get("device"), dict) else {}
    device = json.loads(json.dumps(device, default=str))   # a copy _deep_merge may write to
    if CONFIG_OVERLAY.exists():
        overlay = load_yaml_file(CONFIG_OVERLAY, require_mapping=False) or {}
        overlay_device = overlay.get("device") if isinstance(overlay, dict) else None
        if isinstance(overlay_device, dict):
            _deep_merge(device, overlay_device)
    return device

class IdLimits:
    """Collects every id and topic over its firmware limit, so generate reports them all."""

    def __init__(self, limits: dict):
        self.limits = limits
        self.errors = []

    def check_id(self, kind: str, value: str, limit_name: str, where: str = "") -> None:
        limit = self.limits[limit_name]
        if len(value) > limit:
            self.errors.append(f"{kind} id '{value}'{where} is {len(value)} chars; the "
                               f"firmware holds at most {limit} ({limit_name} in "
                               f"{_HOMIE_LIMITS_NAME})")

    def check_setting(self, key: str, value: str, limit_key: str, source: str) -> None:
        limit = self.limits[limit_key]
        if len(value) > limit:
            self.errors.append(f"{key} '{value}' is {len(value)} chars; the firmware keeps "
                               f"at most {limit} ({source})")

    def check_property_topic(self, topic: str, where: str) -> None:
        limit = self.limits["HOMIE_PROPERTY_TOPIC_MAX"]
        if len(topic) > limit:
            self.errors.append(f"property topic '{topic}' ({where}) is {len(topic)} chars; "
                               f"the firmware holds at most {limit} (HOMIE_TOPIC_MAX "
                               f"{self.limits['HOMIE_TOPIC_MAX']} in "
                               f"{_HOMIE_LIMITS_NAME}, less {len(_TARGET_SUFFIX)} "
                               f"for '{_TARGET_SUFFIX}')")

    def exit_if_any(self, uses_chip_id: bool) -> None:
        if not self.errors:
            return
        for e in self.errors:
            print(f"ERROR: {e}", file=sys.stderr)
        notes = [f"topics are measured with the longer prefix '{_TOPIC_PREFIX}'"]
        if uses_chip_id:
            notes.insert(0, f"${{chip_id}} is counted as its {len(_CHIP_ID_STANDIN)} hex "
                            f"chars, shown as {_CHIP_ID_STANDIN}")
        print(f"       ({'; '.join(notes)}.) Shorten the ids named above; see "
              f"doc/GenerateHomieDevice.md, 'Id and topic lengths'.", file=sys.stderr)
        sys.exit(1)

# Set once this process has generated, and inherited by every `pio run` it starts. The
# pre-build hook (scripts/generate_homie.py) re-runs generate inside each of those runs;
# with this set, that run's stdout is discarded so a build prints the generator output
# once. Errors go to stderr and still show.
_GENERATED_ENV = "EBUS_GENERATED"

def cmd_generate(args) -> None:
    if os.environ.get(_GENERATED_ENV) == "1":
        with open(os.devnull, "w") as devnull, contextlib.redirect_stdout(devnull):
            _generate(args)
        return
    _generate(args)
    os.environ[_GENERATED_ENV] = "1"

def _generate(args) -> None:
    require_core()
    device_yml = Path(args.device_yml)
    if PROJECT_DIR == ROOT:
        print("ERROR: this repo is the firmware, not a project. Keep the project in a "
              "directory of its own and name it:\n"
              f"         {shown(ROOT / 'ebus-esp32')} build path/to/my-device",
              file=sys.stderr)
        sys.exit(1)
    cfg        = load_device_yml(device_yml)
    device     = cfg.get("device", {})
    nodes_cfg  = cfg.get("nodes", [])
    buses_cfg  = cfg.get("buses") or {}

    # device.board was renamed device.environment. Nothing reads board any more, so an
    # old device.yml would generate cleanly and fail later at build with no hint why.
    if isinstance(device, dict) and "board" in device:
        print(f"ERROR: {device_yml} sets device.board, which is no longer read. Rename it "
              f"to device.environment (a PlatformIO env name; list them with "
              f"'ebus-esp32 envs').", file=sys.stderr)
        sys.exit(1)
    _require_passphrase(cfg, device_yml)
    broker_discovery = broker_discovery_list((cfg.get("mqtt") or {}).get("discover"),
                                             str(device_yml))

    # The root device id as the firmware resolves it: device.id and device.id_prefix may
    # come from config-overlay.yml; ${name} reads the homie.yml name, which only device.yml
    # sets. Every child id and topic below is built on it.
    id_limits = IdLimits(homie_limits())
    merged_device = _merged_device_section(cfg)
    id_template = str(merged_device.get("id") or "")
    id_prefix = str(merged_device.get("id_prefix") or "")
    id_limits.check_setting("device.id", id_template, "id_template",
                            "device_id_template[] in src/platform/config.cpp")
    id_limits.check_setting("device.id_prefix", id_prefix, "id_prefix",
                            "device_id_prefix[] in include/platform/config.h")
    root_id = runtime_root_id(id_template, id_prefix,
                              device.get("name", "Homie Device") if isinstance(device, dict)
                              else "Homie Device", id_limits.limits)
    id_limits.check_id("device", root_id, "HOMIE_DEVICE_ID_MAX",
                       " (the root device: device.id_prefix + device.id, resolved)")

    includes          = []
    decls             = []   # entity object declarations
    child_dev_decls   = []   # static Device dev_<child>;
    prop_static_decls = []   # static Property <var>;
    prop_reg_body     = []   # body of register_homie_properties()
    setups            = []
    loops             = []
    homie_nodes       = []   # ROOT device's nodes only (data/homie.yml)
    seen_node_ids     = {}   # node_id -> component that first used it (duplicate-id check)
    seen_node_cvars   = {}   # C++ name -> node_id, so ids that differ only in '-' vs '_' are caught
    seen_child_ids    = {}   # C++ name -> child id (duplicate child-device check)
    used_lib_deps     = []   # lib_deps strings from every used component's generator block (dedup, ordered)
    used_components   = []   # 'bus/name' of every used component (dedup, ordered)
    pin_uses          = {}   # label -> GPIO, for every bus and node pin in use (conflict check)
    settable_count    = [0]  # settable properties across the whole device tree
    link_entries      = []   # (node id, config) of every logic/link node and controller link

    def _cvar(s):
        return "".join(c if (c.isalnum() or c == "_") else "_" for c in str(s))

    def emit_node(entry, dev_access, setdev_addr, is_root, dev_id, dev_label):
        # dev_access: C++ device access prefix — "device->" (root) or "dev_x." (child)
        # setdev_addr: entity's device address ("&dev_x") for a child; None for root
        # dev_id: the device's runtime id; dev_label: how errors name the device
        if not isinstance(entry, dict):
            print(f"ERROR: device.yml has incorrect YAML under nodes: — check the "
                  f"indentation and syntax of that entry", file=sys.stderr)
            sys.exit(1)
        component = entry.get("component")
        node_id   = entry.get("id")
        node_cfg  = entry.get("config") or {}
        if not isinstance(node_cfg, dict):
            print(f"ERROR: device.yml has incorrect YAML in node '{node_id or component}'s "
                  f"config: block — check the indentation and syntax", file=sys.stderr)
            sys.exit(1)
        if not component:
            print(f"ERROR: device.yml node entry missing required 'component' field: "
                  f"{entry!r}", file=sys.stderr)
            sys.exit(1)
        comp_path = find_component_yml(component)
        if comp_path is None:
            if "/" in component:
                expected = f"lib/{component}.yml"
            else:
                expected = f"lib/<bus>/{component}.yml (searched every <bus> under {LIB_DIR})"
            print(f"ERROR: device.yml node '{node_id or component}' references component "
                  f"'{component}', which does not match any component file — expected "
                  f"{expected}", file=sys.stderr)
            sys.exit(1)
        comp = load_yaml_file(comp_path)
        gen = comp.get("generator")
        if not gen:
            print(f"WARNING: no generator block in {comp_path} — skipping")
            return
        missing = [k for k in ("class", "header", "constructor") if k not in gen]
        if missing:
            print(f"ERROR: component yml '{comp_path}' generator block missing required "
                  f"field(s): {', '.join(missing)}", file=sys.stderr)
            sys.exit(1)
        cls, header, ctor_tmpl = gen["class"], gen["header"], gen["constructor"]
        comp_nodes = comp.get("nodes", [])
        explicit_id = bool(node_id)

        # A component can declare that its properties come from the device.yml entry
        # instead of from its own yml — see registers_to_properties(). The synthesized
        # properties are injected into the component's (single) node here, BEFORE the
        # emission loop below, so addProperty(), data/homie.yml and the missing-unit
        # warning all work on them unchanged.
        registers = None
        if gen.get("properties_from") == "registers":
            registers = entry.get("registers")
            if len(comp_nodes) != 1:
                print(f"ERROR: component yml '{comp_path}' uses properties_from: registers, "
                      f"which requires exactly one node entry (found {len(comp_nodes)})",
                      file=sys.stderr)
                sys.exit(1)
            comp_nodes = [dict(comp_nodes[0])]
            comp_nodes[0]["properties"] = registers_to_properties(
                registers, node_id or comp_nodes[0].get("id"), comp_path)
        elif entry.get("registers"):
            print(f"  WARNING: node '{node_id or component}' has a registers: list, but "
                  f"component '{component}' does not declare generator.properties_from: "
                  f"registers — the list is IGNORED", file=sys.stderr)
        if not node_id:
            if comp_nodes and "id" not in comp_nodes[0]:
                print(f"ERROR: component yml '{comp_path}' first node entry missing "
                      f"required 'id' field: {comp_nodes[0]!r}", file=sys.stderr)
                sys.exit(1)
            node_id = comp_nodes[0]["id"] if comp_nodes else component.split("/")[-1]
        if node_id in seen_node_ids:
            hint = "" if explicit_id else " (defaulted from the component — add an explicit 'id:' to disambiguate)"
            print(f"ERROR: node id '{node_id}' is used by more than one node — first by "
                  f"component '{seen_node_ids[node_id]}', again by component "
                  f"'{component}'{hint}. Every node needs a unique id.", file=sys.stderr)
            sys.exit(1)
        seen_node_ids[node_id] = component
        cv = _cvar(node_id)
        if cv in seen_node_cvars:
            print(f"ERROR: node ids '{seen_node_cvars[cv]}' and '{node_id}' both become the "
                  f"C++ name '{cv}'. Change one so they differ by more than '-' versus '_'.",
                  file=sys.stderr)
            sys.exit(1)
        seen_node_cvars[cv] = node_id
        # The entity sanitizes its id (NodeEntity::setHomieNodeId), keeping the raw one if
        # nothing is left.
        entity_node_id = sanitize_homie_id(node_id) or str(node_id)
        id_limits.check_id("node", entity_node_id, "HOMIE_NODE_ID_MAX", f" ({dev_label})")
        # Optional constructor keys: generator.config_defaults fills in whatever the
        # device.yml entry leaves out, so a template can reference a key without every
        # instance having to spell it. Merged before the check, so a defaulted key counts
        # as provided and an explicit device.yml value still wins.
        node_cfg = {**(gen.get("config_defaults") or {}), **node_cfg}
        check_config_keys(node_id, component, comp_path, ctor_tmpl, node_cfg)
        check_bus_keys(node_id, component, comp_path, ctor_tmpl, buses_cfg)
        for bus, key in required_bus_keys(ctor_tmpl):
            if _is_pin_key(key):
                pin_uses[f"buses.{bus}.{key}"] = buses_cfg[bus][key]
        for key in required_config_keys(ctor_tmpl):
            if _is_pin_key(key):
                pin_uses[f"node '{node_id}' config.{key}"] = node_cfg[key]
        for dep in gen.get("lib_deps") or []:
            if dep not in used_lib_deps:
                used_lib_deps.append(dep)
        comp_name = f"{comp_path.parent.name}/{comp_path.stem}"
        if comp_name == "logic/link":
            link_entries.append((str(node_id), node_cfg))
        if comp_name not in used_components:
            used_components.append(comp_name)
        includes.append(f"#include <{header}>")
        if registers is not None:
            decls.extend(registers_to_desc_table(registers, node_id))
        # The C++ object is named after the node id, but Homie ids allow hyphens and C++
        # names don't — same mapping as the property variables below. {id} in the
        # constructor still gets the real id string.
        node_var = _cvar(node_id)
        decls.append(f"{cls} {node_var}{fmt_ctor(ctor_tmpl, node_id, node_cfg, registers, buses_cfg)};")
        setups.append(f"    {node_var}.setup();")
        loops.append(f"    {node_var}.loop();")
        if setdev_addr:
            prop_reg_body.append(f"    {node_var}.setDevice({setdev_addr});")  # entity -> child device (A2)
        single = len(comp_nodes) == 1
        for n in comp_nodes:
            nc = dict(n)
            if not single and "id" not in n:
                print(f"ERROR: component yml '{comp_path}' node entry missing required "
                      f"'id' field: {n!r}", file=sys.stderr)
                sys.exit(1)
            effective_node_id = node_id if single else n["id"]
            if single:
                nc["id"] = node_id
            if is_root:                # children are built in C++, not data/homie.yml
                homie_nodes.append(nc)
            properties = n.get("properties", [])
            node_name  = n.get("name", effective_node_id)
            node_type  = n.get("type", "generic")
            # A single-node component's node takes the entity's id (getNodeId() below); a
            # multi-node component passes each node id to addNode() as written.
            if single:
                fw_node_id = entity_node_id
            else:
                fw_node_id = str(effective_node_id)
                id_limits.check_id("node", fw_node_id, "HOMIE_NODE_ID_MAX",
                                   f" (component {comp_name}, {dev_label})")
            if properties:
                prop_reg_body.append("")
                id_expr = f'{node_var}.getNodeId()' if single else f'"{effective_node_id}"'
                prop_reg_body.append(f'    _node = {dev_access}addNode({id_expr}, "{node_name}", "{node_type}");')
                prop_reg_body.append('    if (_node) {')
                for prop in properties:
                    prop_id   = prop["id"]
                    # Sanitize the C++ variable name (Homie ids allow hyphens, C++ names
                    # don't) while the addProperty() arg below keeps the real id string.
                    prop_var  = f"_prop_{_cvar(effective_node_id)}_{_cvar(prop_id)}"
                    # Node::addProperty() sanitizes the id, keeping the raw one if nothing
                    # is left; the topic is the node's plus that id.
                    fw_prop_id = sanitize_homie_id(prop_id) or str(prop_id)
                    where = f"node '{fw_node_id}', {dev_label}"
                    id_limits.check_id("property", fw_prop_id, "HOMIE_PROPERTY_ID_MAX",
                                       f" ({where})")
                    id_limits.check_property_topic(
                        f"{_TOPIC_PREFIX}/{dev_id}/{fw_node_id}/{fw_prop_id}", where)
                    unit      = prop.get("unit", "")
                    settable  = prop.get("settable", False)
                    if settable:
                        settable_count[0] += 1
                    retained  = prop.get("retained", True)
                    prop_format = prop.get("format", "")
                    # numeric (physical-measurement) properties should carry a
                    # Homie `unit`. An ABSENT unit key is flagged as likely-forgotten;
                    # use `unit: ""` to declare a genuinely dimensionless value (count,
                    # ratio, power factor) and silence the warning.
                    if prop["datatype"] in ("float", "integer") and "unit" not in prop:
                        print(f"  WARNING: numeric property '{effective_node_id}/{prop_id}' has no "
                              f"'unit' — add one, or 'unit: \"\"' if intentionally dimensionless",
                              file=sys.stderr)
                    prop_static_decls.append(f"static Property {prop_var};")
                    args_str  = f'"{prop_id}", "{prop["name"]}", "{prop["datatype"]}", "{unit}"'
                    # Trailing args are positional: emit settable/retained if either is
                    # non-default OR a format follows (format is the 8th arg). (C2)
                    if settable or not retained or prop_format:
                        args_str += f', {str(settable).lower()}, {str(retained).lower()}'
                        if prop_format:
                            args_str += f', "{prop_format}"'
                    prop_reg_body.append(f'        _node->addProperty(&{prop_var}, {args_str});')
                    # $target support is a device behavior, not a $description field, so
                    # set it on the Property directly rather than via addProperty args (C5).
                    if prop.get("supports_target"):
                        prop_reg_body.append(f'        {prop_var}.setSupportsTarget(true);')
                prop_reg_body.append('    }')

    def emit_device(dev_cfg, dev_access, dev_addr, runtime_id_expr, is_root, dev_id, dev_label):
        # Emit this device's nodes, then recurse into nested child devices. dev_id is the
        # runtime id runtime_id_expr evaluates to on the device.
        nodes_list = dev_cfg.get("nodes") or []
        if not isinstance(nodes_list, list):
            print(f"ERROR: device.yml nodes: value isn't a list (got "
                  f"{type(nodes_list).__name__}: {nodes_list!r}) — expected a list of "
                  f"'- component: ...' entries", file=sys.stderr)
            sys.exit(1)
        for entry in nodes_list:
            emit_node(entry, dev_access, None if is_root else dev_addr, is_root, dev_id,
                      dev_label)
        children_list = dev_cfg.get("children") or []
        if not isinstance(children_list, list):
            print(f"ERROR: device.yml children: value isn't a list (got "
                  f"{type(children_list).__name__}: {children_list!r}) — expected a list "
                  f"of child device entries", file=sys.stderr)
            sys.exit(1)
        for child in children_list:
            if not isinstance(child, dict) or "id" not in child:
                print(f"ERROR: device.yml child device entry missing required 'id' field "
                      f"(got {child!r})", file=sys.stderr)
                sys.exit(1)
            cid    = child["id"]                 # suffix; runtime id = <parent>-<cid>
            if _cvar(cid) in seen_child_ids:
                print(f"ERROR: child device ids '{seen_child_ids[_cvar(cid)]}' and '{cid}' "
                      f"collide (the same id, or ids that become the same C++ name). Every "
                      f"child device needs a unique id.", file=sys.stderr)
                sys.exit(1)
            seen_child_ids[_cvar(cid)] = cid
            cvar   = "dev_" + _cvar(cid)
            cidbuf = "childId_" + _cvar(cid)
            cname  = child.get("name", cid)
            ctype  = child.get("type", "generic")
            # The generated snprintf below joins the parent's runtime id and the child id
            # as written; Device::setId() keeps HOMIE_DEVICE_ID_MAX of it.
            child_id = f"{dev_id}-{cid}"
            child_label = f"child '{cid}'"
            id_limits.check_id("device", child_id, "HOMIE_DEVICE_ID_MAX",
                               f" ({child_label}: parent id + '-' + child id)")
            child_dev_decls.append(f"static Device {cvar};")
            prop_reg_body.append("")
            prop_reg_body.append(f"    // nested child device: {cid}")
            prop_reg_body.append(f"    char {cidbuf}[HOMIE_DEVICE_ID_MAX + 1];")
            prop_reg_body.append(f'    snprintf({cidbuf}, sizeof({cidbuf}), "%s-{cid}", {runtime_id_expr});')
            prop_reg_body.append(f'    {cvar}.init("{cname}", {cidbuf}, "{ctype}", {dev_access}mqttClient());')
            prop_reg_body.append(f"    {dev_access}addChild(&{cvar});")
            emit_device(child, f"{cvar}.", f"&{cvar}", cidbuf, False, child_id, child_label)

    # homie_role decides what this build IS. A device publishes nodes; a controller (Homie's
    # other role — it discovers devices and commands them over /set) publishes no nodes of
    # its own and instead runs the top-level links: list, each a logic/link whose ends are
    # both on other devices. Local links stay logic/link NODES in a device build, so each
    # thing has one way to be written.
    #
    # links: is OPTIONAL for both roles. A device never has one; a controller without one
    # still builds and runs, it just discovers devices without driving any.
    role = (device.get("homie_role") or "device").strip()
    links_cfg = cfg.get("links") or []
    # links: is top-level only. Indented under another section it parses as that
    # section's key and would be ignored without a word — the controller then runs with
    # no links and nothing says why.
    for section, body in cfg.items():
        if isinstance(body, dict) and "links" in body:
            print(f"ERROR: device.yml has links: inside the {section}: section — it must be "
                  f"top-level (no indentation before 'links:')", file=sys.stderr)
            sys.exit(1)
    if role not in ("device", "controller"):
        print(f"ERROR: device.homie_role must be 'device' or 'controller' (got {role!r})",
              file=sys.stderr)
        sys.exit(1)
    if not isinstance(links_cfg, list):
        print(f"ERROR: device.yml links: must be a list of link entries (got "
              f"{type(links_cfg).__name__})", file=sys.stderr)
        sys.exit(1)
    if role == "device" and links_cfg:
        print("ERROR: device.yml has a top-level links: list, which only a controller runs "
              "(homie_role: controller). In a device build, declare each link as a node:\n"
              "         - component: logic/link   (see doc/Link.md)", file=sys.stderr)
        sys.exit(1)
    if role == "controller":
        if nodes_cfg or cfg.get("children"):
            print("ERROR: homie_role: controller publishes no nodes of its own — remove "
                  "nodes:/children:, or set homie_role: device.\n"
                  "       A controller's work goes under a top-level links: list, with both "
                  "ends on other devices\n"
                  "       (<device-id>/<node>/<property>) — see doc/Controller.md#controller-links.",
                  file=sys.stderr)
            sys.exit(1)
        if not links_cfg:
            # Not an error: links: is optional. Said once so a controller that drives
            # nothing is a choice rather than a surprise.
            print("  NOTE: homie_role: controller with no links: — it will discover devices "
                  "but drive none")
        for link in links_cfg:
            if not isinstance(link, dict) or not link.get("id"):
                print(f"ERROR: device.yml links: entry needs at least an id (got {link!r})",
                      file=sys.stderr)
                sys.exit(1)
            # Same component, same constructor and defaults as a logic/link node. is_root
            # is False so links stay out of data/homie.yml — a controller publishes no nodes.
            entry = {"component": "logic/link", "id": link["id"],
                     "config": {k: v for k, v in link.items() if k != "id"}}
            emit_node(entry, "device->", None, False, root_id, "controller link")
    else:
        emit_device(cfg, "device->", "device", "device->getId()", True, root_id, "root device")
    check_gpio_conflicts(pin_uses)
    check_link_refs(link_entries, role == "controller", root_id, id_limits.limits)
    if role == "device":
        check_shared_remote_sources(link_entries)
    id_limits.exit_if_any("${chip_id" in (id_template or "${chip_id}"))

    # A device.yml with no nodes: (and no children:) describes a device whose code the
    # project writes by hand in its src/, so no homie.cpp is generated.
    hand_coded = role == "device" and "nodes" not in cfg and not cfg.get("children")
    if hand_coded and not (PROJECT_DIR / "src").is_dir():
        print(f"ERROR: {shown(device_yml)} has no nodes:, so the device code is hand-written, "
              f"but {shown(PROJECT_DIR / 'src')} does not exist.\n"
              f"       Add nodes: to generate the device, or write it in src/ "
              f"(see doc/HandCodedDevice.md).", file=sys.stderr)
        sys.exit(1)
    for comp in project_components():
        if comp not in used_components:
            used_components.append(comp)
            gen = load_yaml_file(LIB_DIR / f"{comp}.yml").get("generator") or {}
            for dep in gen.get("lib_deps") or []:
                if dep not in used_lib_deps:
                    used_lib_deps.append(dep)

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    (OUT_DIR / ".gitignore").write_text("# Build output of ebus-esp32; regenerated on every build.\n*\n",
                                        encoding="utf-8")
    stage_sources()
    stage_data()

    # .ebus/src/homie.cpp
    lines = [_HOMIE_CPP_HEADER]
    lines.append("#include <homie/Device.h>")
    lines.append("#include <homie/Property.h>")
    lines.append("")
    if includes:
        lines += list(dict.fromkeys(includes)) + [""]   # dedupe (same component in root + child)
    if decls:
        lines += decls + [""]
    if child_dev_decls:
        lines += ["// Nested child Device objects (Homie 5 parent/child)"] + child_dev_decls + [""]
    if prop_static_decls:
        lines += ["// Static Homie Property objects — one per node property"] + prop_static_decls + [""]
    lines += ["void register_homie_properties(Device* device) {"]
    if prop_reg_body:
        lines.append("    Node* _node;")
        lines += prop_reg_body
    lines += ["}"]
    # A device build's link registers one table entry per remote source; a controller
    # build's links read the discovery cache and register none.
    link_watches = count_remote_sources(link_entries) if role == "device" else 0
    capacity = settable_table_capacity(settable_count[0], link_watches)
    watches_text = (f"+ {link_watches} link source watch{'' if link_watches == 1 else 'es'} "
                    if link_watches else "")
    lines += ["", f"// {settable_count[0]} settable propert{'y' if settable_count[0] == 1 else 'ies'} "
                  f"{watches_text}"
                  f"+ {_SETTABLE_TABLE_WATCHES} $state watch + {_SETTABLE_TABLE_MARGIN} spare "
                  f"(at least {_SETTABLE_TABLE_FLOOR})",
              "uint16_t settable_table_capacity() {",
              f"    return {capacity};",
              "}"]
    # A controller build's objects are its links: main.cpp's controller path drives them
    # through these. Both pairs are always emitted, empty when unused, so either path links.
    if role == "controller":
        node_setups, node_loops, link_setups, link_loops = [], [], setups, loops
    else:
        node_setups, node_loops, link_setups, link_loops = setups, loops, [], []
    lines += ["", "void setup_homie() {"] + (node_setups or ["    // no nodes configured"]) + ["}"]
    lines += ["", "void loop_homie() {"] + (node_loops or ["    // no nodes configured"]) + ["}"]
    lines += ["", "void setup_controller_links() {"] + (link_setups or ["    // no controller links"]) + ["}"]
    lines += ["", "void loop_controller_links() {"] + (link_loops or ["    // no controller links"]) + ["}", ""]

    out_cpp = GEN_SRC_DIR / "homie.cpp"
    if hand_coded:
        if out_cpp.exists():
            out_cpp.unlink()
        print(f"  hand-coded: the device code is in {shown(PROJECT_DIR / 'src')}")
    else:
        out_cpp.write_text("\n".join(lines), encoding="utf-8")
        print(f"  generated: {shown(out_cpp)}")

    # .ebus/platformio.ini — a lean, standalone PlatformIO project config: the
    # active environment copied from platformio.ini, with [common].lib_deps pruned
    # of any library that's in some component's lib_deps catalog but wasn't actually
    # needed this build, then extended with what device.yml's components DO need.
    # This is what actually keeps e.g. EspSoftwareSerial out of non-modbus builds —
    # see write_lean_platformio_ini().
    env_for_ini = device.get("environment")
    if env_for_ini:
        write_lean_platformio_ini(env_for_ini, used_lib_deps, used_components,
                                  controller=(role == "controller"), device_yml=device_yml)

    # data/homie.yml
    homie_doc = {
        "homie":          "5.0.1",
        "name":           device.get("name", "Homie Device"),
        "type":           device.get("type", "generic"),
        "state":          "init",
        "nodes":          homie_nodes,
        "extensions":     [],
        "implementation": "homie-esp32-firmware",
    }
    out_homie = GEN_DATA_DIR / "homie.yml"
    with open(out_homie, "w", encoding="utf-8") as f:
        yaml.dump(homie_doc, f, allow_unicode=True, sort_keys=False)
    print(f"  generated: {shown(out_homie)}")

    # data/config.yml
    wifi     = cfg.get("wifi")  or {}
    mqtt_cfg = cfg.get("mqtt")  or {}
    # device.id is a runtime TEMPLATE (e.g. ${chip_id}, bess-${chip_id}); resolved
    # on-device. ${...} needs no YAML quoting. Guard against the legacy {{...}}/{...}
    # forms, which YAML parses as a mapping instead of a string.
    device_id_tmpl = device.get("id")
    if device_id_tmpl is not None and not isinstance(device_id_tmpl, str):
        print(f"ERROR: device.id must be a string template using ${{...}}, e.g. id: ${{chip_id}} "
              f"(got {device_id_tmpl!r} — a bare {{...}} is parsed as YAML, not a string; use $)",
              file=sys.stderr)
        sys.exit(1)
    # config.yml mirrors device.yml's SECTIONS (device/wifi/mqtt/log/mdns) key-for-key, so
    # there is exactly one vocabulary a human ever types: device.yml, config-overlay.yml and
    # the generated file all look the same. (The flat wifi_ssid/mqtt_host form this replaced
    # meant an overlay written in device.yml's shape merged in as dead nested keys that the
    # firmware never read — silently, since every key was "valid".) The firmware still
    # accepts the flat form as a fallback; see loadPlatformConfiguration() in config.cpp.
    config_doc = {
        "device": {
            "id":                device_id_tmpl                  or "",   # template (see above)
            # Optional deployment-scoped segment prepended to the resolved id at boot
            # ("lab1" -> lab1-ebus-a1b2c3d4e5f6). Empty = no prefix. Typically set from
            # config-overlay.yml so a site can namespace a fleet without editing device.yml.
            "id_prefix":         device.get("id_prefix")         or "",
            "name":              device.get("name")              or "",
            # device.yml carries BOTH `type:` (Homie $type) and `device_type:`; the latter
            # wins, exactly as it did in the flat form. Emitted under its device.yml name so
            # an overlay section can be pasted straight across.
            "device_type":       device.get("device_type") or device.get("type") or "",
            "firmware_name":     device.get("firmware_name")     or "",
            "firmware_version":  device.get("firmware_version")  or "",
            "firmware_url":      device.get("firmware_url")      or "",
            "fs_url":            device.get("fs_url")            or "",
            "manufacturer":      device.get("manufacturer")      or "",
            "model":             device.get("model")             or "",
            "serial_number":     device.get("serial_number")     or "",
            "homie_role":        device.get("homie_role")        or "device",
            "device_passphrase": device.get("device_passphrase") or "",
        },
        "wifi": {
            "ssid":     wifi.get("ssid")     or "",
            "password": wifi.get("password") or "",
        },
        "mqtt": {
            "mode":     mqtt_cfg.get("mode") or "configured-only",
            "host":     mqtt_cfg.get("host") or "",
            "port":     mqtt_cfg.get("port") or 1883,
            "qos":      mqtt_cfg.get("qos") if mqtt_cfg.get("qos") is not None else 2,
            "username": mqtt_cfg.get("username") or "",
            "password": mqtt_cfg.get("password") or "",
            # Broker service types the mDNS querier browses, in priority order.
            "discover": broker_discovery,
        },
        "log": {
            # Serial-over-TCP console port (device.yml: log.tcp_port); 0 disables.
            "tcp_port": get_log_port(cfg),
        },
    }
    # mdns.* and wifi.enabled are TRI-STATE. Emitting them unconditionally would defeat the
    # firmware's build-conditional defaults (see config.cpp), because
    # loadPlatformConfiguration() applies a key whenever it is present. So a key is written
    # only when device.yml sets it; a present key, true OR false, always wins at runtime.
    # Types are checked once config-overlay.yml is merged in (_check_network_keys).
    mdns_cfg = cfg.get("mdns") or {}
    mdns_out = {k: mdns_cfg[k] for k in MDNS_KEYS if mdns_cfg.get(k) is not None}
    if mdns_out:
        config_doc["mdns"] = mdns_out
    if wifi.get("enabled") is not None:
        config_doc["wifi"]["enabled"] = wifi["enabled"]

    out_config = GEN_DATA_DIR / "config.yml"
    with open(out_config, "w", encoding="utf-8") as f:
        yaml.dump(config_doc, f, allow_unicode=True, sort_keys=False)
    print(f"  generated: {shown(out_config)}")
    _apply_overlay(out_config)
    _check_broker_discovery(out_config)
    _check_network_keys(out_config, device.get("environment"))
    _warn_no_broker(out_config)

    env_name = device.get("environment", "<environment>")
    if role == "controller":
        print(f"\ncontroller: {len(links_cfg)} link(s), environment: {env_name}")
    elif hand_coded:
        print(f"\nhand-coded device, environment: {env_name}")
    else:
        print(f"\n{len(nodes_cfg)} node(s), environment: {env_name}")

# ── build ──────────────────────────────────────────────────────────────────────

def cmd_build(args) -> None:
    # Explicit generate here (unlike the device code and data/*.yml, which the PlatformIO
    # pre-build hook also regenerates during `pio run` itself): .ebus/platformio.ini
    # must exist and be current BEFORE pio starts parsing config — that parsing
    # happens before the pre: hook ever runs, so regenerating from inside it would
    # be one run too late for -c to pick up.
    cmd_generate(args)
    cfg   = load_device_yml(Path(args.device_yml))
    env_name = get_environment(cfg)
    print(f"--- build (env: {env_name}) ---\n")
    rc = pio_run(env_name, [])
    if rc != 0:
        print(f"\nBUILD FAILED (exit {rc})", file=sys.stderr)
        sys.exit(rc)

    # The filesystem image is part of what a build produces, not an upload-time
    # side effect. It used to be built only on the way to flashing (`run`, and the
    # USB half of `push`), which made `push --ota` a lie: it documents itself as
    # flashing pre-built firmware AND filesystem, but nothing had ever produced the
    # filesystem for it to flash. Building it here is what makes that contract true.
    # It is also cheap — mklittlefs packing data/, no compilation.
    rc = pio_run(env_name, ["buildfs"])
    if rc != 0:
        print(f"\nFILESYSTEM BUILD FAILED (exit {rc})", file=sys.stderr)
        sys.exit(rc)

    build_dir = PIO_BUILD_DIR / env_name
    for label, path in (("firmware", build_dir / "firmware.bin"),
                        ("filesystem", build_dir / "littlefs.bin")):
        if path.exists():
            print(f"\n{label}: {path}  ({path.stat().st_size / 1024:.1f} KB)")
    # `build` does not flash, so this attaches to whatever the device is already
    # running — useful for watching a live board while iterating on a build.
    post_monitor(cfg, args)

# ── run / push ─────────────────────────────────────────────────────────────────

def _upload(cfg, args, build: bool) -> None:
    port  = getattr(args, "port", None)

    # --ota replaces the USB upload entirely: no serial port, so none of the serial
    # port handoff below applies. ota_push() only transports whatever images already
    # sit in .pio/build/<board>/ — unlike the USB path, where `upload` and `buildfs`
    # compile as a side effect of flashing — so `run --ota` has to compile explicitly
    # first. `push --ota` deliberately does not: push means "flash what build made",
    # and cmd_build now produces the filesystem image as well as the firmware, so
    # there is something for it to flash. ota_push() checks both are present.
    target = _ota_target(cfg, args)
    if target:
        if build:
            env_name = get_environment(cfg)
            print(f"\n--- build (env: {env_name}) ---")
            if not args.fs_only:
                rc = pio_run(env_name, [])
                if rc != 0:
                    print(f"\nBUILD FAILED (exit {rc})", file=sys.stderr)
                    sys.exit(rc)
            rc = pio_run(env_name, ["buildfs"])
            if rc != 0:
                print(f"\nFilesystem build FAILED (exit {rc})", file=sys.stderr)
                sys.exit(rc)
        if getattr(args, "pull", False):
            ota_pull(cfg, args, *target)
        else:
            ota_push(cfg, args, *target)
        return

    if not cfg:
        print(f"ERROR: no project at {shown(args.device_yml)}. A USB flash goes through the "
              f"project's PlatformIO build;\n       firmware built elsewhere goes over the "
              f"network: push --ota --host <ip> --firmware <file> [--filesystem <file>]",
              file=sys.stderr)
        sys.exit(1)
    env_name = get_environment(cfg)

    # Pause a serial monitor holding the port (no-op if none is running); it resumes
    # when the upload ends, whether it succeeded or not.
    try:
        handoff = serial_handoff.flash_handoff(RUN_DIR, port).start()
    except serial_handoff.HandoffError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
    try:
        # Optional full chip erase first. Use when the board boots stale firmware
        # after a flash (the OTA partition scheme has two app slots; a confused
        # otadata can boot the wrong one). Erase resets otadata to a clean slate.
        if getattr(args, "erase", False):
            print(f"\n--- erasing flash (env: {env_name}) ---")
            rc = pio_run(env_name, ["erase"], port)
            if rc != 0:
                print(f"\nErase FAILED (exit {rc})", file=sys.stderr)
                sys.exit(rc)

        # NOTE: firmware and filesystem are uploaded in SEPARATE `pio run`
        # invocations, never combined as `pio run -t upload -t buildfs -t uploadfs`.
        # On this board's dual-OTA partition layout, the combined form can leave
        # otadata pointing at the previous app slot, so the device boots stale
        # firmware even though the flash "verifies". Keep these two calls separate.
        if not args.fs_only:
            label = "build + upload firmware" if build else "upload firmware"
            print(f"\n--- {label} (env: {env_name}) ---")
            rc = pio_run(env_name, ["upload"], port)
            if rc != 0:
                print(f"\nFirmware upload FAILED (exit {rc})", file=sys.stderr)
                sys.exit(rc)
            bin_path = PIO_BUILD_DIR / env_name / "firmware.bin"
            if bin_path.exists():
                print(f"flashed: {bin_path}  ({bin_path.stat().st_size / 1024:.1f} KB)")

        print(f"\n--- uploading filesystem (env: {env_name}) ---")
        rc = pio_run(env_name, ["buildfs", "uploadfs"], port)
        if rc != 0:
            print(f"\nFilesystem upload FAILED (exit {rc})", file=sys.stderr)
            sys.exit(rc)

        print("\ndone.")
    finally:
        handoff.finish()

# ── OTA push over TCP ──────────────────────────────────────────────────────────
#
# Flash a board that has no reachable USB cable, by POSTing the built images to the
# portal's OTA endpoints (see the "OTA image push" block in captive_portal.cpp).
#
# Order matters: the filesystem goes first with ?reboot=0, then the firmware with the
# reboot, so both land in a single session and the board restarts once at the end.

OTA_CHUNK = 4096
# Once the whole image is sent, the device only has to write the last chunk and verify
# the image before replying. Waiting the full upload timeout for that only delays the
# reply-lost handling in _ota_push_image().
OTA_REPLY_TIMEOUT = 20
# How long a board gets to reboot and rejoin the network (DHCP alone takes ~30 s on
# some LANs).
OTA_COMEBACK_TIMEOUT = 120
# After a lost reply, how long the device may keep answering without proving a restart
# before _ota_wait_reboot() stops waiting for one.
OTA_STAYED_UP_LIMIT = 15

# The portal's REST base path. Firmware older than the /api/v1 paths serves the same
# routes under /api only, and current firmware answers both, so a client that finds
# /api/v1 missing falls back to /api (see _api_base and _ota_status).
API_V1     = "/api/v1"
API_LEGACY = "/api"

def _api_missing(status) -> bool:
    """True when a reply to an /api/v1 path says the firmware predates it: 404 from an
    Ethernet build, a redirect from a setup-AP build's catch-all."""
    return status is not None and (status == 404 or 300 <= status < 400)

def _ota_unreachable(host: str, detail: str, unresolved: bool = False) -> None:
    """Exit with something actionable instead of a socket traceback. Every OTA call
    goes through _ota_request(), so this is the one place a network failure surfaces."""
    print(f"\nERROR: cannot reach {host} — {detail}", file=sys.stderr)
    if unresolved and host.split(":")[0].endswith(".local"):
        print( "       A device's .local name is its Device ID (printed at boot), e.g.\n"
               "       b0b21c90f570.local, not device.name. -arduino2 builds claim it only\n"
               "       when device.yml turns on an mdns gate.",
              file=sys.stderr)
    # Only worth saying when they did not already give one.
    bare = host.split(":")[0]
    if not re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", bare):
        print( "       Try an IP instead: ebus-esp32 push --ota --host <ip>", file=sys.stderr)
    cached = _hosts_load()
    learned = [f"{d}={e.get('host')}" for d, e in sorted(cached["devices"].items())]
    learned += [f"{k}={e.get('host')}" for k, e in sorted(cached["ymls"].items()) if e.get("host")]
    learned += [f"{env}={addr}" for env, addr in sorted(cached["environments"].items())]
    if learned:
        print(f"       Addresses learned from earlier serial sessions: {', '.join(learned)}",
              file=sys.stderr)
    sys.exit(1)

def _ota_request(host: str, path: str, passphrase: str, payload: bytes,
                 content_type: str, label: str, timeout: int = 120,
                 reply_lost_ok: bool = False):
    """POST payload with pre-emptive Basic auth. Returns (status, body_text).

    With reply_lost_ok, a failure while waiting for the reply AFTER the whole payload
    was sent returns (None, detail) instead of exiting, so the caller can check whether
    the device acted on it anyway.

    Pre-emptive matters: urllib's auth handler waits for a 401 and then RETRIES, which
    for a 1.3MB image means uploading it twice. Sending Authorization up front makes
    it one pass. Content-Length is set explicitly for the same reason chunked encoding
    is avoided — the device sizes Update.begin() from it and rejects a zero.
    """
    auth = base64.b64encode(f"admin:{passphrase}".encode()).decode()
    # No explicit port: HTTPConnection parses "host:port" when given one and defaults
    # to 80 otherwise, so --host accepts either form.
    conn = http.client.HTTPConnection(host, timeout=timeout)
    waited = timeout
    body_sent = False
    try:
        conn.putrequest("POST", path, skip_accept_encoding=True)
        conn.putheader("Authorization", "Basic " + auth)
        conn.putheader("Content-Type", content_type)
        conn.putheader("Content-Length", str(len(payload)))
        conn.endheaders()
        total = len(payload)
        sent  = 0
        last  = -1
        # A control request (enable OTA, a pull URL) is a few dozen bytes — a progress
        # meter on it is noise. Only an actual image gets one.
        show_progress = total > OTA_CHUNK
        for off in range(0, total, OTA_CHUNK):
            conn.send(payload[off:off + OTA_CHUNK])
            sent += len(payload[off:off + OTA_CHUNK])
            if not show_progress:
                continue
            pct = sent * 100 // total if total else 100
            if pct != last and pct % 5 == 0 and pct < 100:   # 100% printed once, below
                last = pct
                print(f"\r  {label}: {pct:3d}%  ({sent}/{total} bytes)", end="", flush=True)
        if show_progress:
            print(f"\r  {label}: 100%  ({total}/{total} bytes)", flush=True)
        body_sent = True
        if conn.sock is not None and timeout > OTA_REPLY_TIMEOUT:
            waited = OTA_REPLY_TIMEOUT
            conn.sock.settimeout(waited)
        try:
            resp = conn.getresponse()
            return resp.status, resp.read().decode("utf-8", "replace").strip()
        except (OSError, http.client.HTTPException) as e:
            if not reply_lost_ok:
                raise
            if isinstance(e, (TimeoutError, socket.timeout)):
                return None, f"no reply within {waited}s"
            return None, f"{e.__class__.__name__}: {e}"
    # Ordered most specific first — gaierror, ConnectionError and timeout are all
    # OSError subclasses, so the catch-all has to come last.
    except socket.gaierror:
        _ota_unreachable(host, "that name does not resolve", unresolved=True)
    except ConnectionRefusedError:
        _ota_unreachable(host, "connection refused — something is at that address, but "
                               "nothing is listening on the portal's port")
    except (TimeoutError, socket.timeout):
        if body_sent:
            _ota_unreachable(host, f"no reply within {waited}s after the {label} was sent; "
                                   f"its state on the device is unknown")
        _ota_unreachable(host, f"timed out after {waited}s — wrong address, or the board "
                               f"is not on the network")
    except ConnectionResetError:
        _ota_unreachable(host, "connection reset by the device mid-transfer — retry, and "
                               "watch the console (ebus-esp32 monitor --net)")
    except OSError as e:
        _ota_unreachable(host, f"{e.__class__.__name__}: {e}")
    except http.client.HTTPException as e:
        _ota_unreachable(host, f"malformed reply ({e.__class__.__name__}: {e})")
    finally:
        conn.close()

def _ota_wait_back(host: str, timeout: int):
    """Poll GET /api/v1/ota until the device answers. Returns its reply text, or None if
    it did not answer within timeout seconds."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        reply = _ota_status(host, "", timeout=3)
        if reply is not None:
            return reply[1]
        time.sleep(2.0)
    return None

def _ota_uptime(reply_text: str):
    """uptime_s from a GET /api/v1/ota reply, or None when the firmware does not report it."""
    try:
        up = (json.loads(reply_text) or {}).get("uptime_s")
    except (ValueError, AttributeError):
        return None
    return float(up) if isinstance(up, (int, float)) else None

def _ota_wait_reboot(host: str, timeout: int, since: float):
    """After a lost reply, wait for the device to report an uptime shorter than the time
    since `since` (taken before the upload began), which proves it restarted after the
    push started. The device was up before then, so without a restart its uptime is
    always longer. This holds however fast it came back, and a dropped probe proves
    nothing either way.

    Returns ("rebooted", reply), ("stayed_up", reply) when it kept answering for
    OTA_STAYED_UP_LIMIT seconds without proving a restart (a refusal whose reply was
    lost, or firmware that does not report uptime_s), or (None, None) when it did not
    answer within timeout seconds."""
    deadline = time.time() + timeout
    unproven_since = None
    while time.time() < deadline:
        asked = time.time()
        reply = _ota_status(host, "", timeout=3)
        if reply is not None:
            up = _ota_uptime(reply[1])
            if up is not None and up < asked - since:
                return "rebooted", reply[1]
            if unproven_since is None:
                unproven_since = asked
            elif asked - unproven_since >= OTA_STAYED_UP_LIMIT:
                return "stayed_up", reply[1]
        time.sleep(2.0)
    return None, None

def _ota_push_image(host: str, path: str, passphrase: str, image: Path,
                    label: str, reboot: bool) -> None:
    if not image.exists():
        print(f"ERROR: {image} not found — build first (ebus-esp32 build)", file=sys.stderr)
        sys.exit(1)
    url = path if reboot else path + "?reboot=0"
    # A lost reply only has a checkable outcome when the push reboots the board: a
    # staged (?reboot=0) image leaves nothing visible to confirm it by.
    started = time.time()
    status, body = _ota_request(host, url, passphrase, image.read_bytes(),
                                "application/octet-stream", label, reply_lost_ok=reboot)
    if status is None:
        print(f"  {label}: image sent, but the reply was lost ({body}).\n"
              f"  waiting up to {OTA_COMEBACK_TIMEOUT}s for the device to come back...",
              flush=True)
        # The device reboots at most 5 s after replying (captive_portal.cpp); probing
        # sooner could reach the old image before it restarts.
        time.sleep(6)
        outcome, back = _ota_wait_reboot(host, OTA_COMEBACK_TIMEOUT, started)
        console = f"ebus-esp32 monitor --host {host.split(':')[0]}"
        if outcome == "rebooted":
            print(f"  -> reply lost, but the device restarted after the upload began (it\n"
                  f"     reports {back}). It does not report which image it booted; check the\n"
                  f"     version in its Homie $description, or watch the console: {console}")
            return
        if outcome == "stayed_up":
            print(f"\n{label} UNCONFIRMED: the reply was lost and the device keeps answering\n"
                  f"  without reporting an uptime that proves a restart (it reports {back}).\n"
                  f"  It may have refused the image, or be running firmware that does not\n"
                  f"  report uptime_s; check the version in its Homie $description, or watch\n"
                  f"  the console: {console}", file=sys.stderr)
            sys.exit(1)
        print(f"\n{label} FAILED: the reply was lost and the device did not answer again "
              f"within {OTA_COMEBACK_TIMEOUT}s", file=sys.stderr)
        sys.exit(1)
    if status != 200:
        print(f"\n{label} FAILED: HTTP {status} {body}", file=sys.stderr)
        sys.exit(1)
    print(f"  -> {body}")

def _ota_status(host: str, passphrase: str, timeout: int = 10):
    """GET the OTA status, from /api/v1/ota or, on firmware that predates it, /api/ota.
    Asked afresh each time: a push can reboot the board into either kind."""
    reply = _ota_get(host, f"{API_V1}/ota", passphrase, timeout=timeout)
    if reply is not None and _api_missing(reply[0]):
        reply = _ota_get(host, f"{API_LEGACY}/ota", passphrase, timeout=timeout)
    return reply

def _api_base(host: str) -> str:
    """The base path this device serves its REST API under: API_V1, or API_LEGACY when
    it answers GET /api/v1/ota as firmware without the /api/v1 paths does. API_V1 when
    it does not answer at all, so the request that follows reports why."""
    reply = _ota_get(host, f"{API_V1}/ota", "", timeout=10)
    return API_LEGACY if reply is not None and _api_missing(reply[0]) else API_V1

def _ota_get(host: str, path: str, passphrase: str, timeout: int = 10):
    """GET with the same pre-emptive auth as _ota_request(). Returns (status, text), or
    None when the device does not answer: callers poll a board that may be rebooting."""
    auth = base64.b64encode(f"admin:{passphrase}".encode()).decode()
    conn = http.client.HTTPConnection(host, timeout=timeout)
    try:
        conn.putrequest("GET", path, skip_accept_encoding=True)
        conn.putheader("Authorization", "Basic " + auth)
        conn.endheaders()
        resp = conn.getresponse()
        return resp.status, resp.read().decode("utf-8", "replace").strip()
    except (OSError, http.client.HTTPException):
        return None
    finally:
        conn.close()

# ── pull OTA ───────────────────────────────────────────────────────────────────
#
# The push path streams the images INTO the device. Pull is the other direction: the
# device downloads them itself from a URL, which is what works when the device is
# reachable from a server but not from here (NAT, VPN, a fleet behind a gateway).
#
# The firmware already implements it — POST /api/v1/firmware and /api/v1/filesystem take
# {"url": ...}, save it, and queue a download (src/platform/ota.cpp). Two query flags
# make it usable for a one-shot dev push: ?start=0 stages without beginning, so both
# images run as ONE session with a single reboot, and ?persist=0 keeps a throwaway URL
# out of the device's NVS.
#
# --pull requires --url: the CLI never serves the images itself during a pull. To pull
# from this machine on a LAN, run `ebus-esp32 serve` in another terminal and pass its
# address as --url.

def _pull_request(host: str, path: str, passphrase: str, url: str,
                  start: bool, persist: bool, label: str) -> None:
    q = []
    if not start:   q.append("start=0")
    if not persist: q.append("persist=0")
    full = path + ("?" + "&".join(q) if q else "")
    body = json.dumps({"url": url}).encode()
    status, text = _ota_request(host, full, passphrase, body, "application/json",
                                label, timeout=15)
    if status != 200:
        print(f"\n{label} FAILED: HTTP {status} {text}", file=sys.stderr)
        if status == 401:
            print("  (check device.device_passphrase in config-overlay.yml or device.yml, "
                  "or pass --passphrase)", file=sys.stderr)
        sys.exit(1)
    print(f"  -> {label}: {url}")

# Terminal states from ota_get_status_str() in src/platform/ota.cpp.
_PULL_ERRORS = {
    "host_not_found": "the device could not reach the URL's host",
    "file_not_found": "the server answered 404 — wrong path?",
    "http_error":     "the server answered with an error",
    "write_error":    "the device could not write the image (bad image, or no space)",
    "download_incomplete": "the download stopped before the whole image arrived",
}

def _pull_watch(host: str, passphrase: str, timeout: int) -> int:
    """Poll /api/v1/ota until the device reports complete or an error. Returns a process rc.

    The device holds "complete" for 3 s before rebooting (ota_loop() in ota.cpp), so a
    once-a-second poll sees it. Losing contact before that is NOT success: a crash or a
    network drop looks the same from here as a reboot into the new image."""
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        reply = _ota_status(host, passphrase, timeout=5)
        if reply is None:
            print(f"  device stopped answering before reporting completion; waiting up to "
                  f"{OTA_COMEBACK_TIMEOUT}s for it to come back...", flush=True)
            back = _ota_wait_back(host, OTA_COMEBACK_TIMEOUT)
            if back is None:
                print(f"\nOTA pull FAILED: lost contact with the device and it did not "
                      f"answer again within {OTA_COMEBACK_TIMEOUT}s", file=sys.stderr)
            else:
                print(f"\nOTA pull UNCONFIRMED: the device answers again (it reports {back})\n"
                      f"  but never reported completion. Older firmware can reboot before a\n"
                      f"  poll sees it, so the update may have landed; check the version in\n"
                      f"  its Homie $description, or watch the console:\n"
                      f"  ebus-esp32 monitor --host {host.split(':')[0]}", file=sys.stderr)
            return 1
        status, text = reply
        state = ""
        try:
            doc = json.loads(text)
            state = doc.get("status", "") if isinstance(doc, dict) else ""
        except ValueError:
            state = text
        if state != last:
            print(f"  device: {state}")
            last = state
        if state == "complete":
            return 0
        if state in _PULL_ERRORS:
            print(f"\nOTA pull FAILED: {_PULL_ERRORS[state]}\n  device reported: {text}",
                  file=sys.stderr)
            return 1
        time.sleep(1.0)
    print(f"\nGave up after {timeout}s — the device never reported completion.\n"
          f"  Watch it directly: ebus-esp32 monitor --host {host.split(':')[0]}",
          file=sys.stderr)
    return 1

def _fs_inputs_mtime(device_yml) -> float:
    """Newest modification time among the files a filesystem image is packed from: the
    repo's data/, the project's data/, device.yml and the overlay."""
    inputs = [q for d in (DATA_DIR, PROJECT_DIR / "data") if d.is_dir()
              for q in d.rglob("*") if q.is_file()]
    inputs += [q for q in (Path(device_yml), CONFIG_OVERLAY) if q.exists()]
    return max((q.stat().st_mtime for q in inputs), default=0)

def _ota_passphrase(cfg: dict, args) -> str:
    passphrase = getattr(args, "passphrase", None) or _configured_passphrase(cfg)
    if not passphrase:
        print("ERROR: no device_passphrase in config-overlay.yml or device.yml "
              "(and no --passphrase given).\n"
              "       The OTA endpoints require it.", file=sys.stderr)
        sys.exit(1)
    return passphrase

def _push_images(cfg: dict, args):
    """(filesystem, firmware, explicit): the images a push sends, each a Path or None.
    --filesystem and --firmware name them; otherwise they are the project's build output."""
    fw_arg, fs_arg = getattr(args, "firmware", None), getattr(args, "filesystem", None)
    if fw_arg or fs_arg:
        if fw_arg and args.fs_only:
            print("ERROR: --fs-only and --firmware contradict each other", file=sys.stderr)
            sys.exit(2)
        return (Path(fs_arg) if fs_arg else None, Path(fw_arg) if fw_arg else None, True)
    if not cfg:
        print(f"ERROR: no project at {shown(args.device_yml)}. Name one, or pass the images: "
              f"--firmware <file> and/or --filesystem <file>", file=sys.stderr)
        sys.exit(1)
    build_dir = PIO_BUILD_DIR / get_environment(cfg)
    return (build_dir / "littlefs.bin",
            None if args.fs_only else build_dir / "firmware.bin", False)

def _require_images(images: list, explicit: bool) -> None:
    """A push moves images that are already on disk, so check they exist before opening
    an OTA window on the device. images: (label, path) pairs."""
    missing = [(label, path) for label, path in images if not path.exists()]
    if missing:
        for label, path in missing:
            print(f"ERROR: no {label} image at {shown(path)}", file=sys.stderr)
        if not explicit:
            print("       push flashes pre-built images — run 'ebus-esp32 build' first\n"
                  "       (or use 'ebus-esp32 run --ota', which builds then pushes).",
                  file=sys.stderr)
        sys.exit(1)

def ota_pull(cfg: dict, args, host: str, source: str) -> None:
    """Point the device at an image server and watch it download. The server is yours —
    `ebus-esp32 serve` runs one over the build directory for development."""
    env_name   = environment_or_none(cfg) or "none"
    passphrase = _ota_passphrase(cfg, args)

    base = (getattr(args, "url", None) or "").rstrip("/")
    if not base:
        print("ERROR: --pull needs --url <base>, the server the DEVICE downloads from.\n"
              "       e.g. --url https://releases.example.com/ebus/v1.2\n"
              "       To serve this build for development: ebus-esp32 serve",
              file=sys.stderr)
        sys.exit(1)

    print(f"\n--- OTA pull from {base} ---")
    print(f"    device {host} (host {source}, env {env_name})")
    api = _api_base(host)

    # Filesystem staged first, firmware last and it arms both — so one download session,
    # one reboot, and the firmware is what the device comes up on.
    if not args.fs_only:
        _pull_request(host, f"{api}/filesystem", passphrase, f"{base}/littlefs.bin",
                      start=False, persist=False, label="stage filesystem")
        _pull_request(host, f"{api}/firmware", passphrase, f"{base}/firmware.bin",
                      start=True, persist=False, label="start firmware")
    else:
        _pull_request(host, f"{api}/filesystem", passphrase, f"{base}/littlefs.bin",
                      start=True, persist=False, label="start filesystem")
    rc = _pull_watch(host, passphrase, getattr(args, "pull_wait", 300))
    if rc != 0:
        sys.exit(rc)

# ── serve ──────────────────────────────────────────────────────────────────────
#
# An image server over the build directory, for driving a pull from the device's own
# captive portal: run this, open the portal, paste the printed URL into the firmware or
# filesystem field. Also what `push --pull --url` points at during development.
#
# It serves exactly two paths — firmware.bin and littlefs.bin — rather than the build
# directory as a whole, which also holds the ELF, the map and every object file. A
# development convenience should not put the symbol table on the LAN.

class _ImageRequestHandler(http.server.BaseHTTPRequestHandler):
    images: dict = {}          # url path -> Path, set per-server below
    server_version = "ebus-esp32"
    sys_version = ""

    def log_message(self, fmt, *a):
        print(f"  {self.address_string()}  {fmt % a}", flush=True)

    def _send(self, code: int, body: bytes = b"", ctype: str = "text/plain"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/":
            listing = "".join(f"{n}  {p.stat().st_size} bytes\n"
                              for n, p in sorted(self.images.items()))
            self._send(200, listing.encode())
            return
        image = self.images.get(path.lstrip("/"))
        if image is None or not image.exists():
            self._send(404, "not found - this server offers only the images listed "
                                 "at /\n".encode())
            return
        data = image.read_bytes()
        # Content-Length is what the device sizes Update.begin() from, so it has to be
        # exact and the body cannot be chunked or compressed.
        self._send(200, data, "application/octet-stream")

def _outbound_ip() -> str:
    """This machine's address on the interface with the default route. Connecting a UDP
    socket picks it from the routing table without sending anything — more reliable than
    gethostbyname(gethostname()), which yields 127.0.0.1 as often as not on macOS."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()

def cmd_serve(args) -> None:
    cfg = load_device_yml_if_present(args.device_yml)
    if args.firmware or args.filesystem:
        # Served under the names push --pull asks for, whatever the files are called.
        images = {name: Path(arg) for name, arg in (("firmware.bin", args.firmware),
                                                    ("littlefs.bin", args.filesystem)) if arg}
        for name, path in images.items():
            if not path.is_file():
                print(f"ERROR: no image at {shown(path)}", file=sys.stderr)
                sys.exit(1)
        label = ", ".join(shown(p) for p in images.values())
        present = images
    else:
        if not cfg:
            print(f"ERROR: no project at {shown(args.device_yml)}. Name one, or pass the "
                  f"images: --firmware <file> and/or --filesystem <file>", file=sys.stderr)
            sys.exit(1)
        build_dir = PIO_BUILD_DIR / get_environment(cfg)
        images = {name: build_dir / name for name in ("firmware.bin", "littlefs.bin")}
        present = {n: p for n, p in images.items() if p.exists()}
        if not present:
            print(f"ERROR: no images in {build_dir} — run 'ebus-esp32 build' first",
                  file=sys.stderr)
            sys.exit(1)
        for name in images:
            if name not in present:
                print(f"WARNING: no {name} in {build_dir} — it will 404", file=sys.stderr)
        label = f"{shown(build_dir)} (env {get_environment(cfg)})"

    # Same staleness check `push` makes: a littlefs.bin older than the config it was
    # packed from flashes cleanly and leaves the device running yesterday's data/.
    fs_image = present.get("littlefs.bin")
    if fs_image and not (args.firmware or args.filesystem):
        if _fs_inputs_mtime(args.device_yml) > fs_image.stat().st_mtime:
            print("WARNING: littlefs.bin is older than the config it is packed from — "
                  "run 'ebus-esp32 build' to repack it", file=sys.stderr)

    handler = type("_BoundImageHandler", (_ImageRequestHandler,), {"images": present})
    try:
        httpd = http.server.ThreadingHTTPServer((args.bind, args.port), handler)
    except OSError as e:
        print(f"ERROR: cannot listen on {args.bind}:{args.port} — {e}", file=sys.stderr)
        sys.exit(1)

    scheme = "http"
    if args.cert:
        # https needs the DEVICE to trust this server: put the same cert (or its CA) at
        # data/certs/<Host>.ca and flash the filesystem, or the device downloads
        # unverified and says so in its log. See doc/ESP32OTA.md.
        import ssl
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        try:
            ctx.load_cert_chain(certfile=args.cert, keyfile=args.key or args.cert)
        except (OSError, ssl.SSLError) as e:
            print(f"ERROR: could not load --cert/--key — {e}", file=sys.stderr)
            sys.exit(1)
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
        scheme = "https"

    host = args.url_host or _outbound_ip()
    base = f"{scheme}://{host}:{httpd.server_address[1]}"
    print(f"\n--- serving {label} ---")
    for name, path in sorted(present.items()):
        print(f"  {base}/{name}    ({path.stat().st_size} bytes)")
    print("\nPaste those into the device's portal (Firmware / Filesystem URL), or:")
    print(f"  ebus-esp32 push --pull --url {base} --host <device>")
    print("\nCtrl-C to stop.\n")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        httpd.server_close()

def ota_push(cfg: dict, args, host: str, source: str) -> None:
    passphrase = _ota_passphrase(cfg, args)
    fs, fw, explicit = _push_images(cfg, args)
    images = [(label, path) for label, path in (("filesystem", fs), ("firmware", fw)) if path]
    _require_images(images, explicit)

    # Staleness matters more than absence here: a littlefs.bin older than the config it
    # was packed from flashes cleanly, reports success, and leaves the device running
    # yesterday's schedule. Its inputs are a known handful of files, so the check is
    # cheap and exact. Firmware staleness is deliberately NOT second-guessed — that
    # would mean stat()ing every source in src/ and lib/ to re-derive what the build
    # system already knows, and `build` is the answer to it.
    if not explicit and _fs_inputs_mtime(args.device_yml) > fs.stat().st_mtime:
        print(f"WARNING: {fs.name} is older than the config it is packed from — the "
              f"device will get stale data/.\n"
              f"         Run 'ebus-esp32 build' to repack it.", file=sys.stderr)

    env_name = environment_or_none(cfg)
    print(f"\n--- OTA push to {host} (host {source}"
          + (f", env {env_name}" if env_name else "") + ") ---")

    # The endpoints are gated on ota_is_enabled(), which is a timed window — open it
    # first or every push comes back "OTA not enabled".
    api = _api_base(host)
    status, body = _ota_request(host, f"{api}/ota", passphrase, b'{"enabled":true}',
                                "application/json", "enable OTA", timeout=15)
    if status != 200:
        print(f"\nCould not enable OTA: HTTP {status} {body}", file=sys.stderr)
        if status == 401:
            print("  (check device.device_passphrase in config-overlay.yml or device.yml, "
                  "or pass --passphrase)", file=sys.stderr)
        sys.exit(1)

    # Filesystem first, staged; firmware last and it carries the reboot. A single image
    # reboots itself.
    for i, (label, path) in enumerate(images):
        _ota_push_image(host, f"{api}/ota/{label}", passphrase, path, label,
                        reboot=(i == len(images) - 1))

    print("\ndone — device rebooting.")

def _ota_target(cfg, args):
    """(host, source) when this invocation should flash over the network, else None.
    Covers both network transports: --ota pushes the images, --pull tells the device to
    fetch them."""
    if not (getattr(args, "ota", False) or getattr(args, "pull", False)):
        return None
    host, source = resolve_host(cfg, environment_or_none(cfg), _host_key(cfg, args.device_yml),
                                getattr(args, "host", None), unique=True)
    if not host:
        flag = "--pull" if getattr(args, "pull", False) else "--ota"
        print(f"ERROR: {flag} given but no device address is known.", file=sys.stderr)
        print("       Pass --host <ip>, or learn it once over USB: ebus-esp32 monitor --serial",
              file=sys.stderr)
        sys.exit(1)
    return host, source

def cmd_run(args) -> None:
    # Explicit generate here — see cmd_build for why .ebus/platformio.ini needs to
    # exist before pio starts, not just via the pre-build hook.
    cmd_generate(args)
    cfg = load_device_yml(Path(args.device_yml))
    _upload(cfg, args, build=True)
    post_monitor(cfg, args)

def cmd_push(args) -> None:
    # No generate here: push is explicitly "flash pre-built artifacts, no rebuild" —
    # it doesn't compile, so .ebus/platformio.ini isn't consulted either way.
    cfg = load_device_yml_if_present(args.device_yml)
    _upload(cfg, args, build=False)
    post_monitor(cfg, args)

# ── monitor ────────────────────────────────────────────────────────────────────
#
# Two transports, one command:
#
#   serial   pio device monitor over USB — the original behavior.
#   network  pio device monitor --port socket://<host>:<log.tcp_port>, reading the
#            firmware's serial-over-TCP console (include/platform/log_stream.h). No
#            extra tooling: pyserial (which pio's monitor uses) speaks socket:// URLs
#            natively, and the device replays its ring buffer to each new client, so
#            the boot log survives connecting late.
#
# Host resolution, in order: --host, then the address learned from a previous serial
# session (cached per device.yml and device.name in build/monitor-hosts.json).
# There is no mDNS browse, and the firmware's hostname is its Device ID, which is not
# known before the first session, so the cache is what makes `--net` work with no
# arguments. `--host <Device ID>.local` names a board directly.
#
# The cache is per board. The serial monitor learns each board's Device ID (printed at
# boot) together with its IP, and stores the address under that id, with the
# device.yml#name key it was seen from; that key also points at the board seen most
# recently from it. Boards flashed from one device.yml (e.g. with `id: ${chip_id}`)
# therefore each keep their own address. When more than one is known for the
# device.yml in use, `push --ota` and `--pull` list them and require --host (an IP or
# a Device ID), while the monitor attaches to the most recent and says so.
# A session that never saw the Device ID line is matched to a board learned from the
# same device.yml at that address; failing that, its address is kept on the
# device.yml key and offered as the newest candidate. Two older formats are still
# read: device.yml#name -> {host, device_id}, and environment -> IP string (said to be
# per-environment, and dropped once that environment learns an address).

# main.cpp prints exactly these once an interface has an IP. Scraping them while a
# serial monitor is already running is how the cache gets populated, at zero cost to
# the user: flash over USB once, and every later `--net` monitor knows the address.
_IP_LEARN_RE = re.compile(r"Network:\s+(?:WiFi STA|Ethernet)\s+IP=(\d{1,3}(?:\.\d{1,3}){3})")
# config.cpp prints the resolved id once at boot, before the network comes up.
_ID_LEARN_RE = re.compile(r"Device ID:\s+(\S+)")

def _host_key(cfg: dict, device_yml) -> str:
    """Cache key for one device: its device.yml (relative to the repo when inside it)
    plus device.name, e.g. 'examples/ssr/device.yml#ssr'."""
    path = Path(device_yml).resolve()
    try:
        path = path.relative_to(ROOT)
    except ValueError:
        pass
    return f"{path.as_posix()}#{(cfg.get('device') or {}).get('name') or ''}"

def _hosts_empty() -> dict:
    return {"version": 2, "devices": {}, "ymls": {}, "environments": {}}

def _hosts_entries(section, want_host: bool) -> dict:
    """The well-formed entries of one cache section: dicts whose host and device_id,
    when present, are strings and whose seen, when present, is a Unix time in
    [0, 2**32). A device entry also needs a host."""
    if not isinstance(section, dict):
        return {}
    good = {}
    for key, val in section.items():
        if not isinstance(val, dict):
            continue
        host, device_id = val.get("host"), val.get("device_id")
        if host is not None and not isinstance(host, str):
            continue
        if device_id is not None and not isinstance(device_id, str):
            continue
        seen = val.get("seen")
        if seen is not None and (isinstance(seen, bool) or not isinstance(seen, (int, float))
                                 or not 0 <= seen < 2**32):
            continue
        if want_host and not host:
            continue
        good[key] = val
    return good

def _hosts_load() -> dict:
    """The cache in its current form (see above), converting both older formats on
    read. A corrupt/missing cache is not an error: the monitor still works with an
    explicit --host. Malformed entries are dropped."""
    try:
        data = json.loads(MONITOR_HOSTS.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = None
    hosts = _hosts_empty()
    if not isinstance(data, dict):
        return hosts
    if data.get("version") == 2:
        hosts["devices"] = _hosts_entries(data.get("devices"), want_host=True)
        hosts["ymls"] = _hosts_entries(data.get("ymls"), want_host=False)
        envs = data.get("environments")
        if isinstance(envs, dict):
            hosts["environments"] = {k: v for k, v in envs.items() if isinstance(v, str)}
        return hosts
    for key, val in data.items():
        if isinstance(val, str):
            hosts["environments"][key] = val          # environment -> IP
        elif isinstance(val, dict) and isinstance(val.get("host"), str) and val["host"]:
            device_id = val.get("device_id")          # device.yml#name -> entry
            if isinstance(device_id, str) and device_id:
                hosts["devices"][device_id] = {"host": val["host"],
                                               "environment": val.get("environment"),
                                               "yml": key, "seen": 0}
                hosts["ymls"][key] = {"device_id": device_id}
            else:
                hosts["ymls"][key] = {"device_id": None, "host": val["host"],
                                      "environment": val.get("environment"), "seen": 0}
    return hosts

def _host_learn(key: str, env_name: str, host: str, device_id: str = None) -> None:
    hosts = _hosts_load()
    devices = hosts["devices"]
    pointer = hosts["ymls"].get(key) or {}
    if device_id is None:
        # This session missed the Device ID line: still a known board if one learned
        # from this device.yml was last seen at this address.
        same = [d for d, e in devices.items() if e.get("yml") == key and e.get("host") == host]
        if pointer.get("device_id") in same:
            device_id = pointer["device_id"]
        elif same:
            device_id = max(same, key=lambda d: devices[d].get("seen") or 0)
    now = int(time.time())
    if device_id:
        entry = {"host": host, "environment": env_name, "yml": key}
        prev = devices.get(device_id) or {}
        changed = any(prev.get(k) != v for k, v in entry.items())
        # One address belongs to one board at a time; a board that held it before has
        # moved, and its entry would only offer a wrong choice.
        for other in [d for d, e in devices.items() if d != device_id and e.get("host") == host]:
            del devices[other]
            changed = True
        entry["seen"] = now
        devices[device_id] = entry
        new_pointer = {"device_id": device_id}
        changed = changed or pointer != new_pointer
    else:
        # An address whose board is unknown. It is the newest thing learned for this
        # device.yml, so resolve_host offers it ahead of the boards learned before.
        new_pointer = {"device_id": None, "host": host, "environment": env_name}
        changed = any(pointer.get(k) != v for k, v in new_pointer.items())
        new_pointer["seen"] = now
    changed = changed or env_name in hosts["environments"]
    hosts["ymls"][key] = new_pointer
    hosts["environments"].pop(env_name, None)
    try:
        BUILD_DIR.mkdir(parents=True, exist_ok=True)
        MONITOR_HOSTS.write_text(json.dumps(hosts, indent=2) + "\n", encoding="utf-8")
    except OSError as e:
        print(f"[ebus] WARNING: could not cache device address: {e}", file=sys.stderr)
        return
    if changed:
        who = f"device {device_id} ({key})" if device_id else f"{key}, device id not seen"
        print(f"\n[ebus] learned address {host} for {who}"
              f"  ->  ebus-esp32 monitor --net\n", flush=True)

def _seen_text(seen) -> str:
    if not seen:
        return "seen by an older CLI"
    return "last seen " + time.strftime("%Y-%m-%d %H:%M", time.localtime(seen))

_UNSEEN_ID = "(device id not seen)"

def resolve_host(cfg: dict, env_name: str, key: str, explicit: str = None,
                 unique: bool = False):
    """(host, source) for the network monitor or OTA, or (None, None) if nothing is
    known. source names where the address came from and, for a cached one, which
    device. --host also accepts a learned Device ID.

    The candidates for this device.yml are the devices learned from it, plus the
    address of the latest session if it missed the Device ID line. When there is more
    than one, they are listed; with unique (push --ota / --pull) that is an error
    asking for --host, otherwise the most recently learned one is used."""
    hosts = _hosts_load()
    devices = hosts["devices"]
    cache = MONITOR_HOSTS.relative_to(ROOT)
    if explicit:
        entry = devices.get(explicit)
        if entry:
            return entry["host"], f"learned for device {explicit}, {cache}"
        return explicit, "--host"
    pointer = hosts["ymls"].get(key) or {}
    known = sorted(((d, e) for d, e in devices.items() if e.get("yml") == key),
                   key=lambda de: de[1].get("seen") or 0, reverse=True)
    latest = pointer.get("device_id")
    if not latest and pointer.get("host"):
        # Learned after every device above (the pointer is rewritten on each learn).
        known.insert(0, (_UNSEEN_ID, pointer))
        latest = _UNSEEN_ID
    if latest not in dict(known):
        latest = known[0][0] if known else None
    if len(known) > 1:
        print(f"{len(known)} devices have been learned for {key} ({cache}):",
              file=sys.stderr)
        for d, e in known:
            mark = "  <- most recent" if d == latest else ""
            print(f"  {d:<24} {e['host']:<16} {_seen_text(e.get('seen'))}{mark}",
                  file=sys.stderr)
        if unique:
            print("ERROR: more than one device could be the target. Name one with "
                  "--host <ip or Device ID>.", file=sys.stderr)
            sys.exit(1)
        print(f"Using the most recent, {latest}; pass --host <ip or Device ID> to "
              f"pick another.", file=sys.stderr)
    if latest == _UNSEEN_ID:
        return pointer["host"], f"learned for {key}, device id not seen, {cache}"
    if latest:
        return devices[latest]["host"], f"learned for {key}, device {latest}, {cache}"
    legacy = hosts["environments"].get(env_name)
    if isinstance(legacy, str) and legacy:
        return legacy, (f"learned per environment {env_name} by an older CLI, {cache}; "
                        f"any board on this environment could own it")
    return None, None

def _pio_monitor_cmd(env_name: str) -> list:
    # `pio device monitor` has neither -c nor any other way to be pointed at a config
    # file (only -d/--project-dir and -e/--environment), and -e needs a platformio.ini
    # in the project dir — which this repo deliberately does not have (see
    # PLATFORMIO_INI). monitor_speed is the only setting the monitor needs from it, so
    # read it here and pass --baud instead of asking pio to resolve the config at all.
    return [find_pio(), "device", "monitor", "--baud", str(get_monitor_speed(env_name))]

def _wait_for_log_port(host: str, port: int, timeout: int) -> bool:
    """Poll until the device's log listener accepts a connection. After a flash the
    board reboots and has to associate with WiFi first, so a fresh `run --monitor`
    is expected to spend a few seconds here."""
    deadline  = time.time() + timeout
    announced = False
    while time.time() < deadline:
        try:
            with socket.create_connection((host, port), timeout=2):
                return True
        except OSError:
            if not announced:
                print(f"waiting for {host}:{port} to come up (up to {timeout}s, Ctrl-C to give up)...",
                      flush=True)
                announced = True
            time.sleep(1.0)
    return False

def monitor_net(cfg: dict, env_name: str, host: str, source: str, wait: int,
                log_port: int = None) -> int:
    """Attach pio's monitor to the device's TCP console. Returns a process rc."""
    port = log_port if log_port is not None else get_log_port(cfg)
    if port == 0:
        print("ERROR: device.yml sets log.tcp_port: 0 — the firmware's TCP console is "
              "disabled.\n       Set a port (default 23), then re-flash the filesystem: "
              "ebus-esp32 push --fs-only", file=sys.stderr)
        return 1
    # flush: pio's monitor writes straight to the terminal, so without this our
    # header block-buffers behind it whenever output is piped (tee'd build logs).
    print(f"--- monitor over network: {host}:{port} (host {source}) ---", flush=True)
    if not _wait_for_log_port(host, port, wait):
        print(f"\nERROR: no response from {host}:{port} after {wait}s.", file=sys.stderr)
        print("Things to check:", file=sys.stderr)
        print(f"  - is {host} still the device's address?  (override with --host)", file=sys.stderr)
        print( "  - did the device get on the network?     (watch over USB: ebus-esp32 monitor --serial)", file=sys.stderr)
        print( "  - is the firmware current?               (the TCP console needs a build that has it)", file=sys.stderr)
        return 1
    cmd = _pio_monitor_cmd(env_name) + ["--port", f"socket://{host}:{port}"]
    try:
        return subprocess.run(cmd, cwd=ROOT, env=pio_env()).returncode
    except KeyboardInterrupt:
        return 0

def monitor_serial(cfg: dict, env_name: str, port: str, key: str, learn: bool = True) -> int:
    """USB monitor. With learn=True the stream is relayed through this process so the
    device's IP can be scraped for the --net cache; that relay costs interactivity
    (keystrokes are no longer forwarded to the device), so --no-learn keeps pio
    attached directly to the terminal.

    pio runs under a serial_handoff.Supervisor, which stops it while a `run`/`push`
    from any terminal flashes this port and starts it again afterwards. The port is
    pinned (detected once if not given) so the restart reopens the same board."""
    port = port or serial_handoff.detect_serial_port(find_pio(), pio_env(), ROOT)
    cmd = _pio_monitor_cmd(env_name)
    if port:
        cmd += ["--port", port]
    else:
        print("(no USB serial port detected; pio will choose one, and a flash cannot "
              "pause this monitor)", flush=True)
        return subprocess.run(cmd, cwd=ROOT, env=pio_env()).returncode

    def spawn():
        if not learn:
            return subprocess.Popen(cmd, cwd=ROOT, env=pio_env())
        env = pio_env()
        env["PYTHONUNBUFFERED"] = "1"   # else pio's output block-buffers into the pipe
        if os.name == "posix":
            # PlatformIO 6.2 refuses to monitor unless its stdout is a terminal, so give
            # it a pseudo-terminal and read that instead of a pipe.
            import pty
            master, slave = pty.openpty()
            proc = subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=slave, stderr=slave)
            os.close(slave)
            proc.pty_master = master
            return proc
        return subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True,
                                errors="replace", bufsize=1)

    def lines_from(proc):
        master = getattr(proc, "pty_master", None)
        if master is None:
            yield from proc.stdout
            return
        pending = ""
        try:
            while True:
                try:
                    chunk = os.read(master, 4096)
                except OSError:      # EIO once pio exits and the pty closes
                    break
                if not chunk:
                    break
                pending += chunk.decode("utf-8", errors="replace")
                while "\n" in pending:
                    line, pending = pending.split("\n", 1)
                    yield line + "\n"
            if pending:
                yield pending
        finally:
            os.close(master)

    def drain(proc):
        if not learn:
            proc.wait()
            return
        device_id = None   # from this boot's "Device ID:" line, printed before the IP
        for line in lines_from(proc):
            sys.stdout.write(line)
            sys.stdout.flush()
            m = _ID_LEARN_RE.search(line)
            if m:
                device_id = m.group(1)
            m = _IP_LEARN_RE.search(line)
            if m:
                _host_learn(key, env_name, m.group(1), device_id)

    resume = f"ebus-esp32 monitor --port {port}" + ("" if learn else " --no-learn")
    sup = serial_handoff.Supervisor(RUN_DIR, port, spawn, drain,
                                    env_name=env_name or "", monitor_cmd=resume)
    print(f"(a flash to {port} from any terminal pauses and resumes this monitor)",
          flush=True)
    try:
        return sup.run()
    except serial_handoff.HandoffError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1

def cmd_monitor(args) -> None:
    cfg   = load_device_yml_if_present(args.device_yml)
    env_name = environment_or_none(cfg)
    key   = _host_key(cfg, args.device_yml)

    if args.serial and (args.net or args.host):
        print("ERROR: --serial cannot be combined with --net/--host", file=sys.stderr)
        sys.exit(2)

    # --port names a serial device, so it forces the USB transport; --serial does so
    # explicitly. Everything else prefers the network, which is the point of the
    # feature — an installed board has no cable to plug into.
    if args.serial or args.port:
        sys.exit(monitor_serial(cfg, env_name, args.port, key, learn=not args.no_learn))

    host, source = resolve_host(cfg, env_name, key, args.host)
    if not host:
        if args.net:
            print("ERROR: --net given but no device address is known.", file=sys.stderr)
            print("       Name it with --host <ip>, or watch over USB once to learn it:",
                  file=sys.stderr)
            print("         ebus-esp32 monitor --serial", file=sys.stderr)
            sys.exit(1)
        print("No device address known yet — falling back to the USB monitor.")
        print("Its IP will be learned from the boot log and used by later --net runs.\n")
        sys.exit(monitor_serial(cfg, env_name, args.port, key, learn=not args.no_learn))
    sys.exit(monitor_net(cfg, env_name, host, source, args.monitor_wait, args.log_port))

def post_monitor(cfg: dict, args) -> None:
    """Shared tail for build/run/push --monitor. Never fails the command that ran
    before it: the flash already succeeded, so a monitor that cannot attach is a
    reportable annoyance, not a reason to exit non-zero."""
    if not getattr(args, "monitor", False):
        return
    env_name = environment_or_none(cfg)
    host, source = resolve_host(cfg, env_name, _host_key(cfg, args.device_yml),
                                getattr(args, "host", None))
    if not host:
        print("\n--monitor: no device address known yet.")
        print("  Watch over USB once and the address is cached automatically:")
        print("    ebus-esp32 monitor --serial")
        print("  Or name it directly:  ebus-esp32 monitor --net --host <ip>")
        return
    print()
    monitor_net(cfg, env_name, host, source, getattr(args, "monitor_wait", 90),
                getattr(args, "log_port", None))

