# ── paths ──────────────────────────────────────────────────────────────────────

ROOT         = Path(__file__).resolve().parent
LIB_DIR      = ROOT / "lib"
SRC_DIR      = ROOT / "src"
DATA_DIR     = ROOT / "data"
INCLUDE_DIR  = ROOT / "include"
BUILD_DIR    = ROOT / "build"   # gitignored — generator scratch space, e.g. platformio.ini
PLATFORMIO_INI = ROOT / "platformio.ini"
GENERATED_INI  = BUILD_DIR / "platformio.ini"
# Per-developer config overlay: gitignored, repo-root, merged into the generated
# data/config.yml on every generate. No template and no init step — the file either
# exists and is overlaid, or it doesn't. Sits beside platformio_local.ini, which solves
# the same problem the same way. NOT under data/: that is the LittleFS payload and every
# byte there is flashed to a 192KB partition.
# Legacy: this used to live at ~/.config/eBus/config.yml; config-status warns if one is
# still lying around so it isn't silently ignored.
CONFIG_OVERLAY        = ROOT / "config-overlay.yml"
CONFIG_OVERLAY_LEGACY = Path.home() / ".config" / "eBus" / "config.yml"
MONITOR_HOSTS  = BUILD_DIR / "monitor-hosts.json"  # learned env -> last-known device IP

# ── pio helper ─────────────────────────────────────────────────────────────────

def find_pio() -> str:
    candidates = [
        Path.home() / ".platformio/penv/Scripts/pio.exe",  # Windows
        Path.home() / ".platformio/penv/bin/pio",           # Unix/Mac
    ]
    for p in candidates:
        if p.exists():
            return str(p)
    if shutil.which("pio"):
        return "pio"
    print("ERROR: PlatformIO not found.", file=sys.stderr)
    print("Install: https://platformio.org/install/cli", file=sys.stderr)
    sys.exit(1)

def pio_env() -> dict:
    """Environment for a `pio` subprocess, forcing UTF-8 stdout. Without this,
    PlatformIO's own Python process crashes (UnicodeEncodeError, cp1252 can't
    represent an esptool progress-output character) on Windows consoles not
    already set to a UTF-8 codepage — and the crash happens mid-flash, not at
    a safe boundary, so an interrupted firmware upload can leave the chip
    erased-but-unbootable rather than just showing an ugly error."""
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"
    return env

def pio_run(env_name: str, targets: list, port: str = None) -> int:
    pio = find_pio()
    cmd = [pio, "run", "-e", env_name]
    # Use the lean, per-build platformio.ini (this env's section + only the lib_deps
    # actually needed by device.yml's components) when generate has produced one;
    # falls back to the tracked platformio.ini otherwise (e.g. hand-coded projects).
    if GENERATED_INI.exists():
        cmd += ["-c", str(GENERATED_INI)]
    for t in targets:
        cmd += ["-t", t]
    if port:
        cmd += ["--upload-port", port]
    return subprocess.run(cmd, cwd=ROOT, env=pio_env()).returncode

# ── tmux serial-port handoff ────────────────────────────────────────────────────
# Coordinate the serial port with a monitor running in a tmux pane (via the bin/_*
# helpers). `monitor` drops a breadcrumb; `run`/
# `push` pause the monitor (Ctrl-C to release the port), upload, then resume it.
# Everything is a graceful no-op outside tmux and on Windows, so it never gets in
# the way of a plain CLI flash or a VSCode/PlatformIO IDE workflow.

def _coord(*argv: str) -> int:
    """Invoke a bin/ serial-coordination helper. No-op (rc 0) on Windows or if
    the helper is missing; the helpers themselves no-op outside tmux."""
    if sys.platform == "win32":
        return 0
    script = ROOT / "bin" / argv[0]
    if not script.exists():
        return 0
    return subprocess.run([str(script), *argv[1:]], cwd=ROOT).returncode

# ── yaml helpers ───────────────────────────────────────────────────────────────

def load_yaml_file(path: Path, *, require_mapping: bool = True) -> dict:
    """Parse a YAML file, turning malformed YAML (or a valid-but-wrong-shaped
    document, e.g. a list instead of a mapping) into a clean, actionable error —
    file path plus line/column — instead of a raw Python traceback or a confusing
    AttributeError several calls later when .get() hits the wrong type."""
    try:
        with open(path, encoding="utf-8") as f:
            doc = yaml.safe_load(f)
    except yaml.YAMLError as e:
        print(f"ERROR: {path} is not valid YAML:", file=sys.stderr)
        mark = getattr(e, "problem_mark", None)
        if mark is not None:
            print(f"  at line {mark.line + 1}, column {mark.column + 1}", file=sys.stderr)
        problem = getattr(e, "problem", None) or str(e)
        print(f"  {problem}", file=sys.stderr)
        sys.exit(1)
    if require_mapping and not isinstance(doc, dict):
        print(f"ERROR: {path} must be a YAML mapping (key: value) at the top level, "
              f"got {type(doc).__name__ if doc is not None else 'an empty document'}",
              file=sys.stderr)
        sys.exit(1)
    return doc

# ── device.yml helpers ─────────────────────────────────────────────────────────

def load_device_yml(path: Path) -> dict:
    if not path.exists():
        print(f"ERROR: {path} not found.", file=sys.stderr)
        print("Create one from the format in doc/GenerateHomieDevice.md", file=sys.stderr)
        sys.exit(1)
    return load_yaml_file(path)

def get_environment(cfg: dict) -> str:
    env_name = cfg.get("device", {}).get("environment")
    if not env_name:
        print("ERROR: device.yml missing device.environment", file=sys.stderr)
        sys.exit(1)
    return env_name

def get_log_port(cfg: dict) -> int:
    """Port the firmware's serial-over-TCP console listens on (device.yml
    `log.tcp_port`, default 23; 0 disables it). Single source for both the
    generated data/config.yml and the `--net` monitor's socket:// URL, so the two
    can never disagree."""
    try:
        return int((cfg.get("log") or {}).get("tcp_port", 23))
    except (TypeError, ValueError):
        print("ERROR: device.yml log.tcp_port must be an integer", file=sys.stderr)
        sys.exit(1)

# ── generate ───────────────────────────────────────────────────────────────────

_HOMIE_CPP_HEADER = """\
// AUTO-GENERATED by `ebus-esp32 generate` — do not edit manually.
// Regenerate with: ./ebus-esp32 generate
//
// Static node instances for this Homie device.
// All objects are statically allocated; constructors run before setup().

#include <homie.h>
"""

def find_component_yml(component: str):
    """Resolve a device.yml `component:` string to its lib/<bus>/<name>.yml path, or
    None if it doesn't match anything — callers report this, never raise, so a typo'd
    component in device.yml is a clear ERROR message rather than a Python traceback."""
    parts = component.split("/")
    if len(parts) == 2:
        p = LIB_DIR / parts[0] / f"{parts[1]}.yml"
        return p if p.exists() else None
    for sub in LIB_DIR.iterdir():
        if sub.is_dir():
            candidate = sub / f"{component}.yml"
            if candidate.exists():
                return candidate
    return None

def _cpp_literal(v) -> str:
    """Render a YAML config value as a C++ source literal.

    Booleans are the reason this exists: YAML `true` parses to Python True, whose str()
    is "True" — not C++, so it fails the build with "\'True\' was not declared in this
    scope", pointing at a generated file the author never wrote and no line of device.yml.

    None is deliberately NOT special-cased: check_config_keys() already rejects a required
    key that is present with no value, naming both the key and the node. Mapping None to ""
    here would give a bare positional argument (`("id", , 15)`) a second chance to reach
    the compiler if that check ever moved, while silently disagreeing with it meanwhile.
    """
    if isinstance(v, bool):
        return "true" if v else "false"
    return str(v)

def fmt_ctor(template: str, node_id: str, config: dict) -> str:
    result = template.replace("{id}", node_id)
    for k, v in (config or {}).items():
        result = result.replace(f"{{config.{k}}}", _cpp_literal(v))
    return result

_CONFIG_KEY_RE = re.compile(r"\{config\.(\w+)\}")

def required_config_keys(ctor_tmpl: str) -> set:
    """Config keys a component's constructor template actually substitutes, e.g.
    '{config.pin}' -> {'pin'}."""
    return set(_CONFIG_KEY_RE.findall(ctor_tmpl))

def check_config_keys(node_id: str, component: str, comp_path: Path,
                       ctor_tmpl: str, node_cfg: dict) -> None:
    """Catch a missing or typo'd config: key at generate time instead of letting it
    surface as a raw '{config.foo}' left in the generated C++ (a confusing compile
    error far from the actual mistake in device.yml)."""
    required = required_config_keys(ctor_tmpl)
    node_cfg = node_cfg or {}
    provided = set(node_cfg.keys())
    missing = sorted(required - provided)
    # A key present with no value (`pin:` with nothing after the colon, or explicit
    # `pin: null`) parses as {"pin": None} — present, so it wouldn't show up as
    # "missing" above, but str(None) would land the literal text "None" in the
    # generated C++ constructor call. Treat it as its own case, not silently OK.
    empty = sorted(k for k in required if k in node_cfg and node_cfg[k] is None)
    extra = sorted(provided - required)
    if missing or empty or extra:
        parts = []
        if missing:
            parts.append(f"missing required key(s): {', '.join(missing)}")
        if empty:
            parts.append(f"required key(s) present but with no value: {', '.join(empty)} "
                         f"(check for a trailing ':' with nothing after it)")
        if extra:
            # Reported alongside `missing` so a typo (e.g. 'pinn' instead of 'pin')
            # shows up as BOTH "missing pin" and "unrecognized pinn" in one message —
            # the pairing is what makes it obvious it's a typo, not just an omission.
            parts.append(f"unrecognized key(s): {', '.join(extra)} (check for a typo)")
        print(f"ERROR: device.yml node '{node_id}' (component '{component}') config: block "
              f"problem — {'; '.join(parts)}. Expected: {', '.join(sorted(required)) or 'none'} "
              f"— see {comp_path}", file=sys.stderr)
        sys.exit(1)

# ── lean, per-build platformio.ini ──────────────────────────────────────────────
#
# Every lib/<bus>/<name>.yml component can declare generator.lib_deps: [...] — the
# PlatformIO libraries IT needs. The full catalog of every such string, across every
# component that exists (whether device.yml uses it or not), is the set of libraries
# eligible for pruning from platformio.ini's [common].lib_deps: anything in that
# catalog gets dropped from the copy unless the CURRENT device.yml actually uses a
# component that lists it. This generalizes — a future BME280/ATM90E32 lib_deps entry
# gets the same treatment automatically, no generator changes needed.

def collect_optional_lib_catalog() -> set:
    """Every generator.lib_deps string across all lib/<bus>/<name>.yml files —
    the full set of libraries that are ever conditionally needed, used to decide
    what's safe to prune from [common].lib_deps when not actually in use."""
    catalog = set()
    for comp_yml in LIB_DIR.glob("*/*.yml"):
        comp = load_yaml_file(comp_yml)
        gen = comp.get("generator") or {}
        for dep in gen.get("lib_deps") or []:
            catalog.add(dep)
    return catalog

def write_lean_platformio_ini(env_name: str, used_lib_deps: list) -> None:
    """Write build/platformio.ini: a standalone copy of platformio.ini containing
    only [platformio], [env], [common] (lib_deps pruned+extended), and this one
    environment's [env:<name>] — everything `pio_run()` needs, nothing device.yml's
    components don't actually use. Silently skipped if platformio.ini doesn't
    parse or that env section doesn't exist (e.g. a bad environment: name is
    reported elsewhere, by get_environment()-consuming commands)."""
    if not PLATFORMIO_INI.exists():
        return
    src = configparser.RawConfigParser()
    src.read(PLATFORMIO_INI, encoding="utf-8")
    env_section = f"env:{env_name}"
    if not src.has_section("common") or not src.has_section(env_section):
        return

    optional_catalog = collect_optional_lib_catalog()
    base_deps = [line.strip() for line in src.get("common", "lib_deps").splitlines() if line.strip()]
    kept_deps = [d for d in base_deps if d not in optional_catalog]
    for dep in used_lib_deps:
        if dep not in kept_deps:
            kept_deps.append(dep)

    # If this build's lib_deps set differs from the PREVIOUS build/platformio.ini
    # for this environment, PlatformIO will reassign different short-hash library build
    # subdirectories (lib5d2, lib836, ...) for the same source files. .pio/build/
    # doesn't get pruned when a library drops out, so its stale SCons dependency
    # database (.sconsign.dblite) and orphaned object files can silently persist
    # and get reused — the generated firmware then reflects a PREVIOUS device.yml
    # state despite src/homie.cpp being freshly regenerated. Force a clean env
    # build dir whenever the active lib_deps set actually changes, so this can't
    # happen silently; a same-lib_deps rebuild stays incremental as normal.
    previous_deps = None
    if GENERATED_INI.exists():
        prev = configparser.RawConfigParser()
        prev.read(GENERATED_INI, encoding="utf-8")
        if prev.has_section("common"):
            previous_deps = sorted(l.strip() for l in prev.get("common", "lib_deps").splitlines() if l.strip())
    if previous_deps is not None and previous_deps != sorted(kept_deps):
        env_build_dir = ROOT / ".pio" / "build" / env_name
        if env_build_dir.exists():
            shutil.rmtree(env_build_dir)
            print(f"  lib_deps changed for env:{env_name} — removed stale {env_build_dir.relative_to(ROOT)} "
                  f"to avoid a mismatched incremental build")

    out = configparser.RawConfigParser()
    for section in ("platformio", "env", "common"):
        if src.has_section(section):
            out.add_section(section)
            for key, val in src.items(section):
                out.set(section, key, val)
    out.set("common", "lib_deps", "\n" + "\n".join(kept_deps))
    out.add_section(env_section)
    for key, val in src.items(env_section):
        out.set(env_section, key, val)

    BUILD_DIR.mkdir(parents=True, exist_ok=True)
    with open(GENERATED_INI, "w", encoding="utf-8") as f:
        f.write("; AUTO-GENERATED by `ebus-esp32 generate` — do not edit manually.\n")
        f.write(f"; Lean copy of platformio.ini for env:{env_name} — [common].lib_deps pruned to\n")
        f.write("; drop unused optional libraries, extended with what device.yml needs.\n")
        out.write(f)
    print(f"  generated: {GENERATED_INI.relative_to(ROOT)}  (env:{env_name}, "
          f"{len(kept_deps)} lib_deps, {len(base_deps) - len([d for d in base_deps if d in kept_deps])} pruned)")

def cmd_generate(args) -> None:
    device_yml = Path(args.device_yml)
    cfg        = load_device_yml(device_yml)
    device     = cfg.get("device", {})
    nodes_cfg  = cfg.get("nodes", [])

    includes          = []
    decls             = []   # entity object declarations
    child_dev_decls   = []   # static Device dev_<child>;
    prop_static_decls = []   # static Property <var>;
    prop_reg_body     = []   # body of register_homie_properties()
    setups            = []
    loops             = []
    homie_nodes       = []   # ROOT device's nodes only (data/homie.yml)
    seen_node_ids     = {}   # node_id -> component that first used it (duplicate-id check)
    used_lib_deps     = []   # lib_deps strings from every used component's generator block (dedup, ordered)

    def _cvar(s):
        return "".join(c if (c.isalnum() or c == "_") else "_" for c in str(s))

    def emit_node(entry, dev_access, setdev_addr, is_root):
        # dev_access: C++ device access prefix — "device->" (root) or "dev_x." (child)
        # setdev_addr: entity's device address ("&dev_x") for a child; None for root
        if not isinstance(entry, dict):
            print(f"ERROR: device.yml has incorrect YAML under nodes: — check the "
                  f"indentation and syntax of that entry", file=sys.stderr)
            sys.exit(1)
        component = entry.get("component")
        node_id   = entry.get("id")
        node_cfg  = entry.get("config") or {}
        if not isinstance(node_cfg, dict):
            print(f"ERROR: device.yml has incorrect YAML in node '{node_id or component}'s "
                  f"config: block — check the indentation and syntax", file=sys.stderr)
            sys.exit(1)
        if not component:
            print(f"ERROR: device.yml node entry missing required 'component' field: "
                  f"{entry!r}", file=sys.stderr)
            sys.exit(1)
        comp_path = find_component_yml(component)
        if comp_path is None:
            if "/" in component:
                expected = f"lib/{component}.yml"
            else:
                expected = f"lib/<bus>/{component}.yml (searched every <bus> under {LIB_DIR})"
            print(f"ERROR: device.yml node '{node_id or component}' references component "
                  f"'{component}', which does not match any component file — expected "
                  f"{expected}", file=sys.stderr)
            sys.exit(1)
        comp = load_yaml_file(comp_path)
        gen = comp.get("generator")
        if not gen:
            print(f"WARNING: no generator block in {comp_path} — skipping")
            return
        missing = [k for k in ("class", "header", "constructor") if k not in gen]
        if missing:
            print(f"ERROR: component yml '{comp_path}' generator block missing required "
                  f"field(s): {', '.join(missing)}", file=sys.stderr)
            sys.exit(1)
        cls, header, ctor_tmpl = gen["class"], gen["header"], gen["constructor"]
        comp_nodes = comp.get("nodes", [])
        explicit_id = bool(node_id)
        if not node_id:
            if comp_nodes and "id" not in comp_nodes[0]:
                print(f"ERROR: component yml '{comp_path}' first node entry missing "
                      f"required 'id' field: {comp_nodes[0]!r}", file=sys.stderr)
                sys.exit(1)
            node_id = comp_nodes[0]["id"] if comp_nodes else component.split("/")[-1]
        if node_id in seen_node_ids:
            hint = "" if explicit_id else " (defaulted from the component — add an explicit 'id:' to disambiguate)"
            print(f"ERROR: node id '{node_id}' is used by more than one node — first by "
                  f"component '{seen_node_ids[node_id]}', again by component "
                  f"'{component}'{hint}. Every node needs a unique id.", file=sys.stderr)
            sys.exit(1)
        seen_node_ids[node_id] = component
        check_config_keys(node_id, component, comp_path, ctor_tmpl, node_cfg)
        for dep in gen.get("lib_deps") or []:
            if dep not in used_lib_deps:
                used_lib_deps.append(dep)
        includes.append(f"#include <{header}>")
        decls.append(f"{cls} {node_id}{fmt_ctor(ctor_tmpl, node_id, node_cfg)};")
        setups.append(f"    {node_id}.setup();")
        loops.append(f"    {node_id}.loop();")
        if setdev_addr:
            prop_reg_body.append(f"    {node_id}.setDevice({setdev_addr});")  # entity -> child device (A2)
        single = len(comp_nodes) == 1
        for n in comp_nodes:
            nc = dict(n)
            if not single and "id" not in n:
                print(f"ERROR: component yml '{comp_path}' node entry missing required "
                      f"'id' field: {n!r}", file=sys.stderr)
                sys.exit(1)
            effective_node_id = node_id if single else n["id"]
            if single:
                nc["id"] = node_id
            if is_root:                # children are built in C++, not data/homie.yml
                homie_nodes.append(nc)
            properties = n.get("properties", [])
            node_name  = n.get("name", effective_node_id)
            node_type  = n.get("type", "generic")
            if properties:
                prop_reg_body.append("")
                id_expr = f'{node_id}.getNodeId()' if single else f'"{effective_node_id}"'
                prop_reg_body.append(f'    _node = {dev_access}addNode({id_expr}, "{node_name}", "{node_type}");')
                prop_reg_body.append('    if (_node) {')
                for prop in properties:
                    prop_id   = prop["id"]
                    # Sanitize the C++ variable name (Homie ids allow hyphens, C++ names
                    # don't) while the addProperty() arg below keeps the real id string.
                    prop_var  = f"_prop_{_cvar(effective_node_id)}_{_cvar(prop_id)}"
                    unit      = prop.get("unit", "")
                    settable  = prop.get("settable", False)
                    retained  = prop.get("retained", True)
                    prop_format = prop.get("format", "")
                    # rrj.3: numeric (physical-measurement) properties should carry a
                    # Homie `unit`. An ABSENT unit key is flagged as likely-forgotten;
                    # use `unit: ""` to declare a genuinely dimensionless value (count,
                    # ratio, power factor) and silence the warning.
                    if prop["datatype"] in ("float", "integer") and "unit" not in prop:
                        print(f"  WARNING: numeric property '{effective_node_id}/{prop_id}' has no "
                              f"'unit' — add one, or 'unit: \"\"' if intentionally dimensionless",
                              file=sys.stderr)
                    prop_static_decls.append(f"static Property {prop_var};")
                    args_str  = f'"{prop_id}", "{prop["name"]}", "{prop["datatype"]}", "{unit}"'
                    # Trailing args are positional: emit settable/retained if either is
                    # non-default OR a format follows (format is the 8th arg). (C2)
                    if settable or not retained or prop_format:
                        args_str += f', {str(settable).lower()}, {str(retained).lower()}'
                        if prop_format:
                            args_str += f', "{prop_format}"'
                    prop_reg_body.append(f'        _node->addProperty(&{prop_var}, {args_str});')
                    # $target support is a device behavior, not a $description field, so
                    # set it on the Property directly rather than via addProperty args (C5).
                    if prop.get("supports_target"):
                        prop_reg_body.append(f'        {prop_var}.setSupportsTarget(true);')
                prop_reg_body.append('    }')

    def emit_device(dev_cfg, dev_access, dev_addr, runtime_id_expr, is_root):
        # Emit this device's nodes, then recurse into nested child devices.
        nodes_list = dev_cfg.get("nodes") or []
        if not isinstance(nodes_list, list):
            print(f"ERROR: device.yml nodes: value isn't a list (got "
                  f"{type(nodes_list).__name__}: {nodes_list!r}) — expected a list of "
                  f"'- component: ...' entries", file=sys.stderr)
            sys.exit(1)
        for entry in nodes_list:
            emit_node(entry, dev_access, None if is_root else dev_addr, is_root)
        children_list = dev_cfg.get("children") or []
        if not isinstance(children_list, list):
            print(f"ERROR: device.yml children: value isn't a list (got "
                  f"{type(children_list).__name__}: {children_list!r}) — expected a list "
                  f"of child device entries", file=sys.stderr)
            sys.exit(1)
        for child in children_list:
            if not isinstance(child, dict) or "id" not in child:
                print(f"ERROR: device.yml child device entry missing required 'id' field "
                      f"(got {child!r})", file=sys.stderr)
                sys.exit(1)
            cid    = child["id"]                 # suffix; runtime id = <parent>-<cid>
            cvar   = "dev_" + _cvar(cid)
            cidbuf = "childId_" + _cvar(cid)
            cname  = child.get("name", cid)
            ctype  = child.get("type", "generic")
            child_dev_decls.append(f"static Device {cvar};")
            prop_reg_body.append("")
            prop_reg_body.append(f"    // nested child device: {cid}")
            prop_reg_body.append(f"    char {cidbuf}[96];")
            prop_reg_body.append(f'    snprintf({cidbuf}, sizeof({cidbuf}), "%s-{cid}", {runtime_id_expr});')
            prop_reg_body.append(f'    {cvar}.init("{cname}", {cidbuf}, "{ctype}", {dev_access}mqttClient());')
            prop_reg_body.append(f"    {dev_access}addChild(&{cvar});")
            emit_device(child, f"{cvar}.", f"&{cvar}", cidbuf, is_root=False)
            prop_reg_body.append(f"    {cvar}.setState(DeviceState::DEVICE_STATE_READY);")

    emit_device(cfg, "device->", "device", "device->getId()", is_root=True)

    # src/homie.cpp
    lines = [_HOMIE_CPP_HEADER]
    lines.append("#include <homie/Device.h>")
    lines.append("#include <homie/Property.h>")
    lines.append("")
    if includes:
        lines += list(dict.fromkeys(includes)) + [""]   # dedupe (same component in root + child)
    if decls:
        lines += decls + [""]
    if child_dev_decls:
        lines += ["// Nested child Device objects (Homie 5 parent/child)"] + child_dev_decls + [""]
    if prop_static_decls:
        lines += ["// Static Homie Property objects — one per node property"] + prop_static_decls + [""]
    lines += ["void register_homie_properties(Device* device) {"]
    if prop_reg_body:
        lines.append("    Node* _node;")
        lines += prop_reg_body
    lines += ["}"]
    lines += ["", "void setup_homie() {"] + (setups or ["    // no nodes configured"]) + ["}"]
    lines += ["", "void loop_homie() {"] + (loops or ["    // no nodes configured"]) + ["}", ""]

    out_cpp = SRC_DIR / "homie.cpp"
    out_cpp.write_text("\n".join(lines), encoding="utf-8")
    print(f"  generated: {out_cpp.relative_to(ROOT)}")

    # build/platformio.ini — a lean, standalone PlatformIO project config: the
    # active environment copied from platformio.ini, with [common].lib_deps pruned
    # of any library that's in some component's lib_deps catalog but wasn't actually
    # needed this build, then extended with what device.yml's components DO need.
    # This is what actually keeps e.g. EspSoftwareSerial out of non-modbus builds —
    # see write_lean_platformio_ini().
    env_for_ini = device.get("environment")
    if env_for_ini:
        write_lean_platformio_ini(env_for_ini, used_lib_deps)

    # data/homie.yml
    homie_doc = {
        "homie":          "5.0.1",
        "name":           device.get("name", "Homie Device"),
        "type":           device.get("type", "generic"),
        "state":          "init",
        "nodes":          homie_nodes,
        "extensions":     [],
        "implementation": "homie-esp32-sdk",
    }
    out_homie = DATA_DIR / "homie.yml"
    with open(out_homie, "w", encoding="utf-8") as f:
        yaml.dump(homie_doc, f, allow_unicode=True, sort_keys=False)
    print(f"  generated: {out_homie.relative_to(ROOT)}")

    # data/config.yml
    wifi     = cfg.get("wifi")  or {}
    mqtt_cfg = cfg.get("mqtt")  or {}
    # device.id is a runtime TEMPLATE (e.g. ${chip_id}, bess-${chip_id}); resolved
    # on-device. ${...} needs no YAML quoting. Guard against the legacy {{...}}/{...}
    # forms, which YAML parses as a mapping instead of a string.
    device_id_tmpl = device.get("id")
    if device_id_tmpl is not None and not isinstance(device_id_tmpl, str):
        print(f"ERROR: device.id must be a string template using ${{...}}, e.g. id: ${{chip_id}} "
              f"(got {device_id_tmpl!r} — a bare {{...}} is parsed as YAML, not a string; use $)",
              file=sys.stderr)
        sys.exit(1)
    # config.yml mirrors device.yml's SECTIONS (device/wifi/mqtt/log/mdns) key-for-key, so
    # there is exactly one vocabulary a human ever types: device.yml, config-overlay.yml and
    # the generated file all look the same. (The flat wifi_ssid/mqtt_host form this replaced
    # meant an overlay written in device.yml's shape merged in as dead nested keys that the
    # firmware never read — silently, since every key was "valid".) The firmware still
    # accepts the flat form as a fallback; see loadPlatformConfiguration() in config.cpp.
    config_doc = {
        "device": {
            "id":                device_id_tmpl                  or "",   # template (see above)
            # Optional deployment-scoped segment prepended to the resolved id at boot
            # ("lab1" -> lab1-ebus-b0b21c90f570). Empty = no prefix. Typically set from
            # config-overlay.yml so a site can namespace a fleet without editing device.yml.
            "id_prefix":         device.get("id_prefix")         or "",
            "name":              device.get("name")              or "",
            # device.yml carries BOTH `type:` (Homie $type) and `device_type:`; the latter
            # wins, exactly as it did in the flat form. Emitted under its device.yml name so
            # an overlay section can be pasted straight across.
            "device_type":       device.get("device_type") or device.get("type") or "",
            "firmware_name":     device.get("firmware_name")     or "",
            "firmware_version":  device.get("firmware_version")  or "",
            "firmware_url":      device.get("firmware_url")      or "",
            "manufacturer":      device.get("manufacturer")      or "",
            "model":             device.get("model")             or "",
            "serial_number":     device.get("serial_number")     or "",
            "homie_role":        device.get("homie_role")        or "device",
            "device_passphrase": device.get("device_passphrase") or "changeme",
        },
        "wifi": {
            "ssid":     wifi.get("ssid")     or "",
            "password": wifi.get("password") or "",
        },
        "mqtt": {
            "mode":     mqtt_cfg.get("mode") or "configured-only",
            "host":     mqtt_cfg.get("host") or "",
            "port":     mqtt_cfg.get("port") or 1883,
            "qos":      mqtt_cfg.get("qos") if mqtt_cfg.get("qos") is not None else 2,
            "username": mqtt_cfg.get("username") or "",
            "password": mqtt_cfg.get("password") or "",
        },
        "log": {
            # Serial-over-TCP console port (device.yml: log.tcp_port); 0 disables.
            "tcp_port": get_log_port(cfg),
        },
    }
    # mDNS is TRI-STATE. Emitting these keys unconditionally would defeat the firmware's
    # build-conditional default (off for WiFi-AP builds, on for Ethernet-only ones — see
    # config.cpp), because loadPlatformConfiguration() applies a key whenever it is present.
    # So the whole section is omitted when device.yml says nothing about mdns; a present key
    # — true OR false — always wins at runtime.
    mdns_cfg = cfg.get("mdns") or {}
    mdns_out = {k: bool(mdns_cfg[k]) for k in ("enabled", "discovery", "advertise")
                if mdns_cfg.get(k) is not None}
    if mdns_out:
        config_doc["mdns"] = mdns_out

    out_config = DATA_DIR / "config.yml"
    with open(out_config, "w", encoding="utf-8") as f:
        yaml.dump(config_doc, f, allow_unicode=True, sort_keys=False)
    print(f"  generated: {out_config.relative_to(ROOT)}")
    _apply_overlay(out_config)

    env_name = device.get("environment", "<environment>")
    print(f"\n{len(nodes_cfg)} node(s), environment: {env_name}")

# ── build ──────────────────────────────────────────────────────────────────────

def cmd_build(args) -> None:
    # Explicit generate here (unlike src/homie.cpp/data/*.yml, which the PlatformIO
    # pre-build hook also regenerates during `pio run` itself): build/platformio.ini
    # must exist and be current BEFORE pio starts parsing config — that parsing
    # happens before the pre: hook ever runs, so regenerating from inside it would
    # be one run too late for -c to pick up.
    cmd_generate(args)
    cfg   = load_device_yml(Path(args.device_yml))
    env_name = get_environment(cfg)
    print(f"--- build (env: {env_name}) ---\n")
    rc = pio_run(env_name, [])
    if rc != 0:
        print(f"\nBUILD FAILED (exit {rc})", file=sys.stderr)
        sys.exit(rc)
    bin_path = ROOT / ".pio" / "build" / env_name / "firmware.bin"
    if bin_path.exists():
        print(f"\nfirmware: {bin_path}  ({bin_path.stat().st_size / 1024:.1f} KB)")
    # `build` does not flash, so this attaches to whatever the device is already
    # running — useful for watching a live board while iterating on a build.
    post_monitor(cfg, args)

# ── run / push ─────────────────────────────────────────────────────────────────

def _upload(cfg, args, build: bool) -> None:
    env_name = get_environment(cfg)
    port  = getattr(args, "port", None)

    # --ota replaces the USB upload entirely: no serial port, so none of the tmux
    # port-handoff below applies. ota_push() only transports whatever images already
    # sit in .pio/build/<board>/ — unlike the USB path (where `upload`/`buildfs`
    # compile as a side effect of flashing), nothing here builds them, so `run --ota`
    # has to compile explicitly first. `push --ota` intentionally skips this, same as
    # USB push.
    target = _ota_target(cfg, args)
    if target:
        if build:
            print(f"\n--- build (env: {env_name}) ---")
            if not args.fs_only:
                rc = pio_run(env_name, [])
                if rc != 0:
                    print(f"\nBUILD FAILED (exit {rc})", file=sys.stderr)
                    sys.exit(rc)
            rc = pio_run(env_name, ["buildfs"])
            if rc != 0:
                print(f"\nFilesystem build FAILED (exit {rc})", file=sys.stderr)
                sys.exit(rc)
        ota_push(cfg, args, *target)
        return

    # Pause a tmux serial monitor holding the port (no-op if none / outside tmux).
    # A non-zero rc means ambiguous monitors (multiple live, no port given) — abort
    # so the user can disambiguate with --port.
    if _coord("_flash-coord", "pause", port or "") != 0:
        sys.exit(1)
    try:
        # Optional full chip erase first. Use when the board boots stale firmware
        # after a flash (the OTA partition scheme has two app slots; a confused
        # otadata can boot the wrong one). Erase resets otadata to a clean slate.
        if getattr(args, "erase", False):
            print(f"\n--- erasing flash (env: {env_name}) ---")
            rc = pio_run(env_name, ["erase"], port)
            if rc != 0:
                print(f"\nErase FAILED (exit {rc})", file=sys.stderr)
                sys.exit(rc)

        # NOTE: firmware and filesystem are uploaded in SEPARATE `pio run`
        # invocations, never combined as `pio run -t upload -t buildfs -t uploadfs`.
        # On this board's dual-OTA partition layout, the combined form can leave
        # otadata pointing at the previous app slot, so the device boots stale
        # firmware even though the flash "verifies". Keep these two calls separate.
        if not args.fs_only:
            label = "build + upload firmware" if build else "upload firmware"
            print(f"\n--- {label} (env: {env_name}) ---")
            rc = pio_run(env_name, ["upload"], port)
            if rc != 0:
                print(f"\nFirmware upload FAILED (exit {rc})", file=sys.stderr)
                sys.exit(rc)
            bin_path = ROOT / ".pio" / "build" / env_name / "firmware.bin"
            if bin_path.exists():
                print(f"flashed: {bin_path}  ({bin_path.stat().st_size / 1024:.1f} KB)")

        print(f"\n--- uploading filesystem (env: {env_name}) ---")
        rc = pio_run(env_name, ["buildfs", "uploadfs"], port)
        if rc != 0:
            print(f"\nFilesystem upload FAILED (exit {rc})", file=sys.stderr)
            sys.exit(rc)

        print("\ndone.")
    finally:
        # Resume the monitor in its tmux pane (no-op if nothing was paused).
        _coord("_flash-coord", "restart", port or "")

# ── OTA push over TCP ──────────────────────────────────────────────────────────
#
# Flash a board that has no reachable USB cable, by POSTing the built images to the
# portal's OTA endpoints (see the "OTA image push" block in captive_portal.cpp).
#
# Order matters: the filesystem goes first with ?reboot=0, then the firmware with the
# reboot, so both land in a single session and the board restarts once at the end.

OTA_CHUNK = 4096

def _ota_request(host: str, path: str, passphrase: str, payload: bytes,
                 content_type: str, label: str, timeout: int = 120):
    """POST payload with pre-emptive Basic auth. Returns (status, body_text).

    Pre-emptive matters: urllib's auth handler waits for a 401 and then RETRIES, which
    for a 1.3MB image means uploading it twice. Sending Authorization up front makes
    it one pass. Content-Length is set explicitly for the same reason chunked encoding
    is avoided — the device sizes Update.begin() from it and rejects a zero.
    """
    auth = base64.b64encode(f"admin:{passphrase}".encode()).decode()
    # No explicit port: HTTPConnection parses "host:port" when given one and defaults
    # to 80 otherwise, so --host accepts either form.
    conn = http.client.HTTPConnection(host, timeout=timeout)
    try:
        conn.putrequest("POST", path, skip_accept_encoding=True)
        conn.putheader("Authorization", "Basic " + auth)
        conn.putheader("Content-Type", content_type)
        conn.putheader("Content-Length", str(len(payload)))
        conn.endheaders()
        total = len(payload)
        sent  = 0
        last  = -1
        for off in range(0, total, OTA_CHUNK):
            conn.send(payload[off:off + OTA_CHUNK])
            sent += len(payload[off:off + OTA_CHUNK])
            pct = sent * 100 // total if total else 100
            if pct != last and pct % 5 == 0 and pct < 100:   # 100% printed once, below
                last = pct
                print(f"\r  {label}: {pct:3d}%  ({sent}/{total} bytes)", end="", flush=True)
        print(f"\r  {label}: 100%  ({total}/{total} bytes)", flush=True)
        resp = conn.getresponse()
        return resp.status, resp.read().decode("utf-8", "replace").strip()
    finally:
        conn.close()

def _ota_push_image(host: str, path: str, passphrase: str, image: Path,
                    label: str, reboot: bool) -> None:
    if not image.exists():
        print(f"ERROR: {image} not found — build first (ebus-esp32 build)", file=sys.stderr)
        sys.exit(1)
    url = path if reboot else path + "?reboot=0"
    status, body = _ota_request(host, url, passphrase, image.read_bytes(),
                                "application/octet-stream", label)
    if status != 200:
        print(f"\n{label} FAILED: HTTP {status} {body}", file=sys.stderr)
        sys.exit(1)
    print(f"  -> {body}")

def ota_push(cfg: dict, args, host: str, source: str) -> None:
    env_name  = get_environment(cfg)
    passphrase = getattr(args, "passphrase", None) or \
                 (cfg.get("device") or {}).get("device_passphrase") or ""
    if not passphrase:
        print("ERROR: no device_passphrase in device.yml (and no --passphrase given).\n"
              "       The OTA endpoints require it.", file=sys.stderr)
        sys.exit(1)

    build_dir = ROOT / ".pio" / "build" / env_name
    fw, fs = build_dir / "firmware.bin", build_dir / "littlefs.bin"

    print(f"\n--- OTA push to {host} (host {source}, env {env_name}) ---")

    # The endpoints are gated on ota_is_enabled(), which is a timed window — open it
    # first or every push comes back "OTA not enabled".
    status, body = _ota_request(host, "/api/ota", passphrase, b'{"enabled":true}',
                                "application/json", "enable OTA", timeout=15)
    if status != 200:
        print(f"\nCould not enable OTA: HTTP {status} {body}", file=sys.stderr)
        if status == 401:
            print("  (check device_passphrase in device.yml)", file=sys.stderr)
        sys.exit(1)

    # Filesystem first, staged; firmware last and it carries the reboot. With
    # --fs-only there is no second image, so the filesystem push reboots instead.
    if not args.fs_only:
        _ota_push_image(host, "/api/ota/filesystem", passphrase, fs, "filesystem", reboot=False)
        _ota_push_image(host, "/api/ota/firmware",   passphrase, fw, "firmware",   reboot=True)
    else:
        _ota_push_image(host, "/api/ota/filesystem", passphrase, fs, "filesystem", reboot=True)

    print("\ndone — device rebooting.")

def _ota_target(cfg, args):
    """(host, source) when this invocation should flash over the network, else None."""
    if not getattr(args, "ota", False):
        return None
    host, source = resolve_host(cfg, get_environment(cfg), getattr(args, "host", None))
    if not host:
        print("ERROR: --ota given but no device address is known.", file=sys.stderr)
        print("       Pass --host <ip>, or learn it once over USB: ebus-esp32 monitor --serial",
              file=sys.stderr)
        sys.exit(1)
    return host, source

def cmd_run(args) -> None:
    # Explicit generate here — see cmd_build for why build/platformio.ini needs to
    # exist before pio starts, not just via the pre-build hook.
    cmd_generate(args)
    cfg = load_device_yml(Path(args.device_yml))
    _upload(cfg, args, build=True)
    post_monitor(cfg, args)

def cmd_push(args) -> None:
    # No generate here: push is explicitly "flash pre-built artifacts, no rebuild" —
    # it doesn't compile, so build/platformio.ini isn't consulted either way.
    cfg = load_device_yml(Path(args.device_yml))
    _upload(cfg, args, build=False)
    post_monitor(cfg, args)

# ── monitor ────────────────────────────────────────────────────────────────────
#
# Two transports, one command:
#
#   serial   pio device monitor over USB — the original behaviour.
#   network  pio device monitor --port socket://<host>:<log.tcp_port>, reading the
#            firmware's serial-over-TCP console (include/platform/log_stream.h). No
#            extra tooling: pyserial (which pio's monitor uses) speaks socket:// URLs
#            natively, and the device replays its ring buffer to each new client, so
#            the boot log survives connecting late.
#
# Host resolution, in order: --host, then the address learned from a previous serial
# session (cached per environment in build/monitor-hosts.json), then <device.name>.local.
# There is no mDNS browse — the firmware advertises _telnet._tcp, but mdns is opt-in
# and off by default, so the cache is what makes `--net` work with no arguments.

# main.cpp prints exactly these once an interface has an IP. Scraping them while a
# serial monitor is already running is how the cache gets populated, at zero cost to
# the user: flash over USB once, and every later `--net` monitor knows the address.
_IP_LEARN_RE = re.compile(r"Network:\s+(?:WiFi STA|Ethernet)\s+IP=(\d{1,3}(?:\.\d{1,3}){3})")

def _hosts_load() -> dict:
    """Learned environment -> host map. A corrupt/missing cache is not an error: the
    monitor still works with an explicit --host."""
    try:
        data = json.loads(MONITOR_HOSTS.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}

def _host_learn(env_name: str, host: str) -> None:
    hosts = _hosts_load()
    if hosts.get(env_name) == host:
        return
    hosts[env_name] = host
    try:
        BUILD_DIR.mkdir(parents=True, exist_ok=True)
        MONITOR_HOSTS.write_text(json.dumps(hosts, indent=2) + "\n", encoding="utf-8")
        print(f"\n[ebus] learned device address {host} for {env_name}"
              f"  ->  ebus-esp32 monitor --net\n", flush=True)
    except OSError as e:
        print(f"[ebus] WARNING: could not cache device address: {e}", file=sys.stderr)

def resolve_host(cfg: dict, env_name: str, explicit: str = None):
    """(host, source) for the network monitor, or (None, None) if nothing is known."""
    if explicit:
        return explicit, "--host"
    cached = _hosts_load().get(env_name)
    if cached:
        return cached, f"learned, {MONITOR_HOSTS.relative_to(ROOT)}"
    name = (cfg.get("device") or {}).get("name")
    if name:
        # Best-effort guess, and only usable if mdns.enabled is true in device.yml AND
        # this host has working mDNS. Resolve it *now* rather than handing back a name
        # that would burn the whole --monitor-wait timing out: on a first run there is
        # no cache, and falling straight through to the USB monitor (which is what
        # populates the cache) is the useful behaviour.
        guess = f"{name}.local"
        try:
            socket.getaddrinfo(guess, None)
            return guess, "guess from device.name"
        except OSError:
            pass
    return None, None

def _pio_monitor_cmd(env_name: str) -> list:
    # NB: no `-c build/platformio.ini` here, unlike pio_run(). `pio device monitor`
    # has no --project-conf option (only -d/--project-dir and -e/--environment), so
    # passing -c is a hard "No such option" error. `-e` reads the tracked
    # platformio.ini, which is where monitor_speed lives anyway.
    return [find_pio(), "device", "monitor", "-e", env_name]

def _wait_for_log_port(host: str, port: int, timeout: int) -> bool:
    """Poll until the device's log listener accepts a connection. After a flash the
    board reboots and has to associate with WiFi first, so a fresh `run --monitor`
    is expected to spend a few seconds here."""
    deadline  = time.time() + timeout
    announced = False
    while time.time() < deadline:
        try:
            with socket.create_connection((host, port), timeout=2):
                return True
        except OSError:
            if not announced:
                print(f"waiting for {host}:{port} to come up (up to {timeout}s, Ctrl-C to give up)...",
                      flush=True)
                announced = True
            time.sleep(1.0)
    return False

def monitor_net(cfg: dict, env_name: str, host: str, source: str, wait: int) -> int:
    """Attach pio's monitor to the device's TCP console. Returns a process rc."""
    port = get_log_port(cfg)
    if port == 0:
        print("ERROR: device.yml sets log.tcp_port: 0 — the firmware's TCP console is "
              "disabled.\n       Set a port (default 23), then re-flash the filesystem: "
              "ebus-esp32 push --fs-only", file=sys.stderr)
        return 1
    # flush: pio's monitor writes straight to the terminal, so without this our
    # header block-buffers behind it whenever output is piped (tee'd build logs).
    print(f"--- monitor over network: {host}:{port} (host {source}) ---", flush=True)
    if not _wait_for_log_port(host, port, wait):
        print(f"\nERROR: no response from {host}:{port} after {wait}s.", file=sys.stderr)
        print("Things to check:", file=sys.stderr)
        print(f"  - is {host} still the device's address?  (override with --host)", file=sys.stderr)
        print( "  - did the device get on the network?     (watch over USB: ebus-esp32 monitor --serial)", file=sys.stderr)
        print( "  - is the firmware current?               (the TCP console needs a build that has it)", file=sys.stderr)
        return 1
    cmd = _pio_monitor_cmd(env_name) + ["--port", f"socket://{host}:{port}"]
    try:
        return subprocess.run(cmd, cwd=ROOT, env=pio_env()).returncode
    except KeyboardInterrupt:
        return 0

def monitor_serial(cfg: dict, env_name: str, port: str, learn: bool = True) -> int:
    """USB monitor. With learn=True the stream is relayed through this process so the
    device's IP can be scraped for the --net cache; that relay costs interactivity
    (keystrokes are no longer forwarded to the device), so --no-learn keeps pio
    attached directly to the terminal."""
    # Drop a tmux breadcrumb so a later `run`/`push` can pause
    # and resume this monitor; tagged "ebus" so resume relaunches this CLI. No-op
    # outside tmux. Cleared on exit whether the monitor quits normally or via Ctrl-C.
    _coord("_monitor-record", env_name, port or "", "ebus")
    cmd = _pio_monitor_cmd(env_name)
    if port:
        cmd += ["--port", port]
    try:
        if not learn:
            return subprocess.run(cmd, cwd=ROOT, env=pio_env()).returncode
        env = pio_env()
        env["PYTHONUNBUFFERED"] = "1"   # else pio's output block-buffers into the pipe
        proc = subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True,
                                errors="replace", bufsize=1)
        try:
            for line in proc.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                m = _IP_LEARN_RE.search(line)
                if m:
                    _host_learn(env_name, m.group(1))
        except KeyboardInterrupt:
            pass
        finally:
            if proc.poll() is None:
                proc.terminate()
            try:
                return proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                return proc.wait()
    finally:
        _coord("_monitor-release", port or "")

def cmd_monitor(args) -> None:
    cfg   = load_device_yml(Path(args.device_yml))
    env_name = get_environment(cfg)

    if args.serial and (args.net or args.host):
        print("ERROR: --serial cannot be combined with --net/--host", file=sys.stderr)
        sys.exit(2)

    # --port names a serial device, so it forces the USB transport; --serial does so
    # explicitly. Everything else prefers the network, which is the point of the
    # feature — an installed board has no cable to plug into.
    if args.serial or args.port:
        sys.exit(monitor_serial(cfg, env_name, args.port, learn=not args.no_learn))

    host, source = resolve_host(cfg, env_name, args.host)
    if not host:
        if args.net:
            print("ERROR: --net given but no device address is known.", file=sys.stderr)
            print("       Name it with --host <ip>, or watch over USB once to learn it:",
                  file=sys.stderr)
            print("         ebus-esp32 monitor --serial", file=sys.stderr)
            sys.exit(1)
        print("No device address known yet — falling back to the USB monitor.")
        print("Its IP will be learned from the boot log and used by later --net runs.\n")
        sys.exit(monitor_serial(cfg, env_name, args.port, learn=not args.no_learn))
    sys.exit(monitor_net(cfg, env_name, host, source, args.monitor_wait))

def post_monitor(cfg: dict, args) -> None:
    """Shared tail for build/run/push --monitor. Never fails the command that ran
    before it: the flash already succeeded, so a monitor that cannot attach is a
    reportable annoyance, not a reason to exit non-zero."""
    if not getattr(args, "monitor", False):
        return
    env_name = get_environment(cfg)
    host, source = resolve_host(cfg, env_name, getattr(args, "host", None))
    if not host:
        print("\n--monitor: no device address known yet.")
        print("  Watch over USB once and the address is cached automatically:")
        print("    ebus-esp32 monitor --serial")
        print("  Or name it directly:  ebus-esp32 monitor --net --host <ip>")
        return
    print()
    monitor_net(cfg, env_name, host, source, getattr(args, "monitor_wait", 90))

