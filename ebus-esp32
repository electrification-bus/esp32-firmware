# ── envs ───────────────────────────────────────────────────────────────────────
#
# Read from PLATFORMIO_INI directly rather than via `pio project config`: that command
# takes only -d/--project-dir, so it would demand a platformio.ini in the project dir,
# which is exactly what this repo does not have. platformio_local.ini is merged in the
# same order PlatformIO would (extra_configs last, so it wins).

def read_pio_config() -> configparser.RawConfigParser:
    """The tracked platformio.ini plus any platformio_local.ini overlay."""
    cfg = configparser.RawConfigParser()
    cfg.read([str(PLATFORMIO_INI), str(ROOT / "platformio_local.ini")], encoding="utf-8")
    return cfg

def get_monitor_speed(env_name: str, default: int = 115200) -> int:
    """monitor_speed for one env, falling back to [env] and then to `default`."""
    cfg = read_pio_config()
    for section in (f"env:{env_name}", "env"):
        if cfg.has_option(section, "monitor_speed"):
            try:
                return int(cfg.get(section, "monitor_speed").strip())
            except ValueError:
                break
    return default

def cmd_envs(args) -> None:
    for section in read_pio_config().sections():
        if section.startswith("env:"):
            print(section[4:])

