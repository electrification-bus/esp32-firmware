def cmd_compiledb(args) -> None:
    cmd_generate(args)   # .ebus/platformio.ini must exist before pio parses config
    cfg = load_device_yml(Path(args.device_yml))
    env_name = get_environment(cfg)
    print(f"--- compiledb (env: {env_name}) — regenerating compile_commands.json for clangd/LSP ---")
    rc = pio_run(env_name, ["compiledb"])
    if rc == 0:
        _resolve_compiledb_links(ROOT / "compile_commands.json")
    sys.exit(rc)

def _resolve_compiledb_links(path: Path) -> None:
    """Rewrite the staged .ebus/src/ paths in compile_commands.json to the files they link
    to, so an editor matches src/main.cpp and the project's own sources."""
    try:
        entries = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    staged = str(GEN_SRC_DIR) + os.sep
    for entry in entries:
        file = os.path.join(entry.get("directory", ""), entry.get("file", ""))
        if os.path.abspath(file).startswith(staged):
            entry["file"] = os.path.realpath(file)
    path.write_text(json.dumps(entries, indent=2) + "\n", encoding="utf-8")

