    pio = find_pio()
    cmd = [pio, "check", "-e", env_name]
    if GENERATED_INI.exists():
        cmd += ["-c", str(GENERATED_INI)]
    sys.exit(subprocess.run(cmd, cwd=ROOT, env=pio_env()).returncode)

