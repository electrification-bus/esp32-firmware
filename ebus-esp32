#!/usr/bin/env python3
"""
ebus-esp32 — eBus ESP32 firmware CLI

  ./ebus-esp32 generate                  Generate src/homie.cpp + data/*.yml from device.yml
  ./ebus-esp32 build                     Generate, then compile firmware + filesystem
  ./ebus-esp32 run                       Generate, build, and flash firmware + filesystem
  ./ebus-esp32 run --port COM3           Specify serial port
  ./ebus-esp32 push                      Flash pre-built firmware + filesystem (no build)
  ./ebus-esp32 push --fs-only            Flash filesystem only (no build)
  ./ebus-esp32 monitor                   Watch the device — over the network if its
                                         address is known, else over USB
  ./ebus-esp32 monitor --serial          Force USB (and learn the device's IP)
  ./ebus-esp32 monitor --net --host IP   Force the network console at a given address
  ./ebus-esp32 run --monitor             Flash, then watch over the network
  ./ebus-esp32 clean                     Clean build artifacts
  ./ebus-esp32 devices                   List attached serial devices
  ./ebus-esp32 envs                      List available PlatformIO board environments

On Windows, invoke via the wrapper: `ebus-esp32.bat run` (or `python ebus-esp32 run`).
"""

