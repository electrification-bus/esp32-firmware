# ── envs ───────────────────────────────────────────────────────────────────────
#
# Read from PLATFORMIO_INI directly rather than via `pio project config`: that command
# takes only -d/--project-dir, so it would demand a platformio.ini in the project dir,
# which is exactly what this repo does not have. platformio_local.ini is merged in the
# same order PlatformIO would (extra_configs last, so it wins).

def read_pio_config() -> configparser.RawConfigParser:
    """The tracked platformio.ini plus any platformio_local.ini overlay."""
    cfg = configparser.RawConfigParser()
    cfg.read([str(PLATFORMIO_INI), str(ROOT / "platformio_local.ini")], encoding="utf-8")
    return cfg

def get_monitor_speed(env_name: str, default: int = 115200) -> int:
    """monitor_speed for one env, falling back to [env] and then to `default`."""
    cfg = read_pio_config()
    for section in (f"env:{env_name}", "env"):
        if cfg.has_option(section, "monitor_speed"):
            try:
                return int(cfg.get(section, "monitor_speed").strip())
            except ValueError:
                break
    return default

def cmd_envs(args) -> None:
    selected = None
    device_yml = Path(args.device_yml)
    if yaml is not None and device_yml.exists():
        device = load_yaml_file(device_yml).get("device") or {}
        selected = device.get("environment") if isinstance(device, dict) else None
    names = [s[4:] for s in read_pio_config().sections() if s.startswith("env:")]
    width = max((len(n) for n in names), default=0)
    for name in names:
        notes = []
        if name == selected:
            notes.append(f"selected by {device_yml}")
        if name.endswith("-arduino2"):
            notes.append("legacy: arduino-esp32 2.0.17")
        if name == NATIVE_ENV:
            notes.append("host unit tests, not a board: ebus-esp32 test")
        mark = "*" if name == selected else " "
        print(f"{mark} {name:<{width}}  {', '.join(notes)}".rstrip())

# ── test ───────────────────────────────────────────────────────────────────────
#
# One `pio test` per suite, not one for all of them. With -c, PlatformIO 6 runs the
# first suite and then fails the next with "Please specify platform for 'native'
# environment": its `run` step clears the custom config path on exit, and the next
# suite's runner looks the platform up from the default ./platformio.ini, which this
# repo deliberately does not have.

def require_core() -> None:
    """Exit with a hint when the lib/ebus_core submodule is not checked out."""
    if not (LIB_DIR / "ebus_core" / "library.json").is_file():
        print("ERROR: lib/ebus_core is empty. It is a git submodule holding the eBus core "
              "(electrification-bus/cpp-sdk); fetch it with:\n"
              "  git submodule update --init", file=sys.stderr)
        sys.exit(1)

def core_test_suites() -> list:
    """Names of the core's Unity suites in the submodule's test/, as `pio test -f`
    filters relative to CORE_TEST_DIR."""
    if not CORE_TEST_DIR.is_dir():
        return []
    return [d.name for d in sorted(CORE_TEST_DIR.iterdir())
            if d.is_dir() and d.name.startswith("test_")]

def native_test_suites() -> list:
    """Names of the Unity suites under test/native/, as `pio test -f` filters."""
    if not NATIVE_TEST_DIR.is_dir():
        return []
    return [f"native/{d.name}" for d in sorted(NATIVE_TEST_DIR.iterdir())
            if d.is_dir() and d.name.startswith("test_")]

def cmd_test(args) -> None:
    require_core()
    core_env = pio_env()
    core_env["PLATFORMIO_TEST_DIR"] = str(CORE_TEST_DIR)
    # (label, pio -f filter, environment)
    runs = [(s, s, pio_env()) for s in native_test_suites()]
    runs += [(f"core/{s}", s, core_env) for s in core_test_suites()]
    if not runs:
        sys.exit(f"ERROR: no test suites under {NATIVE_TEST_DIR.relative_to(ROOT)} or "
                 f"{CORE_TEST_DIR.relative_to(ROOT)}")
    suites = [label for label, _, _ in runs]
    pio = find_pio()
    failed = []
    for label, suite, env in runs:
        cmd = [pio, "test", "-e", NATIVE_ENV, "-c", str(PLATFORMIO_INI), "-f", suite]
        if subprocess.run(cmd, cwd=ROOT, env=env).returncode != 0:
            failed.append(label)
    print(f"\n--- {len(suites) - len(failed)}/{len(suites)} native test suites passed ---")
    for suite in failed:
        print(f"  FAILED: {suite}")
    sys.exit(1 if failed else 0)

