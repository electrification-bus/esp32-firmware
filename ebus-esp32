# ── pio helper ─────────────────────────────────────────────────────────────────

def _interpreter_present(script: Path) -> bool:
    """False when a script's #! interpreter is missing, e.g. a PlatformIO penv copied
    from another machine; running it would fail with FileNotFoundError."""
    try:
        with open(script, "rb") as f:
            first = f.readline(256)
    except OSError:
        return False
    if not first.startswith(b"#!"):
        return True
    parts = first[2:].strip().split()
    return not parts or Path(parts[0].decode(errors="replace")).exists()

def find_pio() -> str:
    candidates = [
        Path.home() / ".platformio/penv/Scripts/pio.exe",  # Windows
        Path.home() / ".platformio/penv/bin/pio",           # Unix/Mac
    ]
    for p in candidates:
        if p.exists() and _interpreter_present(p):
            return str(p)
    if shutil.which("pio"):
        return "pio"
    print("ERROR: PlatformIO not found.", file=sys.stderr)
    print("Install: https://platformio.org/install/cli", file=sys.stderr)
    sys.exit(1)

def pio_env() -> dict:
    """Environment for a `pio` subprocess, forcing UTF-8 stdout. Without this,
    PlatformIO's own Python process crashes (UnicodeEncodeError, cp1252 can't
    represent an esptool progress-output character) on Windows consoles not
    already set to a UTF-8 codepage — and the crash happens mid-flash, not at
    a safe boundary, so an interrupted firmware upload can leave the chip
    erased-but-unbootable rather than just showing an ugly error."""
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"
    return env

# The two platform lines in platformio.ini share ONE package name,
# framework-arduinoespressif32: the arduino3 envs want it at the pioarduino URL, the
# -arduino2 envs at 2.0.17. Whichever built last owns the shared package directory, so
# building one line evicts the other's framework. The next build of the evicted line then
# dies in the platform's own arduino.py before compiling a single file:
#
#   build_script_path = str(Path(FRAMEWORK_DIR) / "tools" / "pioarduino-build.py")
#   TypeError: expected str, bytes or os.PathLike object, not NoneType
#
# because FRAMEWORK_DIR resolved to None. The failing run reinstalls the package on its
# way out, which is why running the same command a second time always works.
#
# Nothing has been compiled or flashed when this hits, so retrying once is safe rather
# than merely convenient. Pin [platformio] default_envs in platformio_local.ini to stop
# the VSCode extension causing it in the background — see that file.
_FRAMEWORK_MISS_MARKER = "FRAMEWORK_DIR"

def _pio_stream(cmd: list) -> tuple:
    """Run pio, passing its output straight through, and report whether the missing
    framework signature appeared. Returns (returncode, saw_marker)."""
    proc = subprocess.Popen(cmd, cwd=ROOT, env=pio_env(),
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, bufsize=1)
    saw = False
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        if _FRAMEWORK_MISS_MARKER in line:
            saw = True
    proc.wait()
    return proc.returncode, saw

def pio_run(env_name: str, targets: list, port: str = None) -> int:
    pio = find_pio()
    cmd = [pio, "run", "-e", env_name]
    # Use the lean, per-build platformio.ini (this env's section + only the lib_deps
    # actually needed by device.yml's components) when generate has produced one;
    # falls back to the tracked platformio.ini otherwise (e.g. hand-coded projects).
    if GENERATED_INI.exists():
        cmd += ["-c", str(GENERATED_INI)]
    for t in targets:
        cmd += ["-t", t]
    if port:
        cmd += ["--upload-port", port]

    rc, framework_missing = _pio_stream(cmd)
    if rc != 0 and framework_missing:
        print("\n--- the platform's framework package was missing (the two platform lines\n"
              "    share it, so building one evicts the other). That run reinstalled it;\n"
              "    retrying once. ---\n")
        rc, _ = _pio_stream(cmd)
    return rc

